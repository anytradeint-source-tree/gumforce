<script>
(function(){
  var ID   = {{ gf_id | json }};
  var root = document.getElementById('gft-' + ID);
  if (!root) return;

  var isDesignMode = root.hasAttribute('data-design-mode');
  var cartRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

  /* ── STOCK BAR ── */
  var stkNumEl = root.querySelector('[data-gft-stk="' + ID + '"]');
  var stkBarEl = root.querySelector('[data-gft-stkbar="' + ID + '"]');

  var GFIV = (window.__gftTimers = window.__gftTimers || {});
  if (GFIV[ID]) { GFIV[ID].forEach(clearInterval); }
  GFIV[ID] = [];

  if (stkNumEl && stkBarEl && !isDesignMode) {
    var STK_HIGH  = {{ stk_high }};
    var STK_LOW   = {{ stk_low }};
    var STK_TOTAL = {{ stk_total }};
    var STK_RANGE = STK_HIGH - STK_LOW;
    var CYCLE_MS  = {{ stk_cycle }} * 3600 * 1000;

    function updateStock() {
      var now = Date.now();
      var pos = (now % CYCLE_MS) / CYCLE_MS;
      var stock = STK_HIGH - Math.round(STK_RANGE * pos);
      stock = Math.round(stock / 2) * 2;
      stock = Math.max(STK_LOW, Math.min(STK_HIGH, stock));
      stkNumEl.textContent = stock;
      stkBarEl.style.width = Math.round(stock / STK_TOTAL * 100) + '%';
    }
    updateStock();
    GFIV[ID].push(setInterval(updateStock, 30000));
  }

  /* ── TIMER ── */
  var hEl = root.querySelector('[data-gft-h="' + ID + '"]');
  var mEl = root.querySelector('[data-gft-m="' + ID + '"]');
  var sEl = root.querySelector('[data-gft-s="' + ID + '"]');

  if (hEl && mEl && sEl && !isDesignMode) {
    var KEY = 'gft_offer_end';
    var iH  = parseInt({{ s.timer_hours | default: 2 | json }}, 10) || 2;
    var iM  = parseInt({{ s.timer_minutes | default: 47 | json }}, 10) || 47;
    var tot = (iH * 3600 + iM * 60) * 1000;

    var stored = localStorage.getItem(KEY);
    var end = (stored && Number(stored) > Date.now())
      ? Number(stored)
      : (function(){ var e = Date.now() + tot; localStorage.setItem(KEY, String(e)); return e; })();

    function pad(n) { return n < 10 ? '0' + n : String(n); }
    function tick() {
      var left = end - Date.now();
      if (left <= 0) {
        end = Date.now() + tot;
        localStorage.setItem(KEY, String(end));
        left = tot;
      }
      var t = Math.floor(left / 1000);
      hEl.textContent = pad(Math.floor(t / 3600));
      mEl.textContent = pad(Math.floor((t % 3600) / 60));
      sEl.textContent = pad(t % 60);
    }
    tick();
    GFIV[ID].push(setInterval(tick, 1000));
  }

  /* ── Reveal removed: section visible immediately for Speed Index ── */

  /* ── CTA + SELLING PLAN ── */
  var btn   = document.getElementById('gft-cta-' + ID);
  var errEl = document.getElementById('gft-err-' + ID);
  if (!btn) return;

  var origSpan = btn.querySelector('span');
  var origText = origSpan ? origSpan.textContent : btn.textContent;

  var txtAdding      = {{ cta_adding | json }};
  var txtRedirecting = {{ cta_redirecting | json }};
  var txtSuccess     = {{ cta_success | json }};

  function showErr(msg) {
    if (!errEl) return;
    errEl.textContent = msg;
    errEl.style.display = 'block';
    setTimeout(function(){ errEl.style.display = 'none'; }, 5000);
  }

  btn.addEventListener('click', function() {
    var link = {{ s.cta_link | default: '' | json }};
    if (link && link.length > 0) {
      window.location.href = link;
      return;
    }

    var vid = {{ vid | default: 0 }};
    if (!vid) {
      showErr('Aucun variant disponible.');
      return;
    }

    if (origSpan) origSpan.textContent = txtAdding; else btn.textContent = txtAdding;
    btn.classList.add('loading');
    if (errEl) errEl.style.display = 'none';

    /* Build item with selling_plan for Appstle subscription discount */
    var item = { id: vid, quantity: 1 };
    var sellingPlan = {{ sp_id | default: 0 }};
    if (sellingPlan) item.selling_plan = sellingPlan;

    fetch(cartRoot + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [item] })
    })
    .then(function(r) {
      return r.json().then(function(d) { return { ok: r.ok, data: d }; });
    })
    .then(function(res) {
      btn.classList.remove('loading');

      if (!res.ok) {
        throw new Error(res.data.description || res.data.message || "Impossible d'ajouter au panier.");
      }

      if (origSpan) origSpan.textContent = txtRedirecting; else btn.textContent = txtRedirecting;
      btn.classList.add('success');

      {%- if s.go_to_checkout -%}
        window.location.href = cartRoot + 'checkout';
      {%- else -%}
        document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail: {
          resource: { item_count: res.data.item_count || 1 },
          sourceId: 'gft-' + ID,
          data: { sections: res.data.sections || {}, source: 'gft-' + ID }
        } }));
        var drawer = document.querySelector('cart-drawer, cart-drawer-component, .cart-drawer');
        if (drawer && typeof drawer.open === 'function') {
          drawer.open();
          setTimeout(function(){
            btn.classList.remove('success');
            if (origSpan) origSpan.textContent = origText; else btn.textContent = origText;
          }, 2000);
        } else {
          window.location.href = cartRoot + 'cart';
        }
      {%- endif -%}
    })
    .catch(function(err) {
      btn.classList.remove('loading', 'success');
      if (origSpan) origSpan.textContent = origText; else btn.textContent = origText;
      showErr(err.message || 'Une erreur est survenue.');
    });
  });
})();
</script>

{%- endif -%}

