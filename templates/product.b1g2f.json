    "gumforce_faq_9zyYPB": {
      "type": "gumforce-faq",
      "blocks": {
        "faq_EUhDEd": {
          "type": "faq",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Chew one piece at a time using your back teeth (molars). Alternate sides every few minutes to train both sides evenly. Each session should last 10–15 minutes max. We recommend 3–4 pieces spread throughout the day.</p><p>Don't overdo it. Your jaw is a muscle. If you feel pain or discomfort, stop and rest. Build up gradually, especially in week one.</p>"
          }
        },
        "faq_dgrBAD": {
          "type": "faq",
          "settings": {
            "question": "Does it actually work?",
            "answer": "<p>GUMFORCE is 10× harder than regular gum. That means real resistance on your masseter muscles — the primary muscles that define your jawline. Like any muscle, they respond to consistent training with progressive resistance.</p><p>Each piece also contains 500mg of creatine monohydrate — the most researched sports supplement in existence. Results come from consistency, combined with overall fitness and low body fat for visible definition.</p>"
          }
        },
        "faq_gnbWhW": {
          "type": "faq",
          "settings": {
            "question": "What's in it?",
            "answer": "<p>Every piece contains 500mg creatine monohydrate. No fillers, no underdosing, no guessing. Sugar-free. Dense, chunky white pieces. You'll feel the difference the second you start chewing.</p><p>100g resealable pouch. Vegan friendly.</p>"
          }
        },
        "faq_k3U3zJ": {
          "type": "faq",
          "settings": {
            "question": "How long until I see results?",
            "answer": "<p>Most customers report feeling the jaw workout immediately on first use. Visible jawline definition typically appears within 4–8 weeks of daily use, depending on your starting point, body fat percentage, and consistency.</p>"
          }
        },
        "faq_gMMnPE": {
          "type": "faq",
          "settings": {
            "question": "Is the creatine effective through chewing?",
            "answer": "<p>Yes. Creatine monohydrate is absorbed through the mucous membranes in your mouth (buccal absorption) as well as through normal digestion when swallowed with saliva. Each piece delivers a full 500mg dose.</p>"
          }
        },
        "faq_hTKgm3": {
          "type": "faq",
          "settings": {
            "question": "Shipping & returns",
            "answer": "<p>We ship worldwide. Orders are processed within 1–2 business days. Standard delivery takes 5–8 business days depending on your location. Tracking included with every order.</p><p>90-day money-back guarantee. Not satisfied? Reach out and we'll make it right.</p>"
          }
        }
      },
