{% comment %}
  ============================================================================
  GUMFORCE — LAYOUT SANS HEADER NI FOOTER (landings pub)
  ----------------------------------------------------------------------------
  Copie minimale de layout/theme.liquid : même <head>
<!-- Start of Shoplift scripts -->
{% render 'shoplift' %}
<!-- End of Shoplift scripts -->
 (styles, polices,
  scripts, Shoplift, pixels via content_for_header) mais AUCUN header,
  footer, barre d'annonce ni modales. Les préchargements de polices 700
  (normalement portés par la barre d'annonce) sont inclus ici.
  À uploader dans le dossier « layout » sous le nom theme.blank.liquid.
  Utilisé par les templates qui déclarent "layout": "theme.blank".
  ============================================================================
{% endcomment %}<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {% render 'shoplift' %}
    <meta name="theme-color" content="#ffffff">

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {%- comment -%} polices 700 (portées ailleurs par la barre d'annonce, absente ici) {%- endcomment -%}
    {%- liquid
      assign gf_body7 = settings.type_body_font | font_modify: 'weight', 700
      assign gf_head7 = settings.type_heading_font | font_modify: 'weight', 700
    -%}
    {%- if gf_body7 -%}<link rel="preload" as="font" type="font/woff2" href="{{ gf_body7 | font_url }}" crossorigin>{%- endif -%}
    {%- if gf_head7 -%}<link rel="preload" as="font" type="font/woff2" href="{{ gf_head7 | font_url }}" crossorigin>{%- endif -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>
  </body>
</html>
