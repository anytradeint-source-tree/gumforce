          }
        },
        "avis_r03": {
          "type": "review",
          "settings": {
            "reviewer_name": "Ethan P.",
            "review_date": "",
            "rating": 5,
            "verified": true,
            "review_text": "Tous les jours avant d’aller a la salle j'ai pris l'habitude de prendre un gumforce pour les 15 minutes de trajet, c'est parfait et ça fonctionne de ouf mon visage s'est vraiment affiné",
            "highlight_text": "ça fonctionne de ouf mon visage s'est vraiment affiné",
