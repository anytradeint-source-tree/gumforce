{% comment %}
  ============================================================================
  GUMFORCE Comment ça marche — 3 ÉTAPES
  ----------------------------------------------------------------------------
  Même recette visuelle que « Pourquoi la créatine » (gumforce-creatine-benefits) :
  titre centré, sous-titre discret, icônes teal filaires, mot-clé Oswald,
  petit tiret accent, description. Bouton identique à celui de la garantie.
  Optionnel : données structurées Product (JSON-LD) via le handle du produit.
  ============================================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign heading_text    = s.heading
  assign heading_color   = s.heading_color | default: '#1a1a1a'
  assign heading_size    = s.heading_size | default: 32
  assign subheading_color = s.subheading_color | default: '#666666'
  assign keyword_color   = s.keyword_color | default: '#000000'
  assign desc_color      = s.desc_color | default: '#999999'
  assign accent_color    = s.accent_color | default: '#2AB5B4'
  assign divider_color   = s.divider_color | default: '#1e1e1e'
  assign icon_size       = s.icon_size | default: 34
  assign cta_bg          = s.cta_bg_color | default: '#1a1a1a'
  assign cta_text_color  = s.cta_text_color | default: '#ffffff'
  assign cta_radius      = s.cta_radius | default: 30
  assign pad_top         = s.padding_top | default: 80
  assign pad_bottom      = s.padding_bottom | default: 80
  assign pad_top_mobile  = s.padding_top_mobile | default: 48
  assign pad_bot_mobile  = s.padding_bottom_mobile | default: 48
  assign enable_animations = s.enable_animations | default: true, allow_false: true
-%}

{%- if s.product_handle != blank -%}
  {%- assign ld_product = all_products[s.product_handle] -%}
  {%- if ld_product != blank -%}
<script type="application/ld+json">
  {{ ld_product | structured_data }}
</script>
  {%- endif -%}
{%- endif -%}

<style>
  #gfhw-{{ sid }} {
    --gfhw-heading-color: {{ heading_color }};
    --gfhw-heading-size: {{ heading_size }}px;
    --gfhw-subheading-color: {{ subheading_color }};
    --gfhw-keyword-color: {{ keyword_color }};
    --gfhw-desc-color: {{ desc_color }};
    --gfhw-accent: {{ accent_color }};
    --gfhw-icon-size: {{ icon_size }}px;
    --gfhw-divider: {{ divider_color }};
    --gfhw-cta-bg: {{ cta_bg }};
    --gfhw-cta-text: {{ cta_text_color }};
    padding: {{ pad_top }}px 0 {{ pad_bottom }}px;
  }
  #gfhw-{{ sid }} .gfhw-inner { max-width: 1340px; margin: 0 auto; padding: 0 24px; }

  /* ── Header ── */
  #gfhw-{{ sid }} .gfhw-header { text-align: center; margin-bottom: 60px; }
  #gfhw-{{ sid }} .gfhw-heading {
    font-size: var(--gfhw-heading-size); font-weight: 700; color: var(--gfhw-heading-color);
    margin: 0; letter-spacing: -0.025em; line-height: 1.15;
  }
  #gfhw-{{ sid }} .gfhw-heading em { font-style: normal; color: var(--gfhw-accent); }
  #gfhw-{{ sid }} .gfhw-subheading {
    font-size: 15px; color: var(--gfhw-subheading-color); margin: 12px auto 0;
    font-weight: 400; line-height: 1.5; letter-spacing: 0.01em; max-width: 640px;
  }
  #gfhw-{{ sid }} .gfhw-subheading p { margin: 0 0 8px; }
  #gfhw-{{ sid }} .gfhw-subheading p:last-child { margin-bottom: 0; }

  /* ── Grid / item (recette creatine-benefits) ── */
  #gfhw-{{ sid }} .gfhw-grid { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr); }
  #gfhw-{{ sid }} .gfhw-item { text-align: center; padding: 0 28px; position: relative; }
  #gfhw-{{ sid }} .gfhw-item + .gfhw-item::before {
    content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 1px; background: var(--gfhw-divider);
  }
  #gfhw-{{ sid }} .gfhw-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--gfhw-icon-size); height: var(--gfhw-icon-size); color: var(--gfhw-accent);
    margin-bottom: 22px; transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #gfhw-{{ sid }} .gfhw-item:hover .gfhw-icon { transform: scale(1.12) translateY(-2px); }
  #gfhw-{{ sid }} .gfhw-icon svg { width: 100%; height: 100%; }
  #gfhw-{{ sid }} .gfhw-keyword {
    font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.16em;
    color: var(--gfhw-keyword-color); margin: 0 0 14px;
  }
  #gfhw-{{ sid }} .gfhw-dash {
    width: 24px; height: 2px; background: var(--gfhw-accent); margin: 0 auto 18px; border-radius: 1px;
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #gfhw-{{ sid }} .gfhw-item:hover .gfhw-dash { width: 44px; }
  #gfhw-{{ sid }} .gfhw-desc { font-size: 14px; line-height: 1.7; color: var(--gfhw-desc-color); margin: 0 auto; max-width: 260px; font-weight: 400; }

  /* ── CTA (même bouton que la garantie) ── */
  #gfhw-{{ sid }} .gfhw-cta-wrap { text-align: center; margin-top: 56px; }
  #gfhw-{{ sid }} .gfhw-cta {
    display: inline-flex; align-items: center; justify-content: center; padding: 18px 48px;
    font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; text-decoration: none;
    color: var(--gfhw-cta-text); background: var(--gfhw-cta-bg); border: none; border-radius: {{ cta_radius }}px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  #gfhw-{{ sid }} .gfhw-cta:hover { transform: scale(1.03); box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25); }
  #gfhw-{{ sid }} .gfhw-cta:active { transform: scale(0.98); }

  /* ── Scroll animations ── */
  #gfhw-{{ sid }}.gfhw-animate .gfhw-item { opacity: 0; transform: translateY(18px); transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1); }
  #gfhw-{{ sid }}.gfhw-animate .gfhw-item.gfhw-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { #gfhw-{{ sid }}.gfhw-animate .gfhw-item { opacity: 1; transform: none; transition: none; } }

  /* ── Tablet / mobile ── */
  @media (max-width: 999px) {
    #gfhw-{{ sid }} .gfhw-grid { grid-template-columns: 1fr; row-gap: 44px; }
    #gfhw-{{ sid }} .gfhw-item + .gfhw-item::before { display: none; }
  }
  @media (max-width: 599px) {
    #gfhw-{{ sid }} { padding: {{ pad_top_mobile }}px 0 {{ pad_bot_mobile }}px; }
    #gfhw-{{ sid }} .gfhw-header { margin-bottom: 44px; }
    #gfhw-{{ sid }} .gfhw-heading { font-size: calc(var(--gfhw-heading-size) * 0.78); }
    #gfhw-{{ sid }} .gfhw-subheading { font-size: 14px; }
    #gfhw-{{ sid }} .gfhw-cta-wrap { margin-top: 44px; }
    #gfhw-{{ sid }} .gfhw-cta { width: 100%; }
  }
</style>

<section id="gfhw-{{ sid }}" class="gfhw{% if enable_animations %} gfhw-animate{% endif %}">
  <div class="gfhw-inner">

    {%- if heading_text != blank or s.text != blank -%}
      <div class="gfhw-header">
        {%- if heading_text != blank -%}<h2 class="gfhw-heading">{{ heading_text }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="gfhw-subheading">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="gfhw-grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign icon = b.icon_type | default: 'clock' -%}
        <div class="gfhw-item" {{ block.shopify_attributes }}>
          <div class="gfhw-icon">
            {%- case icon -%}
              {%- when 'clock' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="12"/><polyline points="16 9 16 16 21 19"/></svg>
              {%- when 'strength' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="4" y1="16" x2="28" y2="16"/><rect x="7" y="10" width="4" height="12" rx="1.5"/><rect x="21" y="10" width="4" height="12" rx="1.5"/></svg>
              {%- when 'power' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 3L9 17h7l-3 12L23 15h-7l3-12z"/></svg>
              {%- when 'recovery' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 16a9 9 0 0115-6.7"/><polyline points="19 4 23 9 18 12"/><path d="M25 16a9 9 0 01-15 6.7"/><polyline points="13 28 9 23 14 20"/></svg>
              {%- when 'calendar' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="7" width="22" height="20" rx="2"/><line x1="5" y1="13" x2="27" y2="13"/><line x1="11" y1="4" x2="11" y2="9"/><line x1="21" y1="4" x2="21" y2="9"/><polyline points="12 20 15 23 20 17"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3L5 8v7c0 7.7 4.7 14.3 11 17 6.3-2.7 11-9.3 11-17V8L16 3z"/><polyline points="11 16 14.5 19.5 21 13"/></svg>
              {%- when 'target' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="16" cy="16" r="12"/><circle cx="16" cy="16" r="7"/><circle cx="16" cy="16" r="2.5"/></svg>
              {%- else -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 28c-5.5 0-8-4.2-8-8 0-5 4-8.5 6-13 .5 4 3 5.5 4.5 8.5 1-2 1.5-4 1.5-6 3 3 4.5 6.5 4.5 10.5 0 4.5-3 8-8.5 8z"/></svg>
            {%- endcase -%}
          </div>
          <div class="gfhw-keyword">{{ b.title }}</div>
          <div class="gfhw-dash"></div>
          <p class="gfhw-desc">{{ b.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if s.cta_text != blank and s.cta_link != blank -%}
      <div class="gfhw-cta-wrap"><a class="gfhw-cta" href="{{ s.cta_link }}">{{ s.cta_text }}</a></div>
    {%- endif -%}

  </div>
</section>

{%- if enable_animations -%}
<script>
  (function(){
    var root = document.getElementById('gfhw-{{ sid }}');
    if (!root) return;
    var items = root.querySelectorAll('.gfhw-item');
    if (!('IntersectionObserver' in window)) { items.forEach(function(el){ el.classList.add('gfhw-in'); }); return; }
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (!e.isIntersecting) return;
        var idx = Array.from(items).indexOf(e.target);
        setTimeout(function(){ e.target.classList.add('gfhw-in'); }, idx * 110);
        io.unobserve(e.target);
      });
    }, { threshold: 0.15 });
    items.forEach(function(el){ io.observe(el); });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "GF Comment ça marche",
  "tag": "section",
  "class": "gf-how-it-works",
  "settings": [
    { "type": "header", "content": "Contenu" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Comment muscler sa mâchoire avec GUMFORCE" },
    { "type": "richtext", "id": "text", "label": "Sous-titre", "default": "<p>Un chewing-gum 10x plus dur qu'un chewing-gum classique, 500 mg de créatine par pièce, 15 minutes par jour.</p>" },
    { "type": "text", "id": "cta_text", "label": "Bouton", "default": "COMMANDER GUMFORCE" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" },
    { "type": "text", "id": "product_handle", "label": "Handle du produit (données structurées)", "info": "Ex. gumforce. Ajoute le balisage Product (prix, disponibilité) à la page. Utile sur la home." },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "heading_color", "label": "Titre", "default": "#1a1a1a" },
    { "type": "color", "id": "subheading_color", "label": "Sous-titre", "default": "#666666" },
    { "type": "color", "id": "keyword_color", "label": "Mots-clés", "default": "#000000" },
    { "type": "color", "id": "desc_color", "label": "Descriptions", "default": "#999999" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#2AB5B4" },
    { "type": "color", "id": "divider_color", "label": "Séparateurs", "default": "#1e1e1e" },
    { "type": "color", "id": "cta_bg_color", "label": "Fond du bouton", "default": "#1a1a1a" },
    { "type": "color", "id": "cta_text_color", "label": "Texte du bouton", "default": "#ffffff" },
    { "type": "range", "id": "cta_radius", "label": "Arrondi du bouton", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "icon_size", "label": "Taille des icônes", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "heading_size", "label": "Taille du titre", "min": 22, "max": 48, "step": 1, "unit": "px", "default": 34 },
    { "type": "checkbox", "id": "enable_animations", "label": "Animations au scroll", "default": true },

    { "type": "header", "content": "Espacements" },
    { "type": "range", "id": "padding_top", "label": "Haut (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bas (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Haut (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bas (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "select", "id": "icon_type", "label": "Icône", "options": [
          { "value": "clock", "label": "Horloge" }, { "value": "strength", "label": "Haltère" }, { "value": "power", "label": "Éclair" },
          { "value": "recovery", "label": "Récupération" }, { "value": "calendar", "label": "Calendrier" }, { "value": "shield", "label": "Bouclier" },
          { "value": "target", "label": "Cible" }, { "value": "flame", "label": "Flamme" } ], "default": "clock" },
        { "type": "text", "id": "title", "label": "Mot-clé", "default": "15 min par jour" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Un chewing-gum à la fois, sur les molaires, en alternant les côtés." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "GF Comment ça marche",
      "blocks": [
        { "type": "step", "settings": { "icon_type": "clock", "title": "15 min par jour", "text": "Un chewing-gum à la fois, sur les molaires, en alternant les côtés. Dans la voiture, au bureau, avant le sport." } },
        { "type": "step", "settings": { "icon_type": "strength", "title": "10x plus dur", "text": "La résistance oblige les masséters à se contracter à chaque mâche, comme une série à la salle." } },
        { "type": "step", "settings": { "icon_type": "calendar", "title": "Résultats en 30 jours", "text": "Mâchoire plus dessinée, moins de tension, 500 mg de créatine par chewing-gum pour soutenir le muscle." } }
      ]
    }
  ]
}
{% endschema %}
