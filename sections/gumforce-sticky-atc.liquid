{% comment %}
  ============================================================================
  GUMFORCE Sticky Add-to-Cart — barre pleine largeur (design « B2 »)
  ============================================================================
  Collée au bas de l'écran. À gauche : offre sélectionnée + réassurance, prix,
  prix barré et remise. À droite : bouton COMMANDER. Le tout se synchronise
  avec le pack offer (tier coché) et envoie directement au checkout via le
  lien panier /cart/variante:1 (une seule navigation). Sinon : scroll vers l'offre.
  Apparaît quand l'offre est sortie de l'écran, disparaît près du footer.
  ============================================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign title        = s.product_title | default: 'GUMFORCE'
  assign show_image   = s.show_image
  assign product_img  = s.product_image
  assign img_size     = s.image_size | default: 44
  assign img_size_3x  = img_size | times: 3
  assign note_text    = s.note_text | default: 'Livraison gratuite'
  assign cta_text     = s.cta_text | default: 'COMMANDER'
  assign cta_action   = s.cta_action | default: 'checkout'

  assign prod = s.price_product | default: product
  if s.price_text != blank
    assign price_text = s.price_text
  elsif prod != blank and prod.price != blank
    assign gf_curcode = false
    assign gf_loccur = localization.country.currency.iso_code | default: cart.currency.iso_code
    if gf_loccur != shop.currency
      assign gf_curcode = true
    endif
    assign price_text = prod.price | money
    if gf_curcode
      assign price_text = prod.price | money_with_currency
    endif
  else
    assign price_text = ''
  endif

  assign style = s.style | default: 'noir'
  case style
    when 'vert'
      assign bg = '#C5FE89'
      assign ink = '#0A0A0A'
      assign muted = 'rgba(10,10,10,0.62)'
      assign strike = 'rgba(10,10,10,0.45)'
      assign badge_bg = '#121212'
      assign badge_ink = '#C5FE89'
      assign line = 'rgba(0,0,0,0.10)'
      assign cta_bg = '#121212'
      assign cta_ink = '#FFFFFF'
    when 'clair'
      assign bg = '#FFFFFF'
      assign ink = '#18181B'
      assign muted = '#71717A'
      assign strike = '#A1A1AA'
      assign badge_bg = '#E3F7F6'
      assign badge_ink = '#0A7C7B'
      assign line = '#E7E7EA'
      assign cta_bg = '#121212'
      assign cta_ink = '#FFFFFF'
    when 'menthe'
      assign bg = '#E9FBF6'
      assign ink = '#18181B'
      assign muted = '#5D6B68'
      assign strike = '#9AA5A2'
      assign badge_bg = '#2AB5B4'
      assign badge_ink = '#FFFFFF'
      assign line = 'rgba(42,181,180,0.25)'
      assign cta_bg = '#121212'
      assign cta_ink = '#FFFFFF'
    when 'noir-lime'
      assign bg = '#121212'
      assign ink = '#FFFFFF'
      assign muted = '#A1A1AA'
      assign strike = '#71717A'
      assign badge_bg = 'rgba(255,255,255,0.10)'
      assign badge_ink = '#FFFFFF'
      assign line = 'rgba(255,255,255,0.08)'
      assign cta_bg = '#C5FE89'
      assign cta_ink = '#0A0A0A'
    when 'custom'
      assign bg = s.bg_color | default: '#121212'
      assign ink = s.text_color | default: '#FFFFFF'
      assign muted = s.text_color | default: '#FFFFFF' | color_modify: 'alpha', 0.65
      assign strike = s.text_color | default: '#FFFFFF' | color_modify: 'alpha', 0.45
      assign badge_bg = s.cta_bg | default: '#FFFFFF' | color_modify: 'alpha', 0.16
      assign badge_ink = s.text_color | default: '#FFFFFF'
      assign line = s.text_color | default: '#FFFFFF' | color_modify: 'alpha', 0.08
      assign cta_bg = s.cta_bg | default: '#FFFFFF'
      assign cta_ink = s.cta_text_color | default: '#121212'
    else
      assign bg = '#121212'
      assign ink = '#FFFFFF'
      assign muted = '#A1A1AA'
      assign strike = '#71717A'
      assign badge_bg = 'rgba(197,254,137,0.16)'
      assign badge_ink = '#C5FE89'
      assign line = 'rgba(255,255,255,0.08)'
      assign cta_bg = '#FFFFFF'
      assign cta_ink = '#0A0A0A'
  endcase
  assign cta_radius = s.cta_radius | default: 14
-%}

<style>
  /* La section ne prend aucune place dans le flux : la barre est fixed */
  section.gf-satc-section { height: 0; overflow: visible; margin: 0; padding: 0; border: none; }

  #gf-satc-{{ sid }} {
    --satc-bg: {{ bg }};
    --satc-ink: {{ ink }};
    --satc-muted: {{ muted }};
    --satc-strike: {{ strike }};
    --satc-badge-bg: {{ badge_bg }};
    --satc-badge-ink: {{ badge_ink }};
    --satc-line: {{ line }};
    --satc-cta-bg: {{ cta_bg }};
    --satc-cta-ink: {{ cta_ink }};
    --satc-cta-radius: {{ cta_radius }}px;

    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 9990;
    background: var(--satc-bg);
    color: var(--satc-ink);
    border-top: 1px solid var(--satc-line);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.22);
    font-family: var(--font-body--family, 'Manrope', sans-serif);
    -webkit-font-smoothing: antialiased;

    /* état caché */
    transform: translateY(calc(100% + 8px));
    visibility: hidden;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.4s;
  }
  #gf-satc-{{ sid }}.is-visible {
    transform: translateY(0);
    visibility: visible;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s;
  }

  .gf-satc__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
  }

  /* Vignette + titre : desktop uniquement */
  .gf-satc__prod { display: none; align-items: center; gap: 12px; min-width: 0; flex: 1 1 auto; }
  .gf-satc__img { width: {{ img_size }}px; height: {{ img_size }}px; border-radius: 12px; object-fit: cover; flex-shrink: 0; background: rgba(255,255,255,0.06); }
  .gf-satc__title { font-size: 13px; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Offre + prix */
  .gf-satc__deal { min-width: 0; flex: 1 1 auto; display: flex; flex-direction: column; gap: 3px; }
  .gf-satc__offer { font-size: 12px; font-weight: 600; color: var(--satc-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.2; }
  .gf-satc__offer b { color: var(--satc-ink); font-weight: 700; }
  .gf-satc__offer [hidden] { display: none; }
  .gf-satc__prices { display: flex; align-items: baseline; gap: 8px; line-height: 1; }
  .gf-satc__price { font-size: 19px; font-weight: 800; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .gf-satc__was { font-size: 12px; color: var(--satc-strike); text-decoration: line-through; text-decoration-thickness: 1px; }
  .gf-satc__pct { font-size: 11px; font-weight: 800; color: var(--satc-badge-ink); background: var(--satc-badge-bg); border-radius: 6px; padding: 3px 6px; letter-spacing: 0.02em; }
  .gf-satc__prices [hidden] { display: none; }

  /* CTA : épais et net */
  .gf-satc__cta {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 54px;
    padding: 0 28px;
    border: 0;
    border-radius: var(--satc-cta-radius);
    background: var(--satc-cta-bg);
    color: var(--satc-cta-ink);
    font-family: inherit;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease, opacity 0.2s ease;
  }
  .gf-satc__cta-price { font-weight: 700; opacity: 0.6; letter-spacing: 0; display: none; }
  .gf-satc__cta::after { content: ''; position: absolute; inset: 0; background: rgba(255,255,255,0); transition: background 0.2s ease; pointer-events: none; }
  .gf-satc__cta:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(0, 0, 0, 0.26); }
  .gf-satc__cta:hover::after { background: rgba(0, 0, 0, 0.05); }
  .gf-satc__cta:active { transform: translateY(0) scale(0.98); box-shadow: none; transition-duration: 0.08s; }
  .gf-satc__cta:focus-visible { outline: 2px solid var(--satc-cta-bg); outline-offset: 3px; }
  .gf-satc__cta.is-busy { opacity: 0.75; pointer-events: none; }
  .gf-satc__cta.is-busy > span:first-child::before {
    content: ''; width: 14px; height: 14px; margin-right: 8px;
    border: 2px solid rgba(0,0,0,.25); border-top-color: currentColor; border-radius: 50%;
    display: inline-block; vertical-align: -2px; animation: gf-satc-rot .7s linear infinite;
  }
  @keyframes gf-satc-rot { to { transform: rotate(360deg); } }

  @media (min-width: 750px) {
    .gf-satc__inner { gap: 24px; padding: 12px 24px; }
    .gf-satc__prod { display: flex; }
    .gf-satc__deal { flex: 0 1 auto; align-items: flex-end; text-align: right; }
    .gf-satc__price { font-size: 20px; }
    .gf-satc__cta { height: 56px; padding: 0 34px; }
    .gf-satc__cta-price { display: inline; }
  }

  @media (prefers-reduced-motion: reduce) {
    #gf-satc-{{ sid }} { transition: visibility 0s; transform: none; }
    .gf-satc__cta { transition: none; }
  }
</style>

<div id="gf-satc-{{ sid }}" role="region" aria-label="Commander">
  <div class="gf-satc__inner">

    <div class="gf-satc__prod">
      {%- if show_image and product_img -%}
        <img class="gf-satc__img" src="{{ product_img | image_url: width: img_size_3x }}" alt="" width="{{ img_size }}" height="{{ img_size }}" loading="lazy" decoding="async">
      {%- endif -%}
      <span class="gf-satc__title">{{ title }}</span>
    </div>

    <div class="gf-satc__deal">
      <span class="gf-satc__offer"><b data-satc-offer>{{ title }}</b><span data-satc-note-sep>{% if note_text != blank %} · {% endif %}</span><span data-satc-note>{{ note_text }}</span></span>
      <span class="gf-satc__prices">
        <span class="gf-satc__price" data-satc-price>{{ price_text }}</span>
        <span class="gf-satc__was" data-satc-was hidden></span>
        <span class="gf-satc__pct" data-satc-pct hidden></span>
      </span>
    </div>

    <button class="gf-satc__cta" type="button">
      <span>{{ cta_text }}</span>
      <span class="gf-satc__cta-price" data-satc-cta-price></span>
    </button>

  </div>
</div>

<script>
(function () {
  var bar = document.getElementById('gf-satc-{{ sid }}');
  if (!bar) return;

  var wrap = bar.closest('[id^="shopify-block-"]');
  if (wrap) { wrap.style.cssText += ';position:absolute!important;width:0!important;height:0!important;min-height:0!important;margin:0!important;padding:0!important;'; }

  {% if request.design_mode %}
    bar.classList.add('is-visible');
  {% endif %}

  var cta = bar.querySelector('.gf-satc__cta');
  var busy = false;
  var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

  /* ── Synchronisation avec l'offre sélectionnée (pack offer) ── */
  var elOffer = bar.querySelector('[data-satc-offer]');
  var elNote  = bar.querySelector('[data-satc-note]');
  var elSep   = bar.querySelector('[data-satc-note-sep]');
  var elPrice = bar.querySelector('[data-satc-price]');
  var elWas   = bar.querySelector('[data-satc-was]');
  var elPct   = bar.querySelector('[data-satc-pct]');
  var elCtaP  = bar.querySelector('[data-satc-cta-price]');
  var defaultNote = elNote ? elNote.textContent : '';

  function currentTier() {
    var inp = document.querySelector('input[name^="gfp-tier-"]:checked');
    var lab = inp ? inp.closest('.gfp-tier') : document.querySelector('.gfp-tier.gfp-sel');
    if (!lab || lab.getAttribute('data-gfp-avail') === 'false') return null;
    var name = lab.querySelector('.gfp-tname');
    var ship = lab.querySelector('.gfp-tship');
    var wasEl = lab.querySelector('.gfp-tsub s');
    return {
      vid:   parseInt(lab.getAttribute('data-gfp-vid'), 10) || 0,
      cents: parseInt(lab.getAttribute('data-gfp-cents'), 10) || 0,
      was:   parseInt(lab.getAttribute('data-gfp-was'), 10) || 0,
      total: lab.getAttribute('data-gfp-total') || '',
      wasText: wasEl ? wasEl.textContent.trim() : '',
      name:  name ? name.textContent.trim() : '',
      ship:  ship ? ship.textContent.trim() : ''
    };
  }
  function syncOffer() {
    var t = currentTier();
    if (!t) return;
    if (elOffer && t.name) elOffer.textContent = t.name;
    if (elNote) { var note = t.ship || defaultNote; elNote.textContent = note; if (elSep) elSep.hidden = !note; }
    if (elPrice && t.total) elPrice.textContent = t.total;
    var hasWas = t.was > t.cents && t.cents > 0;
    if (elWas) { elWas.hidden = !hasWas; if (hasWas) elWas.textContent = t.wasText || ''; if (!elWas.textContent) elWas.hidden = true; }
    if (elPct) { elPct.hidden = !hasWas; if (hasWas) elPct.textContent = '-' + Math.round((1 - t.cents / t.was) * 100) + '%'; }
    if (elCtaP) elCtaP.textContent = t.total ? ('· ' + t.total) : '';
  }
  syncOffer();
  document.addEventListener('change', function (e) {
    if (e.target && e.target.name && e.target.name.indexOf('gfp-tier-') === 0) syncOffer();
  });
  window.addEventListener('pageshow', function (e) { if (e.persisted) { busy = false; cta.classList.remove('is-busy'); syncOffer(); } });

  /* ── Affichage : après avoir scrollé sous l'offre, masqué près du footer ── */
  var scrolledPast = false, nearFooter = false;
  function sync() {
    if (scrolledPast && !nearFooter) bar.classList.add('is-visible');
    else bar.classList.remove('is-visible');
  }
  function findOffer(strict) {
    var sels = ['[data-gf-scroll-target]', '[id^="gfp-"]', '.gfp-w', '[id^="gft-"]', '.gft-w', '[id^="gfo-"]', '.gfo-root', '.gf-options', 'form[action*="/cart/add"]', 'product-form', '[id^="ProductInformation"]', '.product-details'];
    if (!strict) sels.push('#MainContent');
    for (var i = 0; i < sels.length; i++) {
      var els = document.querySelectorAll(sels[i]);
      for (var j = 0; j < els.length; j++) {
        var el = els[j];
        if (el === bar || bar.contains(el)) continue;
        if (el.tagName === 'STYLE' || el.tagName === 'SCRIPT') continue;
        if (el.offsetParent === null && el.tagName !== 'BODY') continue;
        return el;
      }
    }
    return null;
  }
  {% unless request.design_mode %}
  var trigger = findOffer(true);
  if (trigger) {
    new IntersectionObserver(function (entries) {
      var e = entries[0];
      scrolledPast = !e.isIntersecting && e.boundingClientRect.top < 0;
      sync();
    }, { threshold: 0 }).observe(trigger);
  } else {
    window.addEventListener('scroll', function () {
      scrolledPast = (window.scrollY || document.documentElement.scrollTop || 0) > 600;
      sync();
    }, { passive: true });
  }
  var hideEls = document.querySelectorAll('.gfg-section, .gff-footer-wrapper, footer, #shopify-section-footer');
  if (hideEls.length) {
    var hideObs = new IntersectionObserver(function (entries) {
      nearFooter = entries.some(function (e) { return e.isIntersecting; });
      sync();
    }, { threshold: 0 });
    hideEls.forEach(function (el) { hideObs.observe(el); });
  }
  {% endunless %}

  /* ── CTA : checkout direct avec l'offre sélectionnée, sinon scroll vers l'offre ── */
  cta.addEventListener('click', function (evt) {
    evt.preventDefault();
    if (busy) return;
    {%- if cta_action == 'checkout' -%}
    var t = currentTier();
    if (t && t.vid) {
      busy = true;
      cta.classList.add('is-busy');
      window.location.href = root + 'cart/' + t.vid + ':1';
      return;
    }
    {%- endif -%}
    var target = findOffer(false);
    if (!target) return;
    var head = document.querySelector('header-component, header, .header');
    var off = 12 + (head ? Math.max(0, head.getBoundingClientRect().height) : 80);
    target.style.scrollMarginTop = off + 'px';
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
})();
</script>

{% schema %}
{
  "name": "GF Sticky ATC",
  "tag": "section",
  "class": "gf-satc-section",
  "settings": [
    { "type": "header", "content": "Style" },
    {
      "type": "select",
      "id": "style",
      "label": "Couleurs",
      "default": "noir",
      "options": [
        { "value": "noir", "label": "Noir mat, bouton blanc" },
        { "value": "noir-lime", "label": "Noir mat, bouton lime" },
        { "value": "clair", "label": "Blanc, bouton noir" },
        { "value": "menthe", "label": "Menthe, bouton noir" },
        { "value": "vert", "label": "Vert signature" },
        { "value": "custom", "label": "Personnalisé" }
      ]
    },
    { "type": "header", "content": "Contenu" },
    { "type": "text", "id": "product_title", "label": "Titre (desktop, et repli si pas d'offre)", "default": "GUMFORCE" },
    { "type": "text", "id": "note_text", "label": "Réassurance à côté de l'offre", "default": "Livraison gratuite", "info": "Remplacée par le texte de livraison du tier sélectionné s'il en a un." },
    { "type": "text", "id": "cta_text", "label": "Texte du bouton", "default": "COMMANDER" },
    {
      "type": "select",
      "id": "cta_action",
      "label": "Action du bouton",
      "default": "checkout",
      "info": "Checkout direct : envoie au paiement avec l'offre sélectionnée (une seule navigation). Sinon, remonte vers l'offre.",
      "options": [
        { "value": "checkout", "label": "Checkout direct (offre sélectionnée)" },
        { "value": "scroll", "label": "Remonter vers l'offre" }
      ]
    },
    { "type": "header", "content": "Image produit (desktop)" },
    { "type": "checkbox", "id": "show_image", "label": "Afficher l'image", "default": true },
    { "type": "image_picker", "id": "product_image", "label": "Image" },
    { "type": "range", "id": "image_size", "label": "Taille de l'image", "min": 28, "max": 56, "step": 2, "unit": "px", "default": 44 },
    { "type": "header", "content": "Prix (repli si pas de pack offer sur la page)" },
    { "type": "product", "id": "price_product", "label": "Produit (source du prix)", "info": "Vide = produit de la page." },
    { "type": "text", "id": "price_text", "label": "Prix manuel (optionnel)" },
    { "type": "header", "content": "Couleurs (mode Personnalisé uniquement)" },
    { "type": "color", "id": "bg_color", "label": "Fond de la barre", "default": "#121212" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#FFFFFF" },
    { "type": "color", "id": "cta_bg", "label": "Fond du bouton", "default": "#FFFFFF" },
    { "type": "color", "id": "cta_text_color", "label": "Texte du bouton", "default": "#121212" },
    { "type": "header", "content": "Forme" },
    { "type": "range", "id": "cta_radius", "label": "Arrondi du bouton", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 14 }
  ],
  "presets": [
    { "name": "GF Sticky ATC" }
  ]
}
{% endschema %}
