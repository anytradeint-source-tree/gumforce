{% comment %}
  ============================================================================
  GUMFORCE Blog — PAGE ARTICLE
  ----------------------------------------------------------------------------
  Section pour le template « article ». Colonne de lecture 720px : retour au
  blog, tag, titre (recette GF), méta (date localisée + temps de lecture),
  image à la une, contenu riche stylé (h2/h3, listes, citations, images,
  vidéos), CTA optionnel, navigation article précédent / suivant.
  JSON-LD BlogPosting pour le SEO. 100% données Shopify, rien en dur.
  ============================================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign accent = s.accent_color | default: '#2AB5B4'
  assign ar = accent | color_extract: 'red'
  assign ag = accent | color_extract: 'green'
  assign ab = accent | color_extract: 'blue'

  assign txt_hd  = s.color_heading | default: '#0e0e0e'
  assign txt     = s.color_text    | default: '#1c1c1e'
  assign txt_mut = s.color_muted   | default: '#6b6b6b'

  if s.transparent_bg == false
    assign root_bg = s.color_bg | default: '#ffffff'
  else
    assign root_bg = 'transparent'
  endif

  assign title_size = s.title_size | default: 40

  assign show_image    = s.show_image    | default: true, allow_false: true
  assign show_date     = s.show_date     | default: true, allow_false: true
  assign show_readtime = s.show_readtime | default: true, allow_false: true
  assign show_tag      = s.show_tag      | default: true, allow_false: true
  assign show_back     = s.show_back     | default: true, allow_false: true
  assign show_nav      = s.show_nav      | default: true, allow_false: true

  assign gf_words = article.content | strip_html | split: ' ' | size
  assign gf_mins = gf_words | divided_by: 200 | at_least: 1
-%}

{%- if article == blank -%}

  <style>
    #gfa-empty-{{ sid }}{max-width:460px;margin:24px auto;padding:32px 24px;border:2px dashed #e5e5e5;
      border-radius:14px;text-align:center;color:#555;background:#fafafa;font-size:14px;line-height:1.5}
  </style>
  <div id="gfa-empty-{{ sid }}">
    <strong>GF Article de blog</strong><br>
    Cette section s'utilise sur le template « article » : elle affiche automatiquement l'article ouvert.
  </div>

{%- else -%}

<style>
  #gfa-{{ sid }},
  #gfa-{{ sid }} *,
  #gfa-{{ sid }} *::before,
  #gfa-{{ sid }} *::after { margin:0; padding:0; box-sizing:border-box; }

  #gfa-{{ sid }} {
    --gfa-font:      var(--font-body--family, 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif);
    --gfa-font-head: var(--font-heading--family, 'Oswald', sans-serif);
    --gfa-accent:    {{ accent }};
    --gfa-ar:        {{ ar }};
    --gfa-ag:        {{ ag }};
    --gfa-ab:        {{ ab }};
    --gfa-text:      {{ txt }};
    --gfa-hd:        {{ txt_hd }};
    --gfa-mut:       {{ txt_mut }};
    --gfa-title:     {{ title_size }}px;

    font-family: var(--gfa-font);
    background: {{ root_bg }};
    color: var(--gfa-text);
    padding: {{ s.padding_top | default: 32 }}px 16px {{ s.padding_bottom | default: 60 }}px;
  }
  #gfa-{{ sid }} .gfa-w { max-width:720px; margin:0 auto; }

  /* ── En-tête ── */
  #gfa-{{ sid }} .gfa-back {
    display:inline-flex; align-items:center; gap:6px;
    font-size:12.5px; font-weight:700; color:var(--gfa-mut); text-decoration:none;
    margin-bottom:20px; transition:color .2s ease; -webkit-tap-highlight-color:transparent;
  }
  #gfa-{{ sid }} .gfa-back svg { width:14px; height:14px; flex-shrink:0; }
  #gfa-{{ sid }} .gfa-back:hover { color:var(--gfa-accent); }

  #gfa-{{ sid }} .gfa-chip {
    display:inline-flex; align-items:center;
    background:rgba(var(--gfa-ar),var(--gfa-ag),var(--gfa-ab),0.10);
    color:var(--gfa-accent);
    font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em;
    padding:4px 11px; border-radius:100px; line-height:1.3; margin-bottom:12px;
  }
  /* même mécanique de titre que les autres sections GF : taille réglable,
     ×0.78 en mobile, pleine taille en desktop */
  #gfa-{{ sid }} .gfa-title {
    font-family:var(--gfa-font-head); color:var(--gfa-hd);
    font-size:clamp(24px, calc(var(--gfa-title) * 0.78), var(--gfa-title));
    font-weight:700; line-height:1.12; letter-spacing:-0.02em;
    margin:0 0 14px; text-wrap:balance;
  }
  #gfa-{{ sid }} .gfa-meta {
    display:flex; align-items:center; flex-wrap:wrap; gap:8px;
    font-size:12.5px; color:var(--gfa-mut); font-weight:500; line-height:1.3; margin-bottom:22px;
  }
  #gfa-{{ sid }} .gfa-dotsep { width:3px; height:3px; border-radius:50%; background:var(--gfa-mut); opacity:.55; flex-shrink:0; }

  #gfa-{{ sid }} .gfa-hero { border-radius:18px; overflow:hidden; margin-bottom:26px; background:#eceef0; }
  #gfa-{{ sid }} .gfa-hero img { width:100%; height:auto; display:block; }

  /* ── Contenu riche (article.content) ── */
  #gfa-{{ sid }} .gfa-rte { font-size:16px; line-height:1.75; color:var(--gfa-text); }
  #gfa-{{ sid }} .gfa-rte > * + * { margin-top:16px; }
  #gfa-{{ sid }} .gfa-rte h2,
  #gfa-{{ sid }} .gfa-rte h3,
  #gfa-{{ sid }} .gfa-rte h4 {
    font-family:var(--gfa-font-head); color:var(--gfa-hd);
    font-weight:700; line-height:1.2; letter-spacing:-0.01em;
  }
  #gfa-{{ sid }} .gfa-rte h2 { font-size:clamp(21px, 5.6vw, 26px); margin-top:34px; }
  #gfa-{{ sid }} .gfa-rte h3 { font-size:clamp(18px, 4.8vw, 21px); margin-top:28px; }
  #gfa-{{ sid }} .gfa-rte h4 { font-size:16.5px; margin-top:24px; }
  #gfa-{{ sid }} .gfa-rte a { color:var(--gfa-accent); text-decoration:underline; text-underline-offset:2px; }
  #gfa-{{ sid }} .gfa-rte strong { font-weight:700; color:var(--gfa-hd); }
  #gfa-{{ sid }} .gfa-rte ul,
  #gfa-{{ sid }} .gfa-rte ol { padding-left:22px; display:flex; flex-direction:column; gap:8px; }
  #gfa-{{ sid }} .gfa-rte li::marker { color:var(--gfa-accent); }
  #gfa-{{ sid }} .gfa-rte img { max-width:100%; height:auto; border-radius:14px; display:block; }
  #gfa-{{ sid }} .gfa-rte blockquote {
    border-left:3px solid var(--gfa-accent);
    background:rgba(var(--gfa-ar),var(--gfa-ag),var(--gfa-ab),0.06);
    padding:14px 18px; border-radius:0 12px 12px 0;
    font-weight:600; color:var(--gfa-hd);
  }
  #gfa-{{ sid }} .gfa-rte iframe { max-width:100%; width:100%; aspect-ratio:16 / 9; height:auto; border:0; border-radius:14px; }
  #gfa-{{ sid }} .gfa-rte table { width:100%; border-collapse:collapse; font-size:14px; display:block; overflow-x:auto; }
  #gfa-{{ sid }} .gfa-rte td,
  #gfa-{{ sid }} .gfa-rte th { border:1px solid rgba(0,0,0,0.10); padding:8px 12px; text-align:left; }

  /* ── CTA optionnel ── */
  #gfa-{{ sid }} .gfa-cta {
    display:flex; align-items:center; justify-content:center; gap:7px;
    width:fit-content; margin:32px auto 0;
    background:var(--gfa-accent); color:#fff; text-decoration:none;
    font-size:14px; font-weight:700; letter-spacing:0.01em;
    padding:14px 28px; border-radius:100px;
    transition:transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s ease;
    box-shadow:0 6px 18px rgba(var(--gfa-ar),var(--gfa-ag),var(--gfa-ab),0.35);
    -webkit-tap-highlight-color:transparent;
  }
  #gfa-{{ sid }} .gfa-cta svg { width:15px; height:15px; flex-shrink:0; }
  @media (hover:hover) and (pointer:fine) {
    #gfa-{{ sid }} .gfa-cta:hover { transform:translateY(-2px); box-shadow:0 10px 24px rgba(var(--gfa-ar),var(--gfa-ag),var(--gfa-ab),0.45); }
  }

  /* ── Précédent / suivant ── */
  #gfa-{{ sid }} .gfa-nav {
    display:grid; grid-template-columns:1fr; gap:10px;
    margin-top:36px; padding-top:24px; border-top:1px solid rgba(0,0,0,0.08);
  }
  #gfa-{{ sid }} .gfa-nav a {
    display:flex; flex-direction:column; gap:4px;
    border:1px solid rgba(0,0,0,0.08); border-radius:14px; padding:14px 16px;
    text-decoration:none; transition:border-color .2s ease, transform .25s cubic-bezier(.22,1,.36,1);
    -webkit-tap-highlight-color:transparent;
  }
  #gfa-{{ sid }} .gfa-nav a:hover { border-color:rgba(var(--gfa-ar),var(--gfa-ag),var(--gfa-ab),0.5); transform:translateY(-2px); }
  #gfa-{{ sid }} .gfa-nav .gfa-nav-lbl { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--gfa-mut); }
  #gfa-{{ sid }} .gfa-nav .gfa-nav-t { font-family:var(--gfa-font-head); font-size:15px; font-weight:700; color:var(--gfa-hd); line-height:1.3; }
  #gfa-{{ sid }} .gfa-nav .gfa-nav--next { text-align:right; }

  /* ── Desktop ── */
  @media (min-width:750px) {
    #gfa-{{ sid }} .gfa-title { font-size:var(--gfa-title); }
    #gfa-{{ sid }} .gfa-rte { font-size:17px; }
    #gfa-{{ sid }} .gfa-hero { border-radius:22px; margin-bottom:32px; }
    #gfa-{{ sid }} .gfa-nav { grid-template-columns:1fr 1fr; }
  }
</style>

<article id="gfa-{{ sid }}">
  <div class="gfa-w">

    {%- if show_back and blog != blank -%}
      <a class="gfa-back" href="{{ blog.url }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        {{ s.back_text | default: 'Tous les articles' }}
      </a>
    {%- endif -%}

    <header>
      {%- if show_tag and article.tags.size > 0 -%}<span class="gfa-chip">{{ article.tags.first }}</span>{%- endif -%}
      <h1 class="gfa-title">{{ article.title }}</h1>
      <div class="gfa-meta">
        {%- if show_date -%}{{ article.published_at | time_tag: format: 'date' }}{%- endif -%}
        {%- if show_readtime -%}
          {%- if show_date -%}<span class="gfa-dotsep" aria-hidden="true"></span>{%- endif -%}
          <span>{{ gf_mins }} min de lecture</span>
        {%- endif -%}
      </div>
    </header>

    {%- if show_image and article.image != blank -%}
      <div class="gfa-hero">
        <img src="{{ article.image | image_url: width: 1440 }}"
             srcset="{{ article.image | image_url: width: 720 }} 720w,
                    {{ article.image | image_url: width: 1080 }} 1080w,
                    {{ article.image | image_url: width: 1440 }} 1440w"
             sizes="(max-width: 749px) 92vw, 720px"
             alt="{{ article.image.alt | default: article.title | escape }}"
             loading="eager" fetchpriority="high" decoding="async"
             width="{{ article.image.width }}" height="{{ article.image.height }}">
      </div>
    {%- endif -%}

    <div class="gfa-rte">
      {{ article.content }}
    </div>

    {%- if s.cta_text != blank and s.cta_link != blank -%}
      <a class="gfa-cta" href="{{ s.cta_link }}">
        {{ s.cta_text }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    {%- endif -%}

    {%- if show_nav -%}
      {%- if blog.previous_article or blog.next_article -%}
        <nav class="gfa-nav" aria-label="Autres articles">
          {%- if blog.previous_article -%}
            <a href="{{ blog.previous_article.url }}">
              <span class="gfa-nav-lbl">← Article précédent</span>
              <span class="gfa-nav-t">{{ blog.previous_article.title }}</span>
            </a>
          {%- endif -%}
          {%- if blog.next_article -%}
            <a class="gfa-nav--next" href="{{ blog.next_article.url }}">
              <span class="gfa-nav-lbl">Article suivant →</span>
              <span class="gfa-nav-t">{{ blog.next_article.title }}</span>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}

  </div>
</article>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    {% if article.image %}"image": [{{ article.image | image_url: width: 1440 | prepend: 'https:' | json }}],{% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
    "mainEntityOfPage": {{ request.origin | append: article.url | json }}
  }
</script>

{%- endif -%}

{% schema %}
{
  "name": "GF Article de blog",
  "tag": "section",
  "class": "gf-article",
  "enabled_on": { "templates": ["article"] },
  "settings": [
    { "type": "paragraph", "content": "À placer sur le template « article ». Affiche automatiquement l'article ouvert : titre, image, contenu, navigation." },

    { "type": "header", "content": "── Affichage ──" },
    { "type": "checkbox", "id": "show_back", "label": "Lien retour au blog", "default": true },
    { "type": "text", "id": "back_text", "label": "Texte du retour", "default": "Tous les articles" },
    { "type": "checkbox", "id": "show_tag", "label": "Tag (premier tag de l'article)", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Date", "default": true },
    { "type": "checkbox", "id": "show_readtime", "label": "Temps de lecture", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Image à la une", "default": true },
    { "type": "checkbox", "id": "show_nav", "label": "Navigation précédent / suivant", "default": true },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille du titre (px)",
      "min": 24,
      "max": 64,
      "step": 2,
      "default": 40,
      "unit": "px"
    },

    { "type": "header", "content": "── CTA en fin d'article ──" },
    { "type": "text", "id": "cta_text", "label": "Texte du bouton (vide = masqué)", "default": "Découvrir GUMFORCE" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" },

    { "type": "header", "content": "── Apparence ──" },
    { "type": "checkbox", "id": "transparent_bg", "label": "Fond transparent (laisse voir le dégradé)", "default": true },
    { "type": "color", "id": "color_bg", "label": "Couleur de fond (si non transparent)", "default": "#ffffff" },
    { "type": "color", "id": "color_heading", "label": "Couleur des titres", "default": "#0e0e0e" },
    { "type": "color", "id": "color_text", "label": "Couleur du texte", "default": "#1c1c1e" },
    { "type": "color", "id": "color_muted", "label": "Couleur texte secondaire", "default": "#6b6b6b" },
    { "type": "color", "id": "accent_color", "label": "Couleur accent", "default": "#2AB5B4" },

    { "type": "header", "content": "── Mise en page ──" },
    { "type": "range", "id": "padding_top", "label": "Padding haut", "min": 0, "max": 120, "step": 4, "default": 32, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bas", "min": 0, "max": 120, "step": 4, "default": 60, "unit": "px" }
  ],
  "presets": [
    { "name": "GF Article de blog", "category": "Blog" }
  ]
}
{% endschema %}
