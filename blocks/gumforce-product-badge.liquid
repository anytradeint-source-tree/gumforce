{%- liquid
  assign gf_id  = block.id
  assign s      = block.settings

  assign gfb_bg_1 = s.color_bg | default: '#1a3a2a'
  assign gfb_text_1 = s.color_text | default: '#ffffff'

  assign has_badge_1 = false
  assign has_badge_2 = false
  assign has_badge_3 = false
  if s.badge_text != blank
    assign has_badge_1 = true
  endif
  if s.badge_text_2 != blank
    assign has_badge_2 = true
    assign gfb_bg_2 = s.color_bg_2 | default: '#2AB5B4'
    assign gfb_text_2 = s.color_text_2 | default: '#ffffff'
  endif
  if s.badge_text_3 != blank
    assign has_badge_3 = true
    assign gfb_bg_3 = s.color_bg_3 | default: '#2AB5B4'
    assign gfb_text_3 = s.color_text_3 | default: '#ffffff'
  endif

  assign badge_count = 0
  if has_badge_1
    assign badge_count = badge_count | plus: 1
  endif
  if has_badge_2
    assign badge_count = badge_count | plus: 1
  endif
  if has_badge_3
    assign badge_count = badge_count | plus: 1
  endif

  assign gap = s.badge_gap | default: 8
-%}

{%- if badge_count > 0 -%}

<style>
  #gfbadge-{{ gf_id }} {
    --gfb-fs: {{ s.font_size | default: 11 }}px;
    display: flex;
    flex-wrap: wrap;
    gap: {{ gap }}px;
    align-items: center;
    /* si le wrapper du thème dimensionne le bloc sur son contenu (fit-content),
       on le plafonne au parent → le débordement devient mesurable (scrollWidth) */
    max-width: 100%;
  }

  #gfbadge-{{ gf_id }} .gfb-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    /* jamais compressée par le flex nowrap : sinon le texte sort de la pill
       sans que la rangée ne déborde (débordement indétectable) */
    flex-shrink: 0;
    font-size: var(--gfb-fs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    line-height: 1.3;
    white-space: nowrap;
    padding: 0.45em 1.25em;
    border-radius: 99px;
    color: var(--gfb-text);
    background: var(--gfb-bg);
    box-shadow: 0 3px 12px rgba(var(--gfb-bg-rgb), 0.28);
  }

  /* 1 ligne garantie (classe posée par le JS → sans JS on garde le wrap) :
     nowrap + la taille de police baisse jusqu'à ce que tout tienne
     (padding en em → suit la police) */
  #gfbadge-{{ gf_id }}.gfb-oneline { flex-wrap: nowrap; }

  /* Badge 1 */
  #gfbadge-{{ gf_id }} .gfb-pill--1 {
    --gfb-bg:     {{ gfb_bg_1 }};
    --gfb-bg-rgb: {{ gfb_bg_1 | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --gfb-text:   {{ gfb_text_1 }};
  }

  {%- if has_badge_2 %}
  /* Badge 2 */
  #gfbadge-{{ gf_id }} .gfb-pill--2 {
    --gfb-bg:     {{ gfb_bg_2 }};
    --gfb-bg-rgb: {{ gfb_bg_2 | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --gfb-text:   {{ gfb_text_2 }};
  }
  {%- endif %}

  {%- if has_badge_3 %}
  /* Badge 3 */
  #gfbadge-{{ gf_id }} .gfb-pill--3 {
    --gfb-bg:     {{ gfb_bg_3 }};
    --gfb-bg-rgb: {{ gfb_bg_3 | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --gfb-text:   {{ gfb_text_3 }};
  }
  {%- endif %}

  #gfbadge-{{ gf_id }} .gfb-icon {
    width: calc(var(--gfb-fs) + 3px);
    height: calc(var(--gfb-fs) + 3px);
    display: block;
    flex-shrink: 0;
  }
</style>

<div id="gfbadge-{{ gf_id }}" {{ block.shopify_attributes }}>

  {%- if has_badge_1 -%}
  <span class="gfb-pill gfb-pill--1">
    {%- case s.icon -%}
      {%- when 'star' -%}
