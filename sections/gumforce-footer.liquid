{% comment %}
  ============================================================================
  GUMFORCE Footer — Clean, proper structure
  ============================================================================
  Three-column layout: Menu | Menu col 2 | Email signup
  Bottom bar: Copyright | Social icons
  Color scheme applied exactly like theme header sections.
  ============================================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign menu_1         = s.menu_1
  assign menu_1_title   = s.menu_1_title
  assign menu_2         = s.menu_2
  assign menu_2_title   = s.menu_2_title
  assign newsletter_heading = s.newsletter_heading | default: 'Join the movement'
  assign show_newsletter = s.show_newsletter
  assign copyright_text  = s.copyright_text

  assign show_instagram = s.show_instagram
  assign show_youtube   = s.show_youtube
  assign show_tiktok    = s.show_tiktok
  assign show_x         = s.show_x
  assign show_threads   = s.show_threads
  assign show_facebook  = s.show_facebook

  assign instagram_url  = s.instagram_url
  assign youtube_url    = s.youtube_url
  assign tiktok_url     = s.tiktok_url
  assign x_url          = s.x_url
  assign threads_url    = s.threads_url
  assign facebook_url   = s.facebook_url

  assign pad_top        = s.padding_top | default: 48
  assign pad_bottom     = s.padding_bottom | default: 24
  assign corner_radius  = s.corner_radius | default: 0
  assign newsletter_align = s.newsletter_align | default: 'left'
-%}

<style>
  #gf-footer-{{ sid }} {
    --gff-pad-top: {{ pad_top }}px;
    --gff-pad-bot: {{ pad_bottom }}px;

    background-color: var(--color-background);
    color: var(--color-foreground);
    width: 100%;
  }

  #gf-footer-{{ sid }} *,
  #gf-footer-{{ sid }} *::before,
  #gf-footer-{{ sid }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  #gf-footer-{{ sid }} .gff-inner {
    max-width: 1340px;
    margin: 0 auto;
    padding: var(--gff-pad-top) 48px var(--gff-pad-bot);
  }

  /* ── Top Row: menus + newsletter ── */
  #gf-footer-{{ sid }} .gff-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding-bottom: 40px;
  }

  /* ── Menu Column ── */
  #gf-footer-{{ sid }} .gff-menus {
    display: flex;
    gap: 64px;
    flex-wrap: wrap;
  }

  #gf-footer-{{ sid }} .gff-menu-col {
    min-width: 140px;
  }

  #gf-footer-{{ sid }} .gff-menu-title {
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
    margin-bottom: 20px;
    line-height: 1.3;
  }

  #gf-footer-{{ sid }} .gff-menu-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #gf-footer-{{ sid }} .gff-menu-list a {
    font-size: 14px;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    #gf-footer-{{ sid }} .gff-menu-list a:hover {
      color: var(--color-foreground);
    }
  }

  /* ── Newsletter ── */
  #gf-footer-{{ sid }} .gff-newsletter {
    max-width: 420px;
  }

  #gf-footer-{{ sid }} .gff-newsletter-heading {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-foreground);
    margin-bottom: 16px;
    line-height: 1.3;
    text-align: {{ newsletter_align }};
  }

  #gf-footer-{{ sid }} .gff-form {
    display: flex;
    gap: 0;
  }

  #gf-footer-{{ sid }} .gff-input {
    flex: 1;
    padding: 14px 18px;
    font-size: 14px;
    font-family: inherit;
    color: var(--color-foreground);
    background: rgb(var(--color-foreground-rgb) / 0.05);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-right: none;
    border-radius: {{ corner_radius }}px 0 0 {{ corner_radius }}px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #gf-footer-{{ sid }} .gff-input:focus {
    border-color: var(--color-foreground);
  }

  #gf-footer-{{ sid }} .gff-input::placeholder {
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }

  #gf-footer-{{ sid }} .gff-submit {
    padding: 14px 24px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    color: var(--color-background);
    background: var(--color-foreground);
    border: 1px solid var(--color-foreground);
    border-radius: 0 {{ corner_radius }}px {{ corner_radius }}px 0;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  @media (hover: hover) {
    #gf-footer-{{ sid }} .gff-submit:hover {
      opacity: 0.85;
    }
  }

  /* ── Divider ── */
  #gf-footer-{{ sid }} .gff-divider {
    height: 1px;
    background: rgb(var(--color-foreground-rgb) / 0.12);
    border: none;
  }

  /* ── Bottom Bar ── */
  #gf-footer-{{ sid }} .gff-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    gap: 20px;
    flex-wrap: wrap;
  }

  #gf-footer-{{ sid }} .gff-copyright {
    font-size: 12px;
    color: rgb(var(--color-foreground-rgb) / 0.5);
    line-height: 1.5;
  }

  /* ── Social Icons ── */
  #gf-footer-{{ sid }} .gff-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  #gf-footer-{{ sid }} .gff-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
    transition: opacity 0.2s ease;
  }

  #gf-footer-{{ sid }} .gff-social-link svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  @media (hover: hover) {
    #gf-footer-{{ sid }} .gff-social-link:hover {
      opacity: 0.6;
    }
  }

  /* ── Desktop ── */
  @media (min-width: 768px) {
    #gf-footer-{{ sid }} .gff-top {
      grid-template-columns: 1fr auto;
      gap: 64px;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    #gf-footer-{{ sid }} .gff-inner {
      padding-left: 24px;
      padding-right: 24px;
    }

    #gf-footer-{{ sid }} .gff-menus {
      gap: 40px;
    }

    #gf-footer-{{ sid }} .gff-newsletter {
      max-width: 100%;
    }

    #gf-footer-{{ sid }} .gff-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 16px;
    }
  }
</style>

<footer
  id="gf-footer-{{ sid }}"
  class="gff-footer section color-{{ s.color_scheme }}"
  role="contentinfo"
  {{ section.shopify_attributes }}
>
  <div class="gff-inner">

    <!-- ===== Top: Menus + Newsletter ===== -->
    <div class="gff-top">

      <!-- Menu Columns -->
      <div class="gff-menus">
        {%- if menu_1 != blank -%}
          <nav class="gff-menu-col" aria-label="{{ menu_1_title | default: 'Menu' | escape }}">
            {%- if menu_1_title != blank -%}
              <p class="gff-menu-title">{{ menu_1_title }}</p>
            {%- endif -%}
            <ul class="gff-menu-list">
              {%- for link in menu_1.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if menu_2 != blank -%}
          <nav class="gff-menu-col" aria-label="{{ menu_2_title | default: 'Menu' | escape }}">
            {%- if menu_2_title != blank -%}
              <p class="gff-menu-title">{{ menu_2_title }}</p>
            {%- endif -%}
            <ul class="gff-menu-list">
              {%- for link in menu_2.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>

      <!-- Newsletter -->
      {%- if show_newsletter -%}
        <div class="gff-newsletter">
          {%- if newsletter_heading != blank -%}
            <p class="gff-newsletter-heading">{{ newsletter_heading }}</p>
          {%- endif -%}
          {%- form 'customer', id: 'gff-newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="gff-form">
              <input
                class="gff-input"
                type="email"
                name="contact[email]"
                placeholder="{{ s.input_placeholder | default: 'Email address' }}"
                required
                autocomplete="email"
                aria-label="Email address"
              >
              <button class="gff-submit" type="submit">{{ s.btn_label | default: 'Sign up' }}</button>
            </div>
          {%- endform -%}
        </div>
      {%- endif -%}

    </div>

    <!-- ===== Divider ===== -->
    <hr class="gff-divider" aria-hidden="true">

    <!-- ===== Bottom: Copyright + Socials ===== -->
    <div class="gff-bottom">
      <p class="gff-copyright">
        {%- if copyright_text != blank -%}
          {{ copyright_text }}
        {%- else -%}
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        {%- endif -%}
      </p>

      <div class="gff-socials">
        {%- if show_instagram -%}
          <a class="gff-social-link" href="{{ instagram_url | default: '#' }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.17.054 1.97.24 2.43.403a4.088 4.088 0 011.47.958c.453.453.773.898.958 1.47.163.46.35 1.26.403 2.43.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.054 1.17-.24 1.97-.403 2.43a4.088 4.088 0 01-.958 1.47 4.088 4.088 0 01-1.47.958c-.46.163-1.26.35-2.43.403-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.17-.054-1.97-.24-2.43-.403a4.088 4.088 0 01-1.47-.958 4.088 4.088 0 01-.958-1.47c-.163-.46-.35-1.26-.403-2.43C2.175 15.584 2.163 15.204 2.163 12s.012-3.584.07-4.85c.054-1.17.24-1.97.403-2.43a4.088 4.088 0 01.958-1.47 4.088 4.088 0 011.47-.958c.46-.163 1.26-.35 2.43-.403C8.416 2.175 8.796 2.163 12 2.163zM12 0C8.741 0 8.333.014 7.053.072 5.775.13 4.902.333 4.14.63a5.876 5.876 0 00-2.126 1.384A5.876 5.876 0 00.63 4.14C.333 4.902.13 5.775.072 7.053.014 8.333 0 8.741 0 12s.014 3.667.072 4.947c.058 1.278.261 2.151.558 2.913a5.876 5.876 0 001.384 2.126 5.876 5.876 0 002.126 1.384c.762.297 1.635.5 2.913.558C8.333 23.986 8.741 24 12 24s3.667-.014 4.947-.072c1.278-.058 2.151-.261 2.913-.558a5.876 5.876 0 002.126-1.384 5.876 5.876 0 001.384-2.126c.297-.762.5-1.635.558-2.913C23.986 15.667 24 15.259 24 12s-.014-3.667-.072-4.947c-.058-1.278-.261-2.151-.558-2.913a5.876 5.876 0 00-1.384-2.126A5.876 5.876 0 0019.86.63C19.098.333 18.225.13 16.947.072 15.667.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        {%- endif -%}

        {%- if show_youtube -%}
          <a class="gff-social-link" href="{{ youtube_url | default: '#' }}" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        {%- endif -%}

        {%- if show_tiktok -%}
          <a class="gff-social-link" href="{{ tiktok_url | default: '#' }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
          </a>
        {%- endif -%}

        {%- if show_x -%}
          <a class="gff-social-link" href="{{ x_url | default: '#' }}" target="_blank" rel="noopener" aria-label="X">
            <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        {%- endif -%}

        {%- if show_threads -%}
          <a class="gff-social-link" href="{{ threads_url | default: '#' }}" target="_blank" rel="noopener" aria-label="Threads">
            <svg viewBox="0 0 24 24"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.59 12c.025 3.086.718 5.496 2.057 7.164 1.432 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.96-.065-1.187.408-2.26 1.33-3.017.88-.724 2.104-1.13 3.446-1.145.93-.01 1.784.134 2.554.428-.025-1.18-.287-2.075-.788-2.678-.59-.71-1.55-1.07-2.855-1.07l-.033.001c-.89.008-1.637.238-2.222.684l-1.31-1.55c.905-.724 2.1-1.123 3.556-1.137l.046-.001c1.898 0 3.368.59 4.37 1.756.919 1.069 1.4 2.578 1.432 4.488.058.024.114.05.171.076 1.116.516 1.997 1.303 2.546 2.276.755 1.338.936 3.016.495 4.598-.675 2.428-2.667 4.125-5.932 5.053-.972.275-2.036.42-3.164.434zm.07-8.769c-.938.01-1.702.2-2.213.554-.47.326-.696.776-.672 1.335.035.669.376 1.162.984 1.424.485.21 1.1.294 1.732.26 1.073-.06 1.895-.44 2.444-1.124.361-.45.618-1.056.764-1.81-.653-.258-1.39-.395-2.195-.412l-.1-.001-.543-.001z"/></svg>
          </a>
        {%- endif -%}

        {%- if show_facebook -%}
          <a class="gff-social-link" href="{{ facebook_url | default: '#' }}" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "GUMFORCE Footer",
  "tag": "section",
  "class": "gff-footer-wrapper",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Menu 1"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu title",
      "default": "Main Menu"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu",
      "default": "main-menu"
    },

    {
      "type": "header",
      "content": "Menu 2 (optional)"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu title"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu"
    },

    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join the movement"
    },
    {
      "type": "select",
      "id": "newsletter_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Sign up"
    },

    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Custom copyright text",
      "info": "Leave blank to auto-generate © [year] [store name]"
    },

    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Instagram",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "checkbox",
      "id": "show_youtube",
      "label": "YouTube",
      "default": true
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "TikTok",
      "default": true
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "checkbox",
      "id": "show_x",
      "label": "X (Twitter)",
      "default": true
    },
    {
      "type": "url",
      "id": "x_url",
      "label": "X URL"
    },
    {
      "type": "checkbox",
      "id": "show_threads",
      "label": "Threads",
      "default": true
    },
    {
      "type": "url",
      "id": "threads_url",
      "label": "Threads URL"
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Facebook",
      "default": false
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Newsletter input radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 6,
      "unit": "px",
      "info": "Corner radius for the email input and submit button."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "GUMFORCE Footer"
    }
  ]
}
{% endschema %}
