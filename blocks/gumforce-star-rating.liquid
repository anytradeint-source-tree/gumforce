{%- liquid
  assign gf_id          = block.id
  assign s              = block.settings
  assign rating_str     = s.rating | default: '4.8'
  if rating_str == 'theme'
    assign rating_str   = settings.gf_tp_rating | default: '4.8'
  endif
  assign review_text    = s.review_count | replace: '[avis]', settings.gf_tp_count | replace: '[note]', rating_str
  comment — test A/B : version « toutes plateformes » = étoiles dessinées à la couleur choisie, texte à part (pas d'image Trustpilot)
  endcomment
  assign mode_all       = false
  assign count_src      = s.review_count
  assign star_color     = s.color_star | default: '#F5A623'
  if s.count_mode == 'all'
    assign mode_all     = true
    assign count_src    = s.all_text
    assign review_text  = s.all_text | replace: '[note]', rating_str
    assign star_color   = s.all_star_color | default: '#2AB5B4'
  endif
  assign img_h          = s.stars_image_height | default: 20
  assign img_h_retina   = img_h | times: 3

  assign full_stars     = rating_str | plus: 0 | floor
  assign decimal_str    = rating_str | split: '.' | last | plus: 0
  assign has_half       = false
  if decimal_str >= 5
    assign has_half = true
  endif
  if mode_all
    comment — arrondi à la demi-étoile la plus proche : 4.8 → 5 étoiles pleines (comme l'en-tête de la section avis)
    endcomment
    assign half_units   = rating_str | plus: 0 | times: 2 | round
    assign full_stars   = half_units | divided_by: 2
    assign half_rest    = half_units | modulo: 2
    assign has_half     = false
    if half_rest == 1
      assign has_half   = true
    endif
  endif
  assign empty_stars    = 5 | minus: full_stars
  if has_half
    assign empty_stars  = empty_stars | minus: 1
  endif
-%}
<style>
  #gfsr-{{ gf_id }} {
    --gfsr-star:  {{ star_color }};
    --gfsr-empty: #d1d5db;
    --gfsr-text:  {{ s.color_text    | default: '#111111' }};
    --gfsr-sub:   {{ s.color_subtext | default: '#6b7280' }};
    --gfsr-size:  {{ s.star_size     | default: 18 }}px;
    --gfsr-imgh:  {{ img_h }}px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    line-height: 1;
  }
  #gfsr-{{ gf_id }} .gfsr-stars {
    display: flex;
    align-items: center;
    gap: 1px;
  }
  /* custom image */
  #gfsr-{{ gf_id }} .gfsr-img {
    display: block;
    height: var(--gfsr-imgh);
    max-height: var(--gfsr-imgh);
    width: auto;
    object-fit: contain;
  }
  /* svg fallback */
  #gfsr-{{ gf_id }} .gfsr-stars svg {
    width: var(--gfsr-size);
    height: var(--gfsr-size);
    display: block;
    flex-shrink: 0;
  }
  {%- if mode_all %}
  /* toutes plateformes : étoiles serrées (le dessin a 1,5 px de marge de chaque côté dans son carré) → ~1 px entre deux étoiles */
  #gfsr-{{ gf_id }}.gfsr--all .gfsr-stars { gap: 0; }
  #gfsr-{{ gf_id }}.gfsr--all .gfsr-stars svg { margin-inline: -1px; }
  {%- endif %}
  #gfsr-{{ gf_id }} .gfsr-number {
    font-size: calc(var(--gfsr-size) * 0.83);
    font-weight: 700;
    color: var(--gfsr-text);
  }
  #gfsr-{{ gf_id }} .gfsr-count {
    font-size: calc(var(--gfsr-size) * 0.72);
    color: var(--gfsr-sub);
  }
  #gfsr-{{ gf_id }} .gfsr-count a {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
</style>

<div id="gfsr-{{ gf_id }}"{% if mode_all %} class="gfsr--all"{% endif %} {{ block.shopify_attributes }}>

  <div class="gfsr-stars" role="img" aria-label="Rating: {{ rating_str }} out of 5">

    {%- if s.stars_image != blank and mode_all == false -%}

      {{- s.stars_image | image_url: height: img_h_retina | image_tag:
          class: 'gfsr-img',
          loading: 'eager',
          alt: 'Star rating' -}}

    {%- elsif s.stars_image_url != blank and mode_all == false -%}

      <img src="{{ s.stars_image_url }}" class="gfsr-img" alt="Star rating" loading="eager" decoding="async">

    {%- else -%}

      <svg style="display:none" aria-hidden="true">
        <defs>
          <linearGradient id="gfsr-half-{{ gf_id }}" x1="0" x2="1" y1="0" y2="0">
            <stop offset="50%" stop-color="var(--gfsr-star)"/>
            <stop offset="50%" stop-color="var(--gfsr-empty)"/>
          </linearGradient>
        </defs>
      </svg>

      {%- for i in (1..full_stars) -%}
        <svg viewBox="0 0 24 24" fill="var(--gfsr-star)" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      {%- endfor -%}
      {%- if has_half -%}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="url(#gfsr-half-{{ gf_id }})" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      {%- endif -%}
      {%- for i in (1..empty_stars) -%}
        <svg viewBox="0 0 24 24" fill="var(--gfsr-empty)" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      {%- endfor -%}

    {%- endif -%}

  </div>

  {%- if s.show_number -%}
    <span class="gfsr-number">{{ rating_str }}</span>
  {%- endif -%}

  {%- if count_src != blank -%}
    <span class="gfsr-count">
      {%- if s.review_link != blank -%}
        <a href="{{ s.review_link }}" onclick="if(this.hash){var t=document.querySelector(this.hash);if(t){event.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'});}}">{{ review_text }}</a>
      {%- else -%}
        {{ review_text }}
      {%- endif -%}
    </span>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "GF Star Rating",
  "settings": [
    {
      "type": "header",
      "content": "Version des avis (test A/B)"
    },
    {
      "type": "select",
      "id": "count_mode",
      "label": "Avis affichés",
      "options": [
        { "value": "trustpilot", "label": "Trustpilot (image + texte ci-dessous)" },
        { "value": "all", "label": "Toutes plateformes" }
      ],
      "default": "trustpilot"
    },
    {
      "type": "text",
      "id": "all_text",
      "label": "Texte — toutes plateformes",
      "default": "[note]/5 Excellent | 8\u00a0643 avis clients",
      "info": "[note] = la note réglée plus bas. Étoiles dessinées (pas d'image Trustpilot)."
    },
    {
      "type": "color",
      "id": "all_star_color",
      "label": "Couleur des étoiles — toutes plateformes",
      "default": "#2ab5b4"
    },
    {
      "type": "header",
      "content": "Stars image"
    },
    {
      "type": "image_picker",
      "id": "stars_image",
      "label": "Upload stars image"
    },
    {
      "type": "text",
      "id": "stars_image_url",
      "label": "Or paste image URL",
      "info": "Use if your image is in Shopify Files. Leave blank if using the picker above."
    },
    {
      "type": "range",
      "id": "stars_image_height",
      "label": "Image height (px)",
      "min": 12,
      "max": 48,
      "step": 2,
      "default": 20
    },
    {
      "type": "header",
      "content": "Rating & text"
    },
    {
      "type": "select",
      "id": "rating",
      "label": "Rating value",
      "info": "Shown as number and used for SVG fallback stars",
      "options": [
        { "value": "theme", "label": "Réglage du thème (Avis Trustpilot)" },
        { "value": "5.0", "label": "5.0" },
        { "value": "4.9", "label": "4.9" },
        { "value": "4.8", "label": "4.8" },
        { "value": "4.7", "label": "4.7" },
        { "value": "4.6", "label": "4.6" },
        { "value": "4.5", "label": "4.5" },
        { "value": "4.4", "label": "4.4" },
        { "value": "4.3", "label": "4.3" },
        { "value": "4.2", "label": "4.2" },
        { "value": "4.1", "label": "4.1" },
        { "value": "4.0", "label": "4.0" },
        { "value": "3.9", "label": "3.9" },
        { "value": "3.8", "label": "3.8" },
        { "value": "3.5", "label": "3.5" }
      ],
      "default": "4.8"
    },
    {
      "type": "checkbox",
      "id": "show_number",
      "label": "Show rating number",
      "default": true
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count text",
      "placeholder": "e.g. 1,247 reviews",
      "info": "[avis] = nombre d'avis, [note] = note (Réglages du thème › Avis Trustpilot)",
      "default": "1,247 reviews"
    },
    {
      "type": "url",
      "id": "review_link",
      "label": "Review section link (optional)"
    },
    {
      "type": "header",
      "content": "SVG fallback style",
      "info": "Only applies when no image is uploaded"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size (px)",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 18
    },
    {
      "type": "color",
      "id": "color_star",
      "label": "Star color",
      "default": "#F5A623"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Rating number color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "color_subtext",
      "label": "Review count color",
      "default": "#6b7280"
    }
  ],
  "presets": [
    {
      "name": "GF Star Rating"
    }
  ]
}
{% endschema %}
