{%- comment -%} Mode Black Friday : affiche « 1 » quand le mode est coché et pas encore terminé. Le balisage Black Friday est alors rendu, puis montré par la classe html.gf-bf (posée dans layout/theme.liquid entre les deux dates). Sortie sans espace : elle est capturée et comparée à '1'. {%- endcomment -%}
{%- liquid
  comment — langue du site hors de la liste « Langues où le concours s'affiche » → pas de mode Black Friday (vide = toutes les langues)
  endcomment
  assign gf_bf_lang_ok = true
  assign gf_bf_langs = settings.gf_bf_locales | downcase | remove: ' '
  if gf_bf_langs != blank
    assign gf_bf_langs_l = gf_bf_langs | split: ','
    unless gf_bf_langs_l contains request.locale.iso_code
      assign gf_bf_lang_ok = false
    endunless
  endif
  if settings.gf_bf_enabled and gf_bf_lang_ok
    assign gf_bf_e = settings.gf_bf_end | strip | remove: '-' | plus: 0
    assign gf_bf_t = 'now' | date: '%Y%m%d' | plus: 0
    if gf_bf_e == 0 or gf_bf_t <= gf_bf_e
      echo '1'
    endif
  endif
-%}
