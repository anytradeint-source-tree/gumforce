{%- liquid
  assign gf_id     = block.id
  assign s         = block.settings
  assign title_tag = s.title_tag | default: 'h3'
  assign icon_style = s.icon_style | default: 'chevron'
  assign open_first = s.open_first | default: false
  assign one_at_a_time = s.one_at_a_time | default: false
-%}

<style>
  #gfa-{{ gf_id }} {
    --gfa-border   : {{ s.color_border | default: '#e5e7eb' }};
    --gfa-title    : {{ s.color_title  | default: 'currentColor' }};
    --gfa-body     : {{ s.color_body   | default: 'currentColor' }};
    --gfa-icon     : {{ s.color_icon   | default: 'currentColor' }};
    --gfa-accent   : {{ s.color_accent | default: 'transparent' }};
    --gfa-hover-bg : {{ s.color_hover  | default: 'rgba(0,0,0,0.02)' }};
    --gfa-dur      : 0.3s;
    --gfa-ease     : cubic-bezier(0.25, 0.46, 0.45, 0.94);
    list-style     : none;
    margin         : 0;
    padding        : 0;
  }

  #gfa-{{ gf_id }} .gfa-item {
    border-bottom : 1px solid var(--gfa-border);
    position      : relative;
    transition    : background-color var(--gfa-dur) var(--gfa-ease);
  }
  #gfa-{{ gf_id }} .gfa-item:first-child {
    border-top : 1px solid var(--gfa-border);
  }

  /* accent bar */
  #gfa-{{ gf_id }} .gfa-item::before {
    content    : '';
    position   : absolute;
    left       : 0;
    top        : 0;
    bottom     : 0;
    width      : 3px;
    background : var(--gfa-accent);
    opacity    : 0;
    transition : opacity var(--gfa-dur) var(--gfa-ease);
  }
  #gfa-{{ gf_id }} .gfa-item.gfa-open::before {
    opacity : 1;
  }

  /* heading */
  #gfa-{{ gf_id }} .gfa-heading {
    margin  : 0;
    padding : 0;
  }

  /* trigger button */
  #gfa-{{ gf_id }} .gfa-trigger {
    all             : unset;
    box-sizing      : border-box;
    font            : inherit;
    color           : var(--gfa-title);
    display         : flex;
    align-items     : center;
    justify-content : space-between;
    gap             : 16px;
    width           : 100%;
    padding         : {{ s.row_padding | default: 20 }}px 16px;
    cursor          : pointer;
    text-align      : left;
    text-transform  : {{ s.text_transform | default: 'none' }};
    letter-spacing  : {{ s.letter_spacing | default: '0' }}em;
    transition      : color var(--gfa-dur) var(--gfa-ease);
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) {
    #gfa-{{ gf_id }} .gfa-trigger:hover {
      background : var(--gfa-hover-bg);
    }
  }
  #gfa-{{ gf_id }} .gfa-trigger:focus-visible {
    outline        : 2px solid var(--gfa-title);
    outline-offset : -2px;
    border-radius  : 2px;
  }

  /* icon — shared */
  #gfa-{{ gf_id }} .gfa-icon {
    flex-shrink : 0;
    width       : 18px;
    height      : 18px;
    color       : var(--gfa-icon);
    display     : block;
    position    : relative;
    transition  : transform var(--gfa-dur) var(--gfa-ease),
                  color var(--gfa-dur) var(--gfa-ease);
  }

  /* chevron rotation */
  #gfa-{{ gf_id }} .gfa-trigger[aria-expanded="true"] .gfa-icon--chevron {
    transform : rotate(180deg);
  }

  /* plus/minus icon via CSS bars */
  #gfa-{{ gf_id }} .gfa-icon--plus span {
    display    : block;
    position   : absolute;
    background : currentColor;
    border-radius : 1px;
    transition : transform var(--gfa-dur) var(--gfa-ease),
                 opacity var(--gfa-dur) var(--gfa-ease);
  }
  #gfa-{{ gf_id }} .gfa-icon--plus .gfa-h {
    width  : 100%;
    height : 2px;
    top    : 50%;
    left   : 0;
    transform : translateY(-50%);
  }
  #gfa-{{ gf_id }} .gfa-icon--plus .gfa-v {
    width  : 2px;
    height : 100%;
    left   : 50%;
    top    : 0;
    transform : translateX(-50%);
  }
  #gfa-{{ gf_id }} .gfa-trigger[aria-expanded="true"] .gfa-icon--plus .gfa-v {
    transform : translateX(-50%) rotate(90deg);
    opacity   : 0;
  }

  /* smooth height — grid trick */
  #gfa-{{ gf_id }} .gfa-panel {
    display            : grid;
    grid-template-rows : 0fr;
    transition         : grid-template-rows var(--gfa-dur) var(--gfa-ease);
  }
  #gfa-{{ gf_id }} .gfa-item.gfa-open .gfa-panel {
    grid-template-rows : 1fr;
  }

  #gfa-{{ gf_id }} .gfa-overflow {
    overflow : hidden;
  }

  /* body content with opacity fade */
  #gfa-{{ gf_id }} .gfa-body {
    font-family : var(--font-body-family, sans-serif);
    font-weight : var(--font-body-weight, 400);
    font-style  : var(--font-body-style, normal);
    color       : var(--gfa-body);
    font-size   : {{ s.body_size | default: 14 }}px;
    line-height : {{ s.body_line_height | default: 1.75 }};
    padding     : 0 16px 20px;
    opacity     : 0;
    transform   : translateY(-4px);
    transition  : opacity var(--gfa-dur) var(--gfa-ease),
                  transform var(--gfa-dur) var(--gfa-ease);
  }
  #gfa-{{ gf_id }} .gfa-item.gfa-open .gfa-body {
    opacity   : 1;
    transform : translateY(0);
  }

  #gfa-{{ gf_id }} .gfa-body p            { margin: 0 0 12px; }
  #gfa-{{ gf_id }} .gfa-body p:last-child { margin-bottom: 0; }
</style>

<ul id="gfa-{{ gf_id }}" {{ block.shopify_attributes }}>
  {%- for i in (1..6) -%}
    {%- assign title_key = 'title_' | append: i -%}
    {%- assign body_key  = 'body_'  | append: i -%}
    {%- assign t = s[title_key] -%}
    {%- assign b = s[body_key] -%}
    {%- if t != blank and b != blank -%}
      {%- assign body_html = b | newline_to_br | replace: '<br /><br />', '</p><p>' | prepend: '<p>' | append: '</p>' -%}
      {%- assign is_first_open = false -%}
      {%- if open_first and forloop.first -%}
        {%- assign is_first_open = true -%}
      {%- endif -%}
      <li class="gfa-item{% if is_first_open %} gfa-open{% endif %}">

        <{{ title_tag }} class="gfa-heading">
          <button
            class         = "gfa-trigger"
            type          = "button"
            aria-expanded = "{% if is_first_open %}true{% else %}false{% endif %}"
            aria-controls = "gfa-p-{{ gf_id }}-{{ i }}"
          >
            {{ t }}
            {%- if icon_style == 'plus' -%}
              <span class="gfa-icon gfa-icon--plus" aria-hidden="true">
                <span class="gfa-h"></span>
                <span class="gfa-v"></span>
              </span>
            {%- else -%}
              <svg class="gfa-icon gfa-icon--chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            {%- endif -%}
          </button>
        </{{ title_tag }}>

        <div class="gfa-panel" id="gfa-p-{{ gf_id }}-{{ i }}" role="region" aria-label="{{ t }}">
          <div class="gfa-overflow">
            <div class="gfa-body">{{ body_html }}</div>
          </div>
        </div>

      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

<script>
(function(){
  var root = document.getElementById('gfa-{{ gf_id }}');
  if (!root) return;
  var oneAtATime = {{ one_at_a_time }};

  root.querySelectorAll('.gfa-trigger').forEach(function(btn){
    btn.addEventListener('click', function(){
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      var item = btn.closest('.gfa-item');

      if (oneAtATime && !isOpen) {
        root.querySelectorAll('.gfa-trigger[aria-expanded="true"]').forEach(function(other){
          other.setAttribute('aria-expanded', 'false');
          other.closest('.gfa-item').classList.remove('gfa-open');
        });
      }

      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      item.classList.toggle('gfa-open', !isOpen);
    });
  });
})();
</script>

{% schema %}
{
  "name": "GF Accordions",
  "settings": [
    {
      "type": "header",
      "content": "Accordion 1"
    },
    {
      "type": "text",
