{% comment %}
  ============================================================================
  GUMFORCE Sticky Add-to-Cart — Floating Bar
  ============================================================================
  Frosted-glass floating bar that materialises after scrolling past
  the bundle picker and dissolves near the footer.
  "Shop Now" scrolls smoothly back to the bundle-picker section.
  ============================================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign title        = s.product_title | default: 'GUMFORCE'
  assign show_rating  = s.show_rating
  assign rating_text  = s.rating_text | default: '4.8'
  assign rating_img   = s.rating_image
  assign rating_h     = s.rating_image_height | default: 14
  assign show_price   = s.show_price
  assign prod         = s.price_product | default: product
  if s.price_text != blank
    assign price_text = s.price_text
  elsif prod != blank and prod.price != blank
    assign gf_curcode = false
    assign gf_loccur = localization.country.currency.iso_code | default: cart.currency.iso_code
    if gf_loccur != shop.currency
      assign gf_curcode = true
    endif
    assign price_text = prod.price | money
    if gf_curcode
      assign price_text = prod.price | money_with_currency
    endif
  else
    assign price_text = ''
  endif
  if s.compare_price != blank
    assign compare_text = s.compare_price
  elsif prod != blank and prod.compare_at_price != blank and prod.compare_at_price > prod.price
    assign compare_text = prod.compare_at_price | money
    if gf_curcode
      assign compare_text = prod.compare_at_price | money_with_currency
    endif
  else
    assign compare_text = ''
  endif
  assign cta_text     = s.cta_text | default: 'SHOP NOW'

  assign show_image   = s.show_image
  assign product_img  = s.product_image
  assign img_size     = s.image_size | default: 32
  assign img_size_3x  = img_size | times: 3

  assign style        = s.style | default: 'noir'
  assign is_glass     = false
  assign border_color = 'rgba(255,255,255,0.08)'
  case style
    when 'vert'
      assign bg_color = '#C5FE89'
      assign bg_alpha = 1.0
      assign text_color = '#0A0A0A'
      assign cta_bg = '#121212'
      assign cta_txt = '#FFFFFF'
      assign border_color = 'rgba(0,0,0,0.10)'
    when 'glass'
      assign bg_color = '#123630'
      assign bg_alpha = 0.82
      assign text_color = '#EAFFFB'
      assign cta_bg = '#2AB5B4'
      assign cta_txt = '#FFFFFF'
      assign is_glass = true
      assign border_color = 'rgba(42,181,180,0.40)'
    when 'clair'
      assign bg_color = '#FFFFFF'
      assign bg_alpha = 1.0
      assign text_color = '#0A0A0A'
      assign cta_bg = '#2AB5B4'
      assign cta_txt = '#FFFFFF'
      assign border_color = 'rgba(0,0,0,0.07)'
    when 'custom'
      assign bg_color = s.bg_color | default: '#121212'
      assign bg_alpha = s.bg_opacity | default: 92 | times: 0.01
      assign text_color = s.text_color | default: '#F4F4F4'
      assign cta_bg = s.cta_bg | default: '#F4F4F4'
      assign cta_txt = s.cta_text_color | default: '#121212'
      assign is_glass = true
    else
      assign bg_color = '#161616'
      assign bg_alpha = 1.0
      assign text_color = '#F4F4F4'
      assign cta_bg = '#FFFFFF'
      assign cta_txt = '#0A0A0A'
      assign border_color = 'rgba(255,255,255,0.08)'
  endcase
  assign bg_rgba      = bg_color | color_modify: 'alpha', bg_alpha

  assign bar_radius   = s.bar_radius | default: 16
  assign cta_radius   = s.cta_radius | default: 10
  assign blur_px      = s.blur_strength | default: 20

  assign rating_h_3x  = rating_h | times: 3
-%}

<style>
  /* ── Zero the section wrapper so it takes no document flow ── */
  section.gf-satc-section {
    height: 0;
    overflow: visible;
    margin: 0;
    padding: 0;
    border: none;
  }

  /* ================================================================
     BAR — frosted-glass capsule, fixed to bottom-center
     ================================================================ */
  #gf-satc-{{ sid }} {
    --satc-bg:         {{ bg_rgba }};
    --satc-text:       {{ text_color }};
    --satc-cta-bg:     {{ cta_bg }};
    --satc-cta-text:   {{ cta_txt }};
    --satc-blur:       {{ blur_px }}px;
    --satc-radius:     {{ bar_radius }}px;
    --satc-cta-radius: {{ cta_radius }}px;

    position: fixed;
    bottom: calc(16px + env(safe-area-inset-bottom));
    left: 50%;
    z-index: 9990;

    width: calc(100% - 32px);
    max-width: 680px;

    background: var(--satc-bg);
    {%- if is_glass %}
    backdrop-filter: blur(var(--satc-blur)) saturate(1.5);
    -webkit-backdrop-filter: blur(var(--satc-blur)) saturate(1.5);
    {%- endif %}

    border: 1px solid {{ border_color }};
    border-radius: var(--satc-radius);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.30),
      0 0 0 0.5px rgba(0, 0, 0, 0.10);

    /* ── hidden state ── */
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(20px);
    transition:
      opacity   0.45s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  /* ── visible state ── */
  #gf-satc-{{ sid }}.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  /* ── accent gradient hairline ── */
  #gf-satc-{{ sid }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.12) 40%,
      rgba(255, 255, 255, 0.12) 60%,
      transparent
    );
    border-radius: 1px;
    pointer-events: none;
  }

  /* ================================================================
     INNER LAYOUT
     ================================================================ */
  .gf-satc__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px 12px 20px;
  }

  /* ── Left: title + rating ── */
  .gf-satc__info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .gf-satc__img {
    width: {{ img_size }}px;
    height: {{ img_size }}px;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .gf-satc__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--satc-text);
    letter-spacing: 0.01em;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  /* ── Rating capsule ── */
  .gf-satc__rating {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }

  .gf-satc__rating::before {
    content: '\00B7';
    color: rgba(255, 255, 255, 0.22);
    font-size: 18px;
    line-height: 1;
    margin-right: 1px;
  }

  .gf-satc__stars-img {
    height: {{ rating_h }}px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .gf-satc__stars-fallback {
    color: #FFC857;
    font-size: 13px;
    line-height: 1;
    letter-spacing: -0.5px;
  }

  .gf-satc__rating-val {
    font-size: 12px;
    font-weight: 500;
    color: var(--satc-text);
    opacity: 0.65;
    line-height: 1;
  }

  /* ── Price ── */
  .gf-satc__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-shrink: 0;
  }

  .gf-satc__price-current {
    font-size: 15px;
    font-weight: 700;
    color: var(--satc-text);
    line-height: 1;
  }

  .gf-satc__price-compare {
    font-size: 12px;
    color: var(--satc-text);
    opacity: 0.35;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    line-height: 1;
  }

  /* ================================================================
     CTA BUTTON
     ================================================================ */
  .gf-satc__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 26px;
    background: var(--satc-cta-bg);
    color: var(--satc-cta-text);
    font-family: var(--font-body--family, 'Manrope', sans-serif);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    border: none;
    border-radius: var(--satc-cta-radius);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform  0.2s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.2s ease;
  }

  /* Hover overlay — brightens any CTA color universally */
  .gf-satc__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0);
    transition: background 0.2s ease;
    pointer-events: none;
  }

  .gf-satc__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.18);
  }

  .gf-satc__cta:hover::after {
    background: rgba(255, 255, 255, 0.08);
  }

  .gf-satc__cta:active {
    transform: translateY(0) scale(0.97);
    box-shadow: none;
    transition-duration: 0.08s;
  }

  .gf-satc__cta:focus-visible {
    outline: 2px solid var(--satc-cta-bg);
    outline-offset: 3px;
  }

  /* ================================================================
     MOBILE
     ================================================================ */
  @media (max-width: 749px) {
    #gf-satc-{{ sid }} {
      width: calc(100% - 24px);
      bottom: calc(12px + env(safe-area-inset-bottom));
    }

    .gf-satc__inner {
      padding: 10px 12px 10px 16px;
      gap: 10px;
    }

    .gf-satc__img {
      width: {{ img_size | minus: 4 }}px;
      height: {{ img_size | minus: 4 }}px;
    }

    .gf-satc__title {
      font-size: 13px;
    }

    .gf-satc__cta {
      padding: 10px 18px;
      font-size: 11px;
      letter-spacing: 0.06em;
    }

    .gf-satc__rating {
      display: none;
    }
  }

  /* ================================================================
     REDUCED MOTION
     ================================================================ */
  @media (prefers-reduced-motion: reduce) {
    #gf-satc-{{ sid }} {
      transition: opacity 0.15s ease;
      transform: translateX(-50%);
    }
    #gf-satc-{{ sid }}.is-visible {
      transform: translateX(-50%);
    }
    .gf-satc__cta {
      transition: none;
    }
  }

  /* ================================================================
     BACKDROP-FILTER FALLBACK
     ================================================================ */
  @supports not (backdrop-filter: blur(1px)) {
    #gf-satc-{{ sid }} {
      background: {{ bg_color | color_modify: 'alpha', 0.97 }};
    }
  }
</style>

<!-- ═══════════════════════════════════════════════════════════════
     HTML
     ═══════════════════════════════════════════════════════════ -->
{%- comment -%} Rupture de stock : pas de barre « j'en profite » quand le produit est épuisé (stock Shopify) {%- endcomment -%}
{%- assign gf_satc_oos = false -%}
{%- if prod != blank and prod.available == false -%}{%- assign gf_satc_oos = true -%}{%- endif -%}
{%- unless gf_satc_oos -%}
<div id="gf-satc-{{ sid }}" aria-label="Quick purchase" role="complementary">
  <div class="gf-satc__inner">

    <!-- Left: title + rating -->
    <div class="gf-satc__info">
      {%- if show_image and product_img -%}
      <img
        class="gf-satc__img"
        src="{{ product_img | image_url: width: img_size_3x }}"
        alt="{{ title | escape }}"
        width="{{ img_size }}"
        height="{{ img_size }}"
        loading="lazy"
        decoding="async">
      {%- endif -%}
      <span class="gf-satc__title">{{ title }}</span>

      {%- if show_rating -%}
      <span class="gf-satc__rating">
        {%- if rating_img -%}
          <img
            class="gf-satc__stars-img"
            src="{{ rating_img | image_url: height: rating_h_3x }}"
            alt="Rating"
            height="{{ rating_h }}"
            loading="lazy"
            decoding="async">
        {%- else -%}
          <span class="gf-satc__stars-fallback" aria-hidden="true">&#9733;</span>
        {%- endif -%}
        <span class="gf-satc__rating-val">{{ rating_text }}</span>
      </span>
      {%- endif -%}
    </div>

    <!-- Center: price (optional, hidden on mobile) -->
    {%- if show_price and price_text != blank -%}
    <div class="gf-satc__price">
      <span class="gf-satc__price-current">{{ price_text }}</span>
      {%- if compare_text != blank -%}
      <span class="gf-satc__price-compare">{{ compare_text }}</span>
      {%- endif -%}
    </div>
    {%- endif -%}

    <!-- Right: CTA -->
    <button class="gf-satc__cta" type="button">
      {{ cta_text }}
    </button>

  </div>
</div>
{%- endunless -%}

<!-- ═══════════════════════════════════════════════════════════════
     JAVASCRIPT — IntersectionObserver + scroll-to-bundle
     ═══════════════════════════════════════════════════════════ -->
<script>
(function () {
  var bar = document.getElementById('gf-satc-{{ sid }}');
  if (!bar) return;
  /* aperçu rupture (?gf_oos=1) : pas de barre, comme en vraie rupture */
  if (/[?&]gf_oos=1(&|$)/.test(window.location.search)) { bar.parentNode.removeChild(bar); return; }

  /* ── Wrapper hors du flux flex : la barre est fixed, son wrapper vide dans la
     colonne produit générait un gap de 12px (pas d'overflow:hidden : ne jamais
     risquer de clipper la barre fixed) ── */
  var wrap = bar.closest('[id^="shopify-block-"]');
  if (wrap) { wrap.style.cssText += ';position:absolute!important;width:0!important;height:0!important;min-height:0!important;margin:0!important;padding:0!important;'; }

  /* ── Design mode: always visible for styling ── */
  {% if request.design_mode %}
    bar.classList.add('is-visible');
    return;
  {% endif %}

  var scrolledPast = false;
  var nearFooter   = false;

  function sync() {
    if (scrolledPast && !nearFooter) {
      bar.classList.add('is-visible');
    } else {
      bar.classList.remove('is-visible');
    }
  }

  /* ─────────────────────────────────────────────
     CIBLE UNIVERSELLE — trouve "l'offre" sur N'IMPORTE quel template.
     Cascade : ancre explicite → blocs offre GF (pack/trial/offer) →
     form produit → colonne produit → page. Jamais la barre elle-même.
     ───────────────────────────────────────────── */
  function findOffer(strict) {
    var sels = [
      '[data-gf-scroll-target]',
      '[id^="gfp-"]', '.gfp-w',
      '[id^="gft-"]', '.gft-w',
      '[id^="gfo-"]', '.gfo-root', '.gf-options',
      'form[action*="/cart/add"]',
      'product-form',
      '[id^="ProductInformation"]',
      '.product-details'
    ];
    if (!strict) sels.push('#MainContent');
    for (var i = 0; i < sels.length; i++) {
      var els = document.querySelectorAll(sels[i]);
      for (var j = 0; j < els.length; j++) {
        var el = els[j];
        if (el === bar || bar.contains(el)) continue;               /* jamais la barre */
        if (el.tagName === 'STYLE' || el.tagName === 'SCRIPT') continue;
        if (el.offsetParent === null && el.tagName !== 'BODY') continue; /* caché/replié */
        return el;
      }
    }
    return null;
  }

  /* ─────────────────────────────────────────────
     SHOW — après avoir scrollé sous l'offre
     (fallback : après 600px de scroll si rien trouvé)
     ───────────────────────────────────────────── */
  var trigger = findOffer(true);
  if (trigger) {
    new IntersectionObserver(function (entries) {
      var e = entries[0];
      scrolledPast = !e.isIntersecting && e.boundingClientRect.top < 0;
      sync();
    }, { threshold: 0 }).observe(trigger);
  } else {
    window.addEventListener('scroll', function () {
      scrolledPast = (window.scrollY || document.documentElement.scrollTop || 0) > 600;
      sync();
    }, { passive: true });
  }

  /* ─────────────────────────────────────────────
     HIDE — at the very bottom of the product page
     (guarantee section, footer, or page end)
     ───────────────────────────────────────────── */
  var hideEls = document.querySelectorAll(
    '.gfg-section, .gff-footer-wrapper, footer, #shopify-section-footer'
  );
  if (hideEls.length) {
    var hideObs = new IntersectionObserver(function (entries) {
      nearFooter = entries.some(function (e) { return e.isIntersecting; });
      sync();
    }, { threshold: 0 });
    hideEls.forEach(function (el) { hideObs.observe(el); });
  }

  /* ─────────────────────────────────────────────
     CTA — scroll vers l'offre (cible re-cherchée au clic,
     scroll-margin pour ne pas finir sous le header sticky)
     ───────────────────────────────────────────── */
  var cta = bar.querySelector('.gf-satc__cta');
  if (cta) {
    cta.addEventListener('click', function (evt) {
      evt.preventDefault();
      var target = findOffer(false);
      if (!target) return;
      var head = document.querySelector('header-component, header, .header');
      var off = 12 + (head ? Math.max(0, head.getBoundingClientRect().height) : 80);
      target.style.scrollMarginTop = off + 'px';
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
})();
</script>

{% schema %}
{
  "name": "GF Sticky ATC",
  "tag": "section",
  "class": "gf-satc-section",
  "settings": [
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style de la barre",
      "default": "noir",
      "info": "Style pret a l'emploi, raccord avec la marque. 'Personnalise' utilise la section Couleurs plus bas.",
      "options": [
        { "value": "noir", "label": "Noir mat (CTA teal)" },
        { "value": "vert", "label": "Vert signature" },
        { "value": "glass", "label": "Verre teinte" },
        { "value": "clair", "label": "Clair premium" },
        { "value": "custom", "label": "Personnalise" }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product title",
      "default": "GUMFORCE Creatine Gum"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "J'EN PROFITE"
    },
    {
      "type": "header",
      "content": "Product image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image",
      "info": "Small thumbnail shown on the left. Upload a square or pouch image."
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating value",
      "default": "4.8"
    },
    {
      "type": "image_picker",
      "id": "rating_image",
      "label": "Star image",
      "info": "Upload a star image (e.g. 4.5 or 5 stars). Falls back to ★ if empty."
    },
    {
      "type": "range",
      "id": "rating_image_height",
      "label": "Star image height",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Afficher le prix",
      "info": "Recupere automatiquement le prix du produit.",
      "default": true
    },
    {
      "type": "product",
      "id": "price_product",
      "label": "Produit (source du prix)",
      "info": "Vide = produit de la page. Le prix (et le prix barre si promo) s'affiche tout seul."
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Prix manuel (optionnel)",
      "info": "Laisser vide = prix auto. Remplir force ce texte (ex. 19,90 €)."
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Prix barre manuel (optionnel)",
      "info": "Vide = prix barre auto si le produit est en promo."
    },
    {
      "type": "header",
      "content": "Couleurs (mode Personnalise uniquement)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Bar background",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 92,
      "info": "Lower = more transparent / stronger glass effect."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "Button background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "bar_radius",
      "label": "Bar corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "cta_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "blur_strength",
      "label": "Blur intensity",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20,
      "info": "Higher = stronger frosted glass effect."
    }
