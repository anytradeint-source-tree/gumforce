{%- comment -%}
  Bandeau code promo en haut de page (sous la barre d'annonce) : « -15 % : appuie ici [BLACK15] | ⏱ 11:46:10 ».
  Compte à rebours jusqu'à minuit (heure de Paris), relancé chaque jour.
  Masqué par défaut. Montré par :
  • le test A/B (CSS injecté par Intelligems : .gf-promo{display:flex!important}) ;
  • l'aperçu ?gf_promo=1 (gardé pour la visite, ?gf_promo=0 pour revenir) ;
  • la case « Pour tout le monde » (Réglages du thème › Bandeau code promo).
  Quand le bandeau est visible, la classe html.gf-promo-vis montre aussi les rappels (snippet gf-promo-inline :
  au-dessus du bouton « Ajouter au panier ») et le champ « Code promo » du panier.
  Au toucher d'un élément [data-gf-promo-apply] : il s'enfonce tout de suite (classe is-press), puis « Code BLACK15 appliqué »
  apparaît sans attendre le serveur (html.gf-promo-applied + coche animée) ; le code part au panier en arrière-plan
  (une seule requête /cart/update.js { discount }, dans la file du panier) et est copié. Code refusé ou réseau coupé → retour à l'état de départ.
  Hauteur fixe (pas de saut au clic) ; chiffres du compte à rebours dans des cases de largeur fixe (rien ne bouge).
{%- endcomment -%}
{%- liquid
  assign gp_code = settings.gf_promo_code | strip
  assign gp_ok = false
  if settings.gf_promo_enabled and gp_code != blank
    assign gp_ok = true
  endif
  comment — langue du site hors de la liste → pas de bandeau (vide = toutes les langues)
  endcomment
  assign gp_langs = settings.gf_promo_locales | downcase | remove: ' '
  if gp_ok and gp_langs != blank
    assign gp_langs_l = gp_langs | split: ','
    unless gp_langs_l contains request.locale.iso_code
      assign gp_ok = false
    endunless
  endif
  comment — date de fin passée (date du serveur) → rien ; l'heure exacte est revérifiée en JS (pages en cache)
  endcomment
  assign gp_to = settings.gf_promo_to | strip
  if gp_ok and gp_to != blank
    assign gp_to_d = gp_to | slice: 0, 10 | remove: '-' | plus: 0
    assign gp_now_d = 'now' | date: '%Y%m%d' | plus: 0
    if gp_to_d > 0 and gp_now_d > gp_to_d
      assign gp_ok = false
    endif
  endif
  assign gp_code_e = gp_code | escape
  assign gp_code_b = gp_code_e | prepend: '<b>' | append: '</b>'
  assign gp_text = settings.gf_promo_text | escape | replace: '[code]', gp_code_b
  assign gp_applied = settings.gf_promo_applied | escape | replace: '[code]', gp_code_b
-%}
{%- if gp_ok -%}
<div class="gf-promo{% if settings.gf_promo_all %} gf-promo--all{% endif %}" data-gf-promo data-gf-promo-apply data-code="{{ gp_code_e }}" data-pct="{{ settings.gf_promo_pct | default: 0 }}" data-from="{{ settings.gf_promo_from | strip | escape }}" data-to="{{ gp_to | escape }}" role="button" tabindex="0">
  <span class="gf-promo__t gfpr-go">{{ gp_text }}</span>
  <span class="gf-promo__t gfpr-ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>{{ gp_applied }}</span>
  {%- if settings.gf_promo_timer -%}
    <span class="gf-promo__sep" aria-hidden="true"></span>
    <span class="gf-promo__c"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9.5 2.5h5"/></svg><span class="gf-promo__time" data-gf-promo-time></span></span>
  {%- endif -%}
</div>
<style>
  .gf-promo { --gfpr-lime:#C5FE89; display:none; box-sizing:border-box; height:46px; align-items:center; justify-content:center; gap:14px; padding:0 16px; background:#111; color:#fff; font-family:var(--font-heading--family, 'Oswald', sans-serif); font-weight:700; font-size:16px; line-height:1; letter-spacing:.03em; text-transform:uppercase; white-space:nowrap; cursor:pointer; overflow:hidden; -webkit-tap-highlight-color:transparent; touch-action:manipulation; user-select:none; -webkit-user-select:none; transition:background-color .15s; }
  .gf-promo--all, html.gf-promo-on .gf-promo { display:flex; }
  /* page à en-tête transparent posé sur la 1re section (accueil) : le bandeau se pose sur la vidéo, juste sous l'en-tête, sans prendre de place.
     Dans le flux, il poussait la vidéo de sa hauteur (le thème ne la remonte que de la hauteur de l'en-tête) : bande vide en haut de page et bandeau caché sous la vidéo. */
  body:has(.header[transparent]) .gf-promo { position:absolute; top:var(--header-group-height, 0px); left:0; right:0; z-index:3; }
  html.gf-promo-off .gf-promo { display:none !important; }
  .gf-promo b { font-weight:700; color:var(--gfpr-lime); }
  .gf-promo__t { display:inline-flex; align-items:center; }
  /* code à toucher : encadré en pointillés ; après le clic, texte « Code … appliqué » (même hauteur de bande) */
  .gfpr-go b { display:inline-flex; align-items:center; height:28px; box-sizing:border-box; margin-left:7px; padding:1px 10px 0; border:1.5px dashed var(--gfpr-lime); border-radius:6px; transition:transform .12s cubic-bezier(.2,.8,.2,1), background-color .12s, color .12s; }
  .gfpr-ok { display:none; }
  .gfpr-ok svg { display:inline-block; width:15px; height:15px; margin-right:7px; vertical-align:-1px; color:var(--gfpr-lime); }
  html.gf-promo-applied .gfpr-go { display:none; }
  /* inline-block (pas flex : les espaces autour du code resteraient collés) ; bloc pour que l'animation puisse le déplacer */
  html.gf-promo-applied .gfpr-ok { display:inline-block; }
  /* doigt posé : la bande s'éclaircit, le code se remplit de vert et s'enfonce */
  .gf-promo.is-press { background:#262626; }
  .gf-promo.is-press .gfpr-go b { transform:scale(.92); background:var(--gfpr-lime); color:#111; }
  /* code appliqué : le texte monte, la coche apparaît en rebondissant */
  @keyframes gfprIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
  @keyframes gfprCheck { 0% { transform:scale(0); } 55% { transform:scale(1.45); } 100% { transform:scale(1); } }
  html.gf-promo-pop .gfpr-ok { animation:gfprIn .3s cubic-bezier(.2,.8,.2,1) both; }
  html.gf-promo-pop .gfpr-ok svg, html.gf-promo-pop .gfpi__ok svg { animation:gfprCheck .45s cubic-bezier(.2,.8,.2,1) .06s both; }
  @media (prefers-reduced-motion:reduce) { html.gf-promo-pop .gfpr-ok, html.gf-promo-pop .gfpr-ok svg, html.gf-promo-pop .gfpi__ok svg { animation:none; } }
  .gf-promo__sep { width:1px; height:16px; flex-shrink:0; background:rgba(255,255,255,.25); }
  .gf-promo__c { display:inline-flex; align-items:center; gap:6px; color:var(--gfpr-lime); font-size:18px; }
  .gf-promo__c svg { width:16px; height:16px; flex-shrink:0; }
  /* chiffres dans des cases de largeur fixe : la bande ne bouge pas quand le temps change */
  .gf-promo__time { display:inline-flex; }
  .gf-promo__time i { font-style:normal; display:inline-block; text-align:center; width:.6em; }
  .gf-promo__time i.s { width:.32em; }
  @media (max-width:389px) { .gf-promo { height:44px; gap:10px; font-size:14.5px; padding:0 10px; } .gf-promo__c { gap:4px; font-size:16px; } .gfpr-go b { height:26px; margin-left:6px; } }
  @media (max-width:339px) { .gf-promo { height:40px; gap:8px; font-size:13px; } .gf-promo__c { font-size:14px; } .gfpr-go b { height:24px; padding:1px 7px 0; } }
  @media (min-width:750px) { .gf-promo { gap:18px; font-size:17px; padding:0 24px; } .gf-promo__c { font-size:19px; } }
</style>
<script>
  (function () {
    var el = document.querySelector('[data-gf-promo]'), html = document.documentElement;
    if (!el) return;
    var code = el.getAttribute('data-code');
    /* aperçu : ?gf_promo=1 (gardé pour la visite), ?gf_promo=0 pour revenir */
    try {
      var m = location.search.match(/[?&]gf_promo=([01])/);
      if (m) sessionStorage.setItem('gf_promo', m[1]);
      if (sessionStorage.getItem('gf_promo') === '1') html.classList.add('gf-promo-on');
      if (sessionStorage.getItem('gf_promo_applied') === code) html.classList.add('gf-promo-applied');
    } catch (e) {}
    /* heure de Paris (le compte à rebours et les dates suivent Paris, quel que soit le pays du visiteur) */
    function paris() {
      var p = {};
      new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' })
        .formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
      return p;
    }
    function stamp(s) { return (s || '').replace(/[^0-9]/g, '').slice(0, 12); }
    function inWindow(p) {
      var now = p.year + p.month + p.day + p.hour + p.minute, from = stamp(el.getAttribute('data-from')), to = stamp(el.getAttribute('data-to'));
      if (from.length === 8) from += '0000';
      if (to.length === 8) to += '2359';
      return (!from || now >= from) && (!to || now <= to);
    }
    var t = el.querySelector('[data-gf-promo-time]'), cells = null;
    function tick() {
      var p = paris();
      if (!inWindow(p)) { html.classList.add('gf-promo-off'); html.classList.remove('gf-promo-vis'); return; }
      /* bandeau visible (test, aperçu ou pour tout le monde) → rappels visibles aussi */
      html.classList.toggle('gf-promo-vis', getComputedStyle(el).display !== 'none');
      if (!t) return;
      var left = 86400 - (+p.hour * 3600 + +p.minute * 60 + +p.second);
      var str = [Math.floor(left / 3600), Math.floor(left % 3600 / 60), left % 60].map(function (n) { return n < 10 ? '0' + n : '' + n; }).join(':');
      if (!cells) {
        t.innerHTML = str.split('').map(function (c) { return c === ':' ? '<i class="s">:</i>' : '<i></i>'; }).join('');
        cells = t.querySelectorAll('i');
      }
      for (var i = 0; i < str.length; i++) if (cells[i].textContent !== str[i]) cells[i].textContent = str[i];
    }
    tick(); setInterval(tick, 1000);
    /* Appui : retour visuel dès que le doigt touche (avant le clic), gardé au moins 120 ms pour qu'un tap rapide se voie */
    function pressOff(b) {
      var left = 120 - (Date.now() - (b.__gfpr || 0));
      setTimeout(function () { b.classList.remove('is-press'); }, left > 0 ? left : 0);
    }
    document.addEventListener('pointerdown', function (e) {
      var b = e.target.closest && e.target.closest('[data-gf-promo-apply]');
      if (!b || (e.button && e.button !== 0)) return;
      b.__gfpr = Date.now();
      b.classList.add('is-press');
    }, { passive: true });
    ['pointerup', 'pointercancel'].forEach(function (ev) {
      document.addEventListener(ev, function () {
        Array.prototype.forEach.call(document.querySelectorAll('[data-gf-promo-apply].is-press'), pressOff);
      }, { passive: true, capture: true });
    });
    /* coche animée : elle joue d'elle-même quand « appliqué » apparaît ; déjà appliqué → relancée à l'image suivante
       (pas de recalcul forcé de la page, qui retarderait le retour visuel) */
    var popT;
    function pop(again) {
      clearTimeout(popT);
      function on() { html.classList.add('gf-promo-pop'); popT = setTimeout(function () { html.classList.remove('gf-promo-pop'); }, 700); }
      if (again && html.classList.contains('gf-promo-pop')) { html.classList.remove('gf-promo-pop'); requestAnimationFrame(function () { requestAnimationFrame(on); }); }
      else on();
    }
    function setApplied(on) {
      html.classList.toggle('gf-promo-applied', on);
      try { if (on) sessionStorage.setItem('gf_promo_applied', code); else sessionStorage.removeItem('gf_promo_applied'); } catch (e) {}
    }
    /* code bien au panier : accepté, ou en attente si le panier est vide (Shopify l'applique dès le 1er article) */
    function hasCode(cart) {
      return ((cart && cart.discount_codes) || []).some(function (d) {
        return (d.code || '').toLowerCase() === code.toLowerCase() && (d.applicable || !cart.item_count);
      });
    }
    /* Tap : « appliqué » tout de suite, le serveur confirme derrière (≈ 0,7 s) ; refus ou réseau coupé → on revient */
    function apply() {
      if (html.classList.contains('gf-promo-applied')) { pop(true); return; }
      setApplied(true);
      pop();
      try { if (navigator.vibrate) navigator.vibrate(12); } catch (e) {}
      try { if (navigator.clipboard) navigator.clipboard.writeText(code).catch(function () {}); } catch (e) {}
      var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      var req = window.gfCart && typeof gfCart.discount === 'function'
        ? gfCart.discount(code)
        : fetch(root + 'cart/update.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ discount: code }) })
            .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
      req.then(function (cart) { if (!hasCode(cart)) setApplied(false); }, function () { setApplied(false); });
    }
    /* écouteur en capture sur window, posé avant les scripts tiers (pixels, suivi) : notre réaction passe en premier */
    window.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('[data-gf-promo-apply]')) { e.preventDefault(); apply(); }
    }, true);
    el.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); apply(); } });
    /* « appliqué » gardé de la visite mais le panier n'a plus le code (commande passée, code retiré ailleurs) → on revient */
    if (html.classList.contains('gf-promo-applied')) {
      setTimeout(function () {
        fetch(((window.Shopify && Shopify.routes && Shopify.routes.root) || '/') + 'cart.js', { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (cart) { if (!hasCode(cart)) setApplied(false); }).catch(function () {});
      }, 1500);
    }
  })();
</script>
{%- endif -%}
