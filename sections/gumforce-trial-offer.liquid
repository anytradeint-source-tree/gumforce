          <span>{{ s.perk3 }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- if s.show_timer -%}
      <div class="gft-tm">
        <div class="gft-tl">{{ s.timer_label }}</div>
        <div class="gft-td">
          <div class="gft-tb">
            <div class="gft-tn" data-gft-h="{{ gf_id }}">{{ s.timer_hours | default: 2 | prepend: '00' | slice: -2, 2 }}</div>
