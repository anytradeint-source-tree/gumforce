{%- comment -%}
  Rappel du code promo (Réglages du thème › Bandeau code promo), montré seulement quand le bandeau du haut est visible
  (classe html.gf-promo-vis posée par gf-promo-bar : test A/B, aperçu ?gf_promo=1 ou « pour tout le monde »).
  where: 'cta'  → barre au-dessus du bouton « Ajouter au panier » (bloc d'offre)
  Un appui applique le code (logique dans gf-promo-bar : bouton enfoncé au toucher, « Code … appliqué » tout de suite,
  serveur en arrière-plan) ; ensuite « Code … appliqué » (classe html.gf-promo-applied).
{%- endcomment -%}
{%- liquid
  assign gpi_code = settings.gf_promo_code | strip
  if settings.gf_promo_enabled and gpi_code != blank
    assign gpi_code_b = gpi_code | escape | prepend: '<b>' | append: '</b>'
    assign gpi_go = settings.gf_promo_cta_text | escape | replace: '[code]', gpi_code_b
    assign gpi_ok = settings.gf_promo_applied | escape | replace: '[code]', gpi_code_b
  endif
-%}
{%- if gpi_go != blank -%}
<button type="button" class="gfpi gfpi--cta" data-gf-promo-apply>
  <span class="gfpi__go">{{ gpi_go }}</span>
  <span class="gfpi__ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>{{ gpi_ok }}</span>
</button>
<style>
  /* « html » en tête : passe devant les styles génériques des boutons (panier, thème) */
  html .gfpi { --gfpr-lime:#C5FE89; display:none; align-items:center; justify-content:center; box-sizing:border-box; border:0; margin:0; cursor:pointer; font-family:var(--font-heading--family, 'Oswald', sans-serif); font-weight:700; line-height:1; letter-spacing:.03em; text-transform:uppercase; white-space:nowrap; -webkit-tap-highlight-color:transparent; touch-action:manipulation; user-select:none; -webkit-user-select:none; }
  html.gf-promo-vis .gfpi { display:flex; }
  .gfpi b { font-weight:700; color:var(--gfpr-lime); }
  .gfpi__go { display:inline-flex; align-items:center; }
  .gfpi__go b { display:inline-flex; align-items:center; box-sizing:border-box; border:1.5px dashed var(--gfpr-lime); border-radius:6px; transition:transform .12s cubic-bezier(.2,.8,.2,1), background-color .12s, color .12s; }
  .gfpi__ok { display:none; }
  .gfpi__ok svg { width:14px; height:14px; vertical-align:-1px; color:var(--gfpr-lime); }
  html.gf-promo-applied .gfpi__go { display:none; }
  /* inline-block (pas flex : les espaces autour du code resteraient collés) */
  html.gf-promo-applied .gfpi__ok { display:inline-block; }
  /* doigt posé : le bouton s'enfonce, le code se remplit de vert (coche animée : gf-promo-bar) */
  html .gfpi { transition:transform .12s cubic-bezier(.2,.8,.2,1), background-color .15s; }
  html .gfpi.is-press { transform:scale(.97); background:#262626; }
  .gfpi.is-press .gfpi__go b { transform:scale(.92); background:var(--gfpr-lime); color:#111; }
  @keyframes gfpiIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
  html.gf-promo-pop .gfpi__ok { animation:gfpiIn .3s cubic-bezier(.2,.8,.2,1) both; }
  @media (prefers-reduced-motion:reduce) { html.gf-promo-pop .gfpi__ok { animation:none; } }
  /* au-dessus du bouton d'achat : même bande noire que le haut de page */
  html .gfpi--cta { width:100%; height:46px; margin-top:12px; padding:0 14px; border-radius:16px; background:#111; color:#fff; font-size:16px; }
  .gfpi--cta .gfpi__go b { height:28px; margin-left:7px; padding:1px 10px 0; }
  @media (max-width:389px) { html .gfpi--cta { font-size:14.5px; height:44px; } .gfpi--cta .gfpi__go b { height:26px; } }
  /* le bloc d'offre remet marges et paddings à zéro (#gfp-… *) et le thème met les svg en bloc : on garde nos valeurs */
  html .gfpi--cta { margin:12px 0 0 !important; padding:0 14px !important; }
  html .gfpi--cta .gfpi__go b { margin-left:7px !important; padding:1px 10px 0 !important; }
  html .gfpi__ok svg { display:inline-block !important; margin:0 6px 0 0 !important; padding:0 !important; }
</style>
{%- endif -%}
