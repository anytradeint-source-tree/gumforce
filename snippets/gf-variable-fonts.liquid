{% comment %}
  GF — polices variables auto-hébergées (assets/gf-*-var-*.woff2, Google Fonts,
  licence OFL). UN fichier par famille couvre toutes les graisses (200→800) :
  plus aucun swap tardif quand une graisse non préchargée arrive, 2 requêtes
  au lieu de 8. Sous-ensemble latin-ext téléchargé seulement si un glyphe
  l'exige (unicode-range). Familles isolées « GF … » : voir gf-font-face.liquid.
  Préchargement : snippets/fonts.liquid.
{% endcomment %}
@font-face { font-family: "GF Manrope"; font-style: normal; font-weight: 200 800; font-display: swap; src: url("{{ 'gf-manrope-var-latin.woff2' | asset_url }}") format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
@font-face { font-family: "GF Manrope"; font-style: normal; font-weight: 200 800; font-display: swap; src: url("{{ 'gf-manrope-var-latin-ext.woff2' | asset_url }}") format("woff2"); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
@font-face { font-family: "GF Oswald"; font-style: normal; font-weight: 200 700; font-display: swap; src: url("{{ 'gf-oswald-var-latin.woff2' | asset_url }}") format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
@font-face { font-family: "GF Oswald"; font-style: normal; font-weight: 200 700; font-display: swap; src: url("{{ 'gf-oswald-var-latin-ext.woff2' | asset_url }}") format("woff2"); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
