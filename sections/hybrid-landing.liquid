<style>
  .shopify-section-group-header-group,
  #shopify-section-header,
  #header,
  header.header,
  .header-wrapper,
  .section-header {
    display: none !important;
  }
</style>

<div class="hl" id="hybrid-landing">

  <section class="hl-hero">
    <div class="hl-wrap">
      <h1 class="hl-hero__h">{{ section.settings.hero_headline }}</h1>
      <p class="hl-hero__sub"><em>{{ section.settings.hero_subhead }}</em></p>
      {%- if section.settings.hero_image != blank -%}
        {%- assign hero_img = section.settings.hero_image -%}
        <div class="hl-hero__img">
          <img
            src="{{ hero_img | image_url: width: 1200 }}"
            srcset="
              {{ hero_img | image_url: width: 375 }} 375w,
              {{ hero_img | image_url: width: 720 }} 720w,
              {{ hero_img | image_url: width: 960 }} 960w,
              {{ hero_img | image_url: width: 1200 }} 1200w
            "
            sizes="(max-width: 768px) calc(100vw - 48px), 640px"
            alt="{{ section.settings.hero_image_alt | escape }}"
            width="{{ hero_img.width }}"
            height="{{ hero_img.height }}"
          >
        </div>
      {%- endif -%}
    </div>
  </section>

  <section class="hl-story">
    <div class="hl-wrap">
      <div class="hl-story__text">
        {{ section.settings.story_opener }}
      </div>
    </div>
  </section>

  {%- if section.settings.pivot_line != blank -%}
    <section class="hl-pivot">
      <div class="hl-wrap">
        <p class="hl-pivot__text">{{ section.settings.pivot_line }}</p>
      </div>
    </section>
  {%- endif -%}

  {%- assign item_idx = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'listicle_item' -%}
      {%- assign item_idx = item_idx | plus: 1 -%}
      {%- assign is_even = item_idx | modulo: 2 -%}
      <section
        class="hl-item{% if is_even == 0 %} hl-item--alt{% endif %}"
        id="hl-item-{{ item_idx }}"
        {{ block.shopify_attributes }}
      >
        <div class="hl-wrap">
          <span class="hl-item__num" aria-hidden="true">{{ block.settings.item_number }}</span>
          <h2 class="hl-item__h">{{ block.settings.item_headline }}</h2>
          {%- if block.settings.item_image != blank -%}
            {%- assign img = block.settings.item_image -%}
            <div class="hl-item__img">
              <img
                src="{{ img | image_url: width: 960 }}"
                srcset="
                  {{ img | image_url: width: 375 }} 375w,
                  {{ img | image_url: width: 720 }} 720w,
                  {{ img | image_url: width: 960 }} 960w,
                  {{ img | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 768px) calc(100vw - 48px), 672px"
                alt="{{ block.settings.item_image_alt | escape }}"
                width="{{ img.width }}"
                height="{{ img.height }}"
                {% if item_idx > 1 %}loading="lazy"{% endif %}
              >
            </div>
          {%- endif -%}
          <div class="hl-item__body">
            {{ block.settings.item_body }}
          </div>
        </div>
      </section>

    {%- elsif block.type == 'image' -%}
      <section class="hl-image" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {%- if block.settings.full_width -%}
            <img
              src="{{ block.settings.image | image_url: width: 1600 }}"
              srcset="
                {{ block.settings.image | image_url: width: 375 }} 375w,
                {{ block.settings.image | image_url: width: 768 }} 768w,
                {{ block.settings.image | image_url: width: 1200 }} 1200w,
                {{ block.settings.image | image_url: width: 1600 }} 1600w
              "
              sizes="100vw"
              alt="{{ block.settings.image_alt | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="hl-wrap">
              <img
                src="{{ block.settings.image | image_url: width: 1200 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 375 }} 375w,
                  {{ block.settings.image | image_url: width: 720 }} 720w,
                  {{ block.settings.image | image_url: width: 960 }} 960w,
                  {{ block.settings.image | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 768px) calc(100vw - 48px), 672px"
                alt="{{ block.settings.image_alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}
        {%- endif -%}
      </section>
    {%- endif -%}
  {%- endfor -%}

  <section class="hl-cta" id="hl-cta-primary">
    <div class="hl-wrap">
      <a class="hl-btn" href="{{ section.settings.cta_url }}">
        {{ section.settings.cta_text }}
      </a>
      <div class="hl-guarantee">
        {{ section.settings.guarantee_text }}
      </div>
    </div>
  </section>

  <section class="hl-testimonials">
    <div class="hl-wrap">
      {%- if section.settings.testimonials_heading != blank -%}
        <h2 class="hl-testimonials__h">{{ section.settings.testimonials_heading }}</h2>
      {%- endif -%}
      <div class="hl-testimonials__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            <blockquote class="hl-quote" {{ block.shopify_attributes }}>
              <div class="hl-quote__text">{{ block.settings.quote }}</div>
              {%- if block.settings.avatar != blank -%}
                <div class="hl-quote__img">
                  <img
                    src="{{ block.settings.avatar | image_url: width: 720 }}"
                    srcset="
                      {{ block.settings.avatar | image_url: width: 375 }} 375w,
                      {{ block.settings.avatar | image_url: width: 720 }} 720w
                    "
                    sizes="(max-width: 768px) calc(100vw - 48px), 320px"
                    alt="{{ block.settings.name | escape }}"
                    width="{{ block.settings.avatar.width }}"
                    height="{{ block.settings.avatar.height }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
              <footer class="hl-quote__attr">
                <cite class="hl-quote__name">{{ block.settings.name }}</cite>
                {%- if block.settings.age != blank -%}
                  <span class="hl-quote__age">, {{ block.settings.age }}</span>
                {%- endif -%}
                {%- if block.settings.verified -%}
                  <span class="hl-quote__badge" aria-label="Verified buyer">&#10003; Verified</span>
                {%- endif -%}
              </footer>
            </blockquote>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="hl-closer">
    <div class="hl-wrap">
      <div class="hl-closer__text">
        {{ section.settings.closer_paragraph }}
      </div>
      <a class="hl-btn" href="{{ section.settings.cta_url }}">
        {{ section.settings.cta_text }}
      </a>
    </div>
  </section>

</div>

{% stylesheet %}
.hl *,
.hl *::before,
.hl *::after {
  box-sizing: border-box;
}

.hl {
  background: #0A0A0A;
  color: #F5F5F5;
  font-weight: 400;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.hl-wrap {
  max-width: 720px;
  margin: 0 auto;
  padding: 0 24px;
}

.hl-hero {
  padding: clamp(72px, 14vw, 152px) 0 clamp(32px, 5vw, 48px);
}

.hl-hero__h {
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(28px, 5.5vw, 52px);
  font-weight: 900;
  line-height: 1.06;
  letter-spacing: -0.035em;
  margin: 0 0 20px;
}

.hl-hero__sub {
  font-size: clamp(16px, 2.2vw, 20px);
  font-weight: 400;
  line-height: 1.5;
  opacity: 0.6;
  margin: 0;
}

.hl-hero__img {
  margin-top: clamp(32px, 5vw, 48px);
}

.hl-hero__img img {
  display: block;
  width: 100%;
  height: auto;
}

.hl-story {
  background: #0A0A0A;
  padding: clamp(40px, 7vw, 72px) 0;
}

.hl-story__text {
  max-width: 640px;
  margin: 0 auto;
}

.hl-story__text p {
  font-size: clamp(15px, 2vw, 17px);
  line-height: 1.72;
  margin: 0 0 22px;
}

.hl-story__text p:last-child {
  margin-bottom: 0;
}

.hl-story__text p:has(> em:only-child) {
  font-size: clamp(18px, 2.8vw, 22px);
  line-height: 1.55;
  text-align: center;
  margin-top: clamp(36px, 6vw, 56px);
  margin-bottom: clamp(36px, 6vw, 56px);
  opacity: 0.9;
  padding: 0 clamp(8px, 3vw, 32px);
}

.hl-pivot {
  background: #0A0A0A;
  padding: clamp(40px, 7vw, 64px) 0;
  border-top: 1px solid rgba(0, 191, 201, 0.3);
}

.hl-pivot__text {
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(18px, 3vw, 24px);
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: -0.02em;
  margin: 0;
  text-align: center;
}

.hl-item {
  background: #0A0A0A;
  padding: clamp(48px, 9vw, 88px) 0;
}

.hl-item--alt {
  background: #141414;
}

.hl-item__num {
  display: block;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(64px, 12vw, 140px);
  font-weight: 900;
  line-height: 0.85;
  letter-spacing: -0.06em;
  color: #00BFC9;
  margin-left: -3px;
  margin-bottom: clamp(12px, 2vw, 20px);
}

.hl-item__h {
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(22px, 4vw, 36px);
  font-weight: 800;
  line-height: 1.12;
  letter-spacing: -0.025em;
  margin: 0 0 clamp(24px, 4vw, 36px);
}

.hl-item__img {
  margin: 0 0 clamp(24px, 4vw, 36px);
}

.hl-item__img img {
  display: block;
  width: 100%;
  height: auto;
}

.hl-item__body {
  font-size: clamp(15px, 2vw, 17px);
  line-height: 1.72;
}

.hl-item__body p {
  margin: 0 0 20px;
}

.hl-item__body p:last-child {
  margin-bottom: 0;
}

.hl-item__body ul {
  list-style: none;
  padding: 0;
  margin: 0 0 24px;
}

.hl-item__body li {
  position: relative;
  padding-left: 24px;
  margin-bottom: 16px;
}

.hl-item__body li:last-child {
  margin-bottom: 0;
}

.hl-item__body li::before {
  content: '\2014';
  position: absolute;
  left: 0;
  color: #00BFC9;
}

.hl-image {
  background: #0A0A0A;
}

.hl-image img {
  display: block;
  width: 100%;
  height: auto;
}

.hl-cta {
  background: #0A0A0A;
  padding: clamp(48px, 9vw, 88px) 0;
  text-align: center;
}

.hl-btn {
  display: inline-block;
  background: #00BFC9;
  color: #0A0A0A;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(14px, 2vw, 16px);
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 20px clamp(36px, 6vw, 56px);
  transition: background 0.2s ease, transform 0.15s ease;
}

.hl-btn:hover {
  background: #2dd1d9;
  transform: translateY(-2px);
}

.hl-btn:active {
  transform: translateY(0);
}

.hl-guarantee {
  max-width: 560px;
  margin: clamp(32px, 5vw, 48px) auto 0;
  text-align: left;
}

.hl-guarantee p {
  font-size: clamp(13px, 1.8vw, 15px);
  line-height: 1.72;
  opacity: 0.6;
  margin: 0 0 14px;
}

.hl-guarantee p:last-child {
  margin-bottom: 0;
}

.hl-testimonials {
  background: #141414;
  padding: clamp(48px, 9vw, 88px) 0;
}

.hl-testimonials__h {
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 3.5vw, 32px);
  font-weight: 800;
  letter-spacing: -0.02em;
  margin: 0 0 clamp(36px, 6vw, 56px);
}

.hl-testimonials__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(32px, 5vw, 48px);
}

.hl-quote {
  margin: 0;
  padding: 0 0 0 20px;
  border-left: 2px solid rgba(0, 191, 201, 0.25);
}

.hl-quote__text {
  font-size: clamp(14px, 1.9vw, 16px);
  line-height: 1.72;
}

.hl-quote__text p {
  margin: 0;
  opacity: 0.85;
}

.hl-quote__img {
  margin-bottom: 20px;
}

.hl-quote__img img {
  display: block;
  width: 100%;
  height: auto;
}

.hl-quote__attr {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0;
  margin-top: 16px;
  font-size: 14px;
}

.hl-quote__name {
  font-weight: 700;
  font-style: normal;
}

.hl-quote__age {
  font-weight: 400;
  opacity: 0.6;
}

.hl-quote__badge {
  margin-left: 10px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #00BFC9;
}

.hl-closer {
  background: #0A0A0A;
  padding: clamp(48px, 9vw, 88px) 0;
  text-align: center;
}

.hl-closer__text {
  max-width: 600px;
  margin: 0 auto clamp(36px, 5vw, 52px);
  text-align: left;
}

.hl-closer__text p {
  font-size: clamp(15px, 2vw, 17px);
  line-height: 1.72;
  margin: 0 0 20px;
}

.hl-closer__text p:last-child {
  margin-bottom: 0;
}

@media (min-width: 769px) {
  .hl-testimonials__grid {
    grid-template-columns: 1fr 1fr;
  }

  .hl-item__num {
    margin-left: -8px;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  document.querySelectorAll('#hybrid-landing a[href^="#"]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Hybrid Landing",
  "tag": "section",
  "class": "hybrid-landing-section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "inline_richtext",
      "id": "hero_headline",
      "label": "Headline",
      "default": "My sister roasted me at Sunday lunch. 8 weeks later I went from 0 Tinder matches to 3 dates in 30 days."
    },
    {
      "type": "text",
      "id": "hero_subhead",
      "label": "Subhead",
      "default": "I'm 30. Here's the part of the story I didn't write the first time around — and the four things I worked out in the months after."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text"
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "richtext",
      "id": "story_opener",
      "label": "Story opener",
      "default": "<p>Sunday lunch at my parents'. Four of us at the table, plates, normal chat. My sister — 22, had been on her phone for half the meal — finally puts it down, looks at me across the table, and goes, completely flat:</p><p><em>\"You should try that mewing thing. It would honestly fix your whole face.\"</em></p><p>My mom kept eating. My dad kept eating. She went back to her phone. I sat there with my fork halfway up.</p><p>I told her to fuck off in front of my parents. Finished my food. Drove home. Did not think about it. Did not think about it for four days.</p><p>But the thing she said sat at the back of my head like a tab I'd minimized. I'd be in the middle of work and it would come back. Sitting in my car at the gym, it'd come back. Brushing my teeth on Friday night it came back, and I happened to be looking at the bathroom mirror, and I caught my own side profile at the wrong angle.</p><p>I set the toothbrush down. Turned my head fully sideways. The actual side profile, not the 3/4 angle you take for photos.</p><p><em>There was just nothing.</em></p><p>Smooth slope from my ear to my chin. No edge. No jaw.</p><p>I sat down on the side of the tub for a couple minutes.</p><p>8 years in the gym. €500 a year on Tinder. 40 bio rewrites. New photos, new outfits, new lighting. And my 22-year-old sister had seen it in five seconds at the dinner table, and I'd been looking past it in the mirror for a decade.</p><p>That weekend I went down the worst kind of Reddit rabbit hole. The kind where you keep clicking, can't sleep, and around 3am you accept something you didn't want to accept.</p><p>I spent the four months after that bathroom mirror moment working out what had actually gone wrong.</p>"
    },
    {
      "type": "text",
      "id": "pivot_line",
      "label": "Pivot line",
      "default": "Four things. Here they are in the order I should've figured them out."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "CHECK AVAILABILITY"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Guarantee"
    },
    {
      "type": "richtext",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "<p>90-day guarantee. Chew it for 90 days. If your face hasn't visibly changed and you're not getting more matches, send back what's left of the pouch, full refund, no return shipping.</p><p>No subscription trap. No \"results in 30 days or it's your fault.\" 90 days, your jaw, your call.</p>"
    },
    {
      "type": "header",
      "content": "Testimonials"
    },
    {
      "type": "text",
      "id": "testimonials_heading",
      "label": "Section heading",
      "default": "What other guys figured out"
    },
    {
      "type": "header",
      "content": "Closer"
    },
    {
      "type": "richtext",
      "id": "closer_paragraph",
      "label": "Closing text",
      "default": "<p>One last thing.</p><p>If you're under 35 and you've burned money on Gold, Platinum, Boosts, photos, bio rewrites, and the gym, and nothing's worked — this is the thing nobody on the dating subs will tell you.</p><p>They all just say \"go to the gym bro.\"</p><p>I went to the gym for 8 years.</p><p>It didn't fix my face.</p><p>Train the jaw. Same way you train everything else.</p>"
    }
  ],
  "blocks": [
    {
      "type": "listicle_item",
      "name": "Listicle item",
      "settings": [
        {
          "type": "text",
          "id": "item_number",
          "label": "Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "item_headline",
          "label": "Headline",
          "default": "Item headline"
        },
        {
          "type": "richtext",
          "id": "item_body",
          "label": "Body",
          "default": "<p>Item body text.</p>"
        },
        {
          "type": "image_picker",
          "id": "item_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "item_image_alt",
          "label": "Image alt text"
        }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>Customer quote.</p>"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "age",
          "label": "Age"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt text"
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "Full width (edge to edge)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Hybrid Landing"
    }
  ]
}
{% endschema %}
