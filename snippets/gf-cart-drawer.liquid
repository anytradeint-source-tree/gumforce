{%- comment -%}
  GUMFORCE — contenu du panier coulissant (Réglages du thème › Panier GUMFORCE).
  Rendu dans le <dialog> du cart-drawer-component d'Horizon (header-actions) :
  Horizon garde l'ouverture / fermeture, le verrouillage du scroll, le retour
  arrière mobile et le re-rendu (morph) à chaque événement cart:update.

  • Articles compacts : vignette, nom court (avant « - »), options, prix barré,
    stepper − n + (− devient corbeille à 1).
  • Upsell : un produit (handle en réglage), sélecteur − 1 + (plafond par
    personne) et bouton « Ajouter · prix ». Une fois ajouté, il devient une
    ligne du panier (après les autres articles, même plafond) et la carte
    disparaît ; elle revient s'il est retiré. Carte photo (image d'ambiance en
    fond) ou compacte (vignette). Carte masquée sans autre article au panier.
  • Upsell seulement : si l'offre GUMFORCE est retirée, la pastèque part avec
    (réglage « Seulement avec une offre GUMFORCE » ; voir aussi gf-upsell-guard).
  • Pied : lignes Réductions (prix barrés + remises) et Livraison « Gratuite »
    (dès que les articles hors upsell atteignent le seuil réglé, comme la règle
    Shopify), Total, bouton Commander → et boutons de paiement rapide.
  • Total, réductions, livraison et prix des lignes recalculés au tap (centimes
    en data-*), puis remplacés par la réponse du serveur.
  • Tout est rendu même panier vide (masqué) : le bloc d'offre peut ouvrir le
    panier AVANT la réponse du serveur (rendu optimiste), puis la réponse
    /cart/update.js (avec sections) remplace par la vérité serveur.
  • JS : window.gfCart (setMain pour le bloc d'offre) + délégation des clics,
    une seule file de requêtes, re-rendu seulement quand plus rien n'est en
    attente (pas de retour en arrière visuel pendant les taps rapides).
{%- endcomment -%}
{%- liquid
  assign gfc_title     = settings.gfc_title | default: 'Ton panier'
  assign gfc_empty     = settings.gfc_empty_text | default: 'Ton panier est vide.'
  assign gfc_empty_cta = settings.gfc_empty_cta | default: 'Découvrir GUMFORCE'
  assign gfc_empty_url = settings.empty_cart_button_link | default: routes.all_products_collection_url
  assign gfc_total_lbl = settings.gfc_total_label | default: 'Total'
  assign gfc_cta       = settings.gfc_cta | default: 'Commander'
  assign gfc_disc_lbl  = settings.gfc_discount_label | strip
  assign gfc_ship_lbl  = settings.gfc_shipping_label | strip
  assign gfc_ship_free = settings.gfc_shipping_free | strip

  comment — devise du visiteur ≠ devise boutique → total avec code ISO (comme le bloc d'offre)
  endcomment
  assign gfc_cc = false
  assign gfc_loc = localization.country.currency.iso_code | default: cart.currency.iso_code
  if gfc_loc != shop.currency
    assign gfc_cc = true
  endif

  comment — UPSELL : produit introuvable (pas sur la boutique en ligne), épuisé ou case décochée → rien
  endcomment
  assign up_on = false
  assign up_handle = settings.gfc_up_handle | strip
  if settings.gfc_up_enabled and up_handle != blank
    assign up_p = all_products[up_handle]
    if up_p != blank
      assign up_v = up_p.selected_or_first_available_variant
      if up_v != blank and up_v.available
        assign up_on = true
      endif
    endif
  endif
  assign up_max = settings.gfc_up_max | default: 4
  assign up_qty = 0
  assign has_main = false
  for item in cart.items
    if up_on and item.variant_id == up_v.id
      assign up_qty = up_qty | plus: item.quantity
    else
      assign has_main = true
    endif
  endfor
  assign show_up = false
  if up_on and has_main and up_qty == 0
    assign show_up = true
  endif

  comment — économie totale = prix barrés (compare_at) + remises Shopify
  endcomment
  assign gfc_save = cart.original_total_price | minus: cart.total_price
  for item in cart.items
    if item.variant.compare_at_price > item.original_price
      assign gfc_d = item.variant.compare_at_price | minus: item.original_price | times: item.quantity
      assign gfc_save = gfc_save | plus: gfc_d
    endif
  endfor
  if gfc_cc
    assign gfc_save_money = gfc_save | money_with_currency
  else
    assign gfc_save_money = gfc_save | money
  endif

  if up_on
    assign up_short = up_p.title | split: ' - ' | first | strip
    assign up_name = settings.gfc_up_name | default: up_short
    assign up_img = settings.gfc_up_image | default: up_v.image | default: up_p.featured_image
    comment — photo de fond : réglage, sinon 2e photo du produit upsell, sinon carte compacte
    endcomment
    assign up_bg = settings.gfc_up_bg
    unless up_bg
      if up_p.images.size > 1
        assign up_bg = up_p.images[1]
      endif
    endunless
    assign up_focus = settings.gfc_up_bg_focus | default: 75
    comment — prix de l'offre : prix et prix barré Shopify (13,50 € barré 29,99 €).
      Sans prix barré, le réglage « Remise de l'offre upsell » (0 % par défaut)
      calcule un prix remisé, pour le cas d'une réduction Shopify au panier.
    endcomment
    assign up_off = settings.gfc_up_discount | default: 0
    assign up_unit = up_v.price
    assign up_was = up_v.price
    if up_v.compare_at_price > up_v.price
      assign up_was = up_v.compare_at_price
    elsif up_off > 0
      assign up_keep = 100 | minus: up_off
      assign up_unit = up_v.price | times: up_keep | divided_by: 100.0 | round
    endif
    assign up_line_img = up_v.image | default: up_p.featured_image
    assign up_price_money = up_unit | money
    assign up_add_tpl = settings.gfc_up_add_text | default: 'Ajouter · [prix]'
    assign up_pct = ''
    if up_was > up_unit
      assign up_pct = up_was | minus: up_unit | times: 100.0 | divided_by: up_was | round | prepend: '-' | append: '%'
    endif
    assign up_max_s = up_max | append: ''
    assign up_badge = settings.gfc_up_badge | replace: '[remise]', up_pct | strip
    assign up_sub = settings.gfc_up_sub | replace: '[max]', up_max_s | strip
    assign up_head = settings.gfc_up_heading
  endif

  comment — livraison gratuite : articles hors upsell ≥ seuil (même règle que les
    tarifs Shopify, où la pastèque ne compte pas). Devise étrangère : pas de ligne.
  endcomment
  assign gfc_ship_min = 0
  if gfc_cc == false and gfc_ship_lbl != blank and gfc_ship_free != blank
    assign gfc_ship_min = settings.gfc_ship_free_min | default: 0 | times: 100
  endif
  assign gfc_ship_base = 0
  for item in cart.items
    if up_on and item.variant_id == up_v.id
      continue
    endif
    assign gfc_ship_base = gfc_ship_base | plus: item.final_line_price
  endfor
  assign gfc_ship_ok = false
  if gfc_ship_min > 0 and gfc_ship_base >= gfc_ship_min
    assign gfc_ship_ok = true
  endif

  assign gfc_count = cart.item_count
-%}
<script src="{{ 'component-cart-items.js' | asset_url }}" type="module" fetchpriority="low"></script>
<style>
  .gfc-dialog { background:#fff; color:#111; }
  .gfc, .gfc *, .gfc *::before, .gfc *::after { box-sizing:border-box; }
  .gfc {
    --gfc-ink:#111111; --gfc-muted:#6b6b6b; --gfc-faint:#a1a1aa; --gfc-line:#e7e7ea; --gfc-hair:rgba(0,0,0,.06);
    --gfc-accent:#2AB5B4; --gfc-accent-soft:rgba(42,181,180,.07); --gfc-accent-ring:rgba(42,181,180,.10); --gfc-green:#16A34A;
    --gfc-font:var(--font-body--family, 'Manrope', sans-serif); --gfc-head:var(--font-heading--family, 'Oswald', sans-serif);
    display:flex; flex-direction:column; height:100%; min-height:0; width:100%;
    font-family:var(--gfc-font); color:var(--gfc-ink); background:#fff; -webkit-font-smoothing:antialiased;
  }
  .gfc p { margin:0; }
  .gfc button { font-family:inherit; -webkit-tap-highlight-color:transparent; }
  .gfc [hidden] { display:none !important; }

  /* en-tête */
  .gfc__head { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 8px 12px 16px; border-bottom:1px solid var(--gfc-hair); flex-shrink:0; }
  .gfc__title { margin:0; font-family:var(--gfc-head); font-size:20px; font-weight:700; line-height:1.2; text-transform:uppercase; letter-spacing:.02em; color:var(--gfc-ink); }
  .gfc__count { color:var(--gfc-muted); font-weight:500; }
  .gfc__close { width:44px; height:44px; display:flex; align-items:center; justify-content:center; border:none; background:none; color:var(--gfc-ink); cursor:pointer; padding:0; border-radius:50%; }
  .gfc__close svg { width:20px; height:20px; }

  /* corps défilant */
  .gfc__body { flex:1; min-height:0; overflow-y:auto; overscroll-behavior:contain; -webkit-overflow-scrolling:touch; padding:0 16px 20px; }
  .gfc__lines { list-style:none; margin:0; padding:0; }

  /* article */
  .gfc-line { display:flex; gap:12px; padding:12px 0; border-bottom:1px solid var(--gfc-hair); transition:opacity .2s ease; }
  .gfc-line:last-child { border-bottom:none; }
  .gfc-line.is-gone { opacity:.35; pointer-events:none; }
  .gfc-line__img { width:64px; height:64px; flex-shrink:0; border-radius:12px; background:#f4f4f5; overflow:hidden; display:block; }
  .gfc-line__img img { width:100%; height:100%; object-fit:contain; display:block; }
  /* texte à gauche ; prix puis sélecteur empilés à droite (ligne plus basse) */
  .gfc-line__main { flex:1; min-width:0; display:grid; grid-template-columns:minmax(0,1fr) auto; grid-template-areas:"txt price" "txt qty"; column-gap:10px; row-gap:6px; align-items:start; }
  .gfc-line__top { display:contents; }
  .gfc-line__txt { grid-area:txt; }
  .gfc-line__price { grid-area:price; }
  .gfc-line__main > .gfc-qty { grid-area:qty; justify-self:end; }
  .gfc-line__txt { min-width:0; }
  .gfc-line__name { font-family:var(--gfc-head); font-size:15px; font-weight:700; line-height:1.2; text-transform:uppercase; letter-spacing:.02em; }
  .gfc-line__opt { margin-top:2px !important; font-size:12.5px; font-weight:500; line-height:1.35; color:var(--gfc-muted); }
  .gfc-line__prop { margin-top:2px !important; font-size:12px; line-height:1.35; color:var(--gfc-muted); }
  .gfc-line__disc { margin-top:2px !important; font-size:12px; font-weight:700; line-height:1.35; color:var(--gfc-green); }
  .gfc-line__price { display:flex; flex-direction:column; align-items:flex-end; flex-shrink:0; white-space:nowrap; line-height:1.2; }
  .gfc-line__price b { font-size:15px; font-weight:800; letter-spacing:-.01em; }
  .gfc-line__price s { font-size:12px; font-weight:500; color:var(--gfc-faint); margin-top:2px; }
  .gfc-line.is-ghost .gfc-line__name, .gfc-line.is-ghost .gfc-line__opt { min-height:12px; border-radius:6px; background:#f0f0f1; }
  .gfc-line.is-ghost .gfc-line__name { width:110px; }
  .gfc-line.is-ghost .gfc-line__opt { width:160px; }

  /* stepper (même recette que la quantité du bloc d'offre) */
  .gfc-qty { display:inline-flex; align-items:center; align-self:flex-start; border:1.5px solid var(--gfc-line); border-radius:30px; background:#fff; overflow:hidden; flex-shrink:0; }
  .gfc-qty button { width:34px; height:32px; border:none; background:transparent; color:var(--gfc-ink); cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0; }
  .gfc-qty button:disabled { color:#d4d4d8; cursor:not-allowed; }
  .gfc-qty button svg { width:14px; height:14px; }
  .gfc-qty span { min-width:22px; text-align:center; font-size:13.5px; font-weight:700; font-variant-numeric:tabular-nums; }
  .gfc-qty .gfc-ic-trash { display:none; }
  .gfc-line.is-one .gfc-ic-minus { display:none; }
  .gfc-line.is-one .gfc-ic-trash { display:block; }

  /* upsell : carte compacte (vignette) par défaut, carte photo avec .gfc-up--photo */
  .gfc-up { margin-top:14px; --gfc-lime:#C5FE89; }
  .gfc-up__card { position:relative; display:flex; flex-direction:column; gap:10px; padding:14px; border:1.5px solid var(--gfc-line); border-radius:16px; background:#fff; transition:border-color .16s ease, background .16s ease, box-shadow .16s ease; }
  .gfc-up__top { display:flex; align-items:center; justify-content:space-between; gap:8px; }
  .gfc-up__top:empty { display:none; }
  .gfc-up__badge { font-size:10px; font-weight:800; color:#fff; background:var(--gfc-accent); padding:3px 10px; border-radius:100px; letter-spacing:.04em; white-space:nowrap; text-transform:uppercase; line-height:1.3; }
  .gfc-up:not(.gfc-up--photo) .gfc-up__badge { position:absolute; top:-9px; left:14px; z-index:2; box-shadow:0 3px 8px rgba(42,181,180,.35); }
  .gfc-up:not(.gfc-up--photo) .gfc-up__card--badge { margin-top:24px; padding-top:18px; }
  .gfc-up__tw { margin-left:auto; }
  /* carte compacte : badge et compteur posés sur le bord haut, pas de ligne à part */
  .gfc-up:not(.gfc-up--photo) .gfc-up__top { display:contents; }
  .gfc-up:not(.gfc-up--photo) .gfc-up__tw { position:absolute; top:-11px; right:14px; z-index:2; padding:2px 8px; border-radius:8px; background:#fff; border:1.5px solid var(--gfc-line); }
  .gfc-up__timer { display:flex; align-items:center; gap:5px; font-size:12px; font-weight:600; line-height:1.3; color:var(--gfc-muted); white-space:nowrap; }
  .gfc-up__timer svg { width:13px; height:13px; flex-shrink:0; color:var(--gfc-accent); }
  .gfc-up__timer b { color:var(--gfc-ink); font-weight:800; font-variant-numeric:tabular-nums; }
  .gfc-up__main { display:flex; align-items:center; gap:12px; }
  .gfc-up__img { width:56px; height:56px; flex-shrink:0; border-radius:12px; overflow:hidden; }
  .gfc-up__img img { width:100%; height:100%; object-fit:contain; display:block; }
  .gfc-up__txt { min-width:0; }
  .gfc-up__title { font-family:var(--gfc-head); font-size:17px; font-weight:700; line-height:1.15; text-transform:uppercase; letter-spacing:.02em; text-wrap:balance; }
  .gfc-up__title em { font-style:normal; color:var(--gfc-accent); }
  .gfc-up__sub { margin-top:3px !important; font-size:12px; font-weight:500; line-height:1.35; color:var(--gfc-muted); }
  .gfc-up__price { margin-top:6px !important; display:flex; align-items:baseline; gap:6px; white-space:nowrap; line-height:1.2; }
  .gfc-up__price b { font-size:18px; font-weight:800; letter-spacing:-.01em; }
  .gfc-up__price s { font-size:12.5px; font-weight:500; color:var(--gfc-faint); }
  .gfc-up__act { display:flex; align-items:center; gap:8px; }
  .gfc-up__act .gfc-qty { align-self:auto; }
  .gfc-up__act .gfc-qty button { width:38px; height:40px; }
  .gfc-up__act .gfc-qty span { min-width:20px; font-size:15px; }
  .gfc-up__add { flex:1; min-width:0; height:43px; padding:0 14px; border:none; border-radius:30px; background:var(--gfc-ink); color:#fff; font-family:var(--gfc-font); font-size:15px; font-weight:700; letter-spacing:.01em; white-space:nowrap; cursor:pointer; box-shadow:0 1px 3px rgba(0,0,0,.1); transition:transform .12s ease; }
  .gfc-up__add:active { transform:scale(.97); }

  /* carte photo : l'image d'ambiance remplit la carte, le texte se lit sur un voile en bas */
  .gfc-up--photo .gfc-up__card { min-height:236px; padding:12px 14px 14px; border:none; background:#0d4a4a; color:#fff; overflow:hidden; box-shadow:0 10px 28px rgba(0,0,0,.14); }
  .gfc-up__bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .gfc-up--photo .gfc-up__card::after { content:''; position:absolute; inset:0; pointer-events:none; background:linear-gradient(180deg, rgba(0,0,0,.30) 0%, rgba(0,0,0,0) 22%, rgba(0,0,0,0) 34%, rgba(0,0,0,.6) 60%, rgba(0,0,0,.86) 100%); }
  .gfc-up--photo .gfc-up__top, .gfc-up--photo .gfc-up__main, .gfc-up--photo .gfc-up__act { position:relative; z-index:1; }
  .gfc-up--photo .gfc-up__badge { background:var(--gfc-lime); color:#111; font-size:10.5px; }
  .gfc-up--photo .gfc-up__timer { padding:4px 9px; border-radius:8px; background:rgba(17,17,17,.74); color:#fff; }
  .gfc-up--photo .gfc-up__timer svg { color:var(--gfc-lime); }
  .gfc-up--photo .gfc-up__timer b { color:#fff; }
  .gfc-up--photo .gfc-up__main { margin-top:auto; }
  .gfc-up--photo .gfc-up__title { font-size:23px; line-height:1.08; color:#fff; text-shadow:0 1px 14px rgba(0,0,0,.35); }
  .gfc-up--photo .gfc-up__title em { color:var(--gfc-lime); }
  .gfc-up--photo .gfc-up__sub { color:rgba(255,255,255,.88); }
  .gfc-up--photo .gfc-up__price b { font-size:20px; color:#fff; }
  .gfc-up--photo .gfc-up__price s { color:rgba(255,255,255,.66); }
  .gfc-up--photo .gfc-qty { background:rgba(255,255,255,.14); border-color:rgba(255,255,255,.62); }
  .gfc-up--photo .gfc-qty button { color:#fff; }
  .gfc-up--photo .gfc-qty button:disabled { color:rgba(255,255,255,.35); }
  .gfc-up--photo .gfc-qty span { color:#fff; }
  .gfc-up--photo .gfc-up__add { background:var(--gfc-lime); color:#111; }

  /* pied fixe */
  .gfc__foot { flex-shrink:0; padding:10px 16px calc(12px + env(safe-area-inset-bottom)); border-top:1px solid var(--gfc-hair); background:#fff; }
  .gfc-sum { display:flex; flex-direction:column; gap:4px; }
  .gfc-sum__row { display:flex; align-items:baseline; justify-content:space-between; gap:12px; font-size:13.5px; font-weight:500; line-height:1.3; color:var(--gfc-muted); }
  .gfc-sum__row b { font-weight:700; color:var(--gfc-green); font-variant-numeric:tabular-nums; }
  .gfc-tot { display:flex; align-items:baseline; justify-content:space-between; gap:12px; }
  .gfc-sum:has(.gfc-sum__row:not([hidden])) .gfc-tot { margin-top:2px; padding-top:6px; border-top:1px solid var(--gfc-hair); }
  .gfc-tot__lbl { font-size:15px; font-weight:800; }
  .gfc-tot__amt { font-size:20px; font-weight:800; letter-spacing:-.01em; font-variant-numeric:tabular-nums; }
  .gfc--cc.is-busy .gfc-tot__amt, .gfc--cc.is-busy .gfc-sum__row b, .gfc.is-busy.is-approx .gfc-tot__amt, .gfc.is-busy.is-approx .gfc-sum__row b { animation:gfc-shim .8s ease-in-out infinite alternate; }
  @keyframes gfc-shim { from { opacity:1; } to { opacity:.35; } }
  .gfc-go-form { margin:10px 0 0; }
  .gfc-go { width:100%; padding:14px; border:none; border-radius:30px; background:var(--gfc-ink); color:#fff; font-family:var(--gfc-font); font-size:16px; font-weight:700; line-height:1.3; letter-spacing:.01em; cursor:pointer; display:flex; flex-direction:column; align-items:center; gap:3px; text-align:center; text-decoration:none; box-shadow:0 1px 3px rgba(0,0,0,.1); -webkit-appearance:none; appearance:none; }
  .gfc-go__main { display:inline-flex; align-items:center; justify-content:center; gap:8px; }
  .gfc-go__arrow { width:18px; height:18px; flex-shrink:0; transition:transform .2s ease; }
  .gfc-go:hover .gfc-go__arrow { transform:translateX(3px); }
  /* paiement rapide (Apple Pay, Google Pay, Shop Pay… selon Paramètres › Paiements) */
  .gfc-express { margin-top:8px; }
  .gfc-express shopify-accelerated-checkout-cart {
    --shopify-accelerated-checkout-button-block-size:42px;
    --shopify-accelerated-checkout-button-border-radius:30px;
    --shopify-accelerated-checkout-inline-alignment:center;
    --shopify-accelerated-checkout-row-gap:8px;
  }
  .gfc-go.is-loading { opacity:.8; pointer-events:none; }
  .gfc-go.is-loading .gfc-go__main::before { content:''; width:14px; height:14px; margin-right:9px; flex-shrink:0; border:2px solid rgba(255,255,255,.35); border-top-color:#fff; border-radius:50%; animation:gfc-rot .7s linear infinite; }
  @keyframes gfc-rot { to { transform:rotate(360deg); } }

  /* panier vide */
  .gfc__empty { padding:48px 8px 24px; text-align:center; }
  .gfc__empty-txt { font-size:15px; font-weight:500; color:var(--gfc-muted); }
  .gfc__empty .gfc-go { display:inline-flex; width:auto; margin-top:18px; padding:15px 32px; }

  /* écrans bas : la carte photo se resserre pour garder les boutons au-dessus du pied */
  @media (max-height:620px) {
    .gfc-up--photo .gfc-up__card { min-height:214px; }
    .gfc-line { padding:10px 0; }
  }
  /* petits écrans (iPhone SE 1re génération) */
  @media (max-width:374px) {
    .gfc__title { font-size:18px; }
    .gfc__body { padding:0 12px 16px; }
    .gfc__foot { padding-left:12px; padding-right:12px; }
    .gfc-up__card { padding:12px; }
    .gfc-up__act { gap:6px; }
    .gfc-up__act .gfc-qty button { width:32px; }
    .gfc-up__add { padding:0 10px; font-size:14px; }
    .gfc-up__price b, .gfc-up--photo .gfc-up__price b { font-size:17px; }
    .gfc-up--photo .gfc-up__title { font-size:21px; }
    .gfc-go { padding:14px 12px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .gfc-tot__amt, .gfc-sum__row b { animation:none !important; }
  }
</style>

<div class="gfc{% if gfc_cc %} gfc--cc{% endif %}" id="gfc" data-gfc data-total="{{ cart.total_price }}" data-save="{{ gfc_save }}" data-fmt="{{ shop.money_format | strip_html | escape }}" data-ship-min="{{ gfc_ship_min }}" data-up-only="{% if settings.gfc_up_only_with %}1{% endif %}">
  <div class="gfc__head">
    <h2 class="gfc__title" id="gfc-title">{{ gfc_title | escape }} <span class="gfc__count" data-gfc-count{% if gfc_count == 0 %} hidden{% endif %}>({{ gfc_count }})</span></h2>
    <button type="button" ref="closeButton" on:click="cart-drawer-component/close" class="gfc__close" aria-label="{{ 'actions.close_dialog' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="gfc__body">
    <div class="gfc__empty" data-gfc-empty{% unless cart.empty? %} hidden{% endunless %}>
      <p class="gfc__empty-txt">{{ gfc_empty | escape }}</p>
      <a class="gfc-go" href="{{ gfc_empty_url }}">{{ gfc_empty_cta | escape }}</a>
    </div>

    <ul class="gfc__lines" data-gfc-lines>
      {%- for pass in (1..2) -%}
      {%- for item in cart.items -%}
        {%- liquid
          assign l_up = false
          if up_on and item.variant_id == up_v.id
            assign l_up = true
          endif
        -%}
        {%- if pass == 1 and l_up -%}{%- continue -%}{%- endif -%}
        {%- if pass == 2 and l_up == false -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign l_name = item.product.title | split: ' - ' | first | strip
          assign l_opts = ''
          unless item.product.has_only_default_variant
            for o in item.options_with_values
              if l_opts != ''
                assign l_opts = l_opts | append: ' · '
              endif
              assign l_opts = l_opts | append: o.value
            endfor
          endunless
          assign l_was = 0
          if item.variant.compare_at_price > item.original_price
            assign l_was = item.variant.compare_at_price | times: item.quantity
          elsif item.original_line_price > item.final_line_price
            assign l_was = item.original_line_price
          endif
          assign l_unit_was = item.original_price
          if item.variant.compare_at_price > l_unit_was
            assign l_unit_was = item.variant.compare_at_price
          endif
          assign l_max = 0
          if l_up
            assign l_max = up_max
          endif
        -%}
        <li class="gfc-line{% if item.quantity == 1 %} is-one{% endif %}" data-gfc-line data-key="{{ item.key }}" data-vid="{{ item.variant_id }}" data-qty="{{ item.quantity }}" data-max="{{ l_max }}" data-unit="{{ item.final_price }}" data-unit-was="{{ l_unit_was }}">
          <a class="gfc-line__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
            {%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="" width="64" height="64" loading="lazy">{%- endif -%}
          </a>
          <div class="gfc-line__main">
            <div class="gfc-line__top">
              <div class="gfc-line__txt">
                <p class="gfc-line__name">{{ l_name | escape }}</p>
                {%- if l_opts != blank -%}<p class="gfc-line__opt">{{ l_opts | escape }}</p>{%- endif -%}
                {%- for p in item.properties -%}
                  {%- assign p_first = p.first | slice: 0 -%}
                  {%- if p.last != blank and p_first != '_' -%}<p class="gfc-line__prop">{{ p.first | escape }} : {{ p.last | escape }}</p>{%- endif -%}
                {%- endfor -%}
                {%- unless l_up -%}
                  {%- for a in item.line_level_discount_allocations -%}
                    <p class="gfc-line__disc">{{ a.discount_application.title | escape }} (-{{ a.amount | money }})</p>
                  {%- endfor -%}
                {%- endunless -%}
              </div>
              <p class="gfc-line__price"><b>{{ item.final_line_price | money }}</b>{% if l_was > item.final_line_price %}<s>{{ l_was | money }}</s>{% endif %}</p>
            </div>
            <div class="gfc-qty">
              <button type="button" data-gfc-dec aria-label="{{ 'accessibility.decrease_quantity' | t }}">
                <svg class="gfc-ic-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>
                <svg class="gfc-ic-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>
              </button>
              <span data-gfc-n>{{ item.quantity }}</span>
              <button type="button" data-gfc-inc aria-label="{{ 'accessibility.increase_quantity' | t }}"{% if l_max > 0 and item.quantity >= l_max %} disabled{% endif %}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </button>
            </div>
          </div>
        </li>
      {%- endfor -%}
      {%- endfor -%}
    </ul>

    {%- if up_on -%}
      <div class="gfc-up{% if up_bg %} gfc-up--photo{% endif %}" data-gfc-up data-vid="{{ up_v.id }}" data-max="{{ up_max }}" data-pick="1" data-price="{{ up_unit }}" data-was="{{ up_was }}" data-name="{{ up_short | escape }}" data-img="{% if up_line_img %}{{ up_line_img | image_url: width: 160 }}{% endif %}"{% unless show_up %} hidden{% endunless %}>
        <div class="gfc-up__card{% if up_badge != blank %} gfc-up__card--badge{% endif %}">
          {%- if up_bg -%}
            <img class="gfc-up__bg" src="{{ up_bg | image_url: width: 800 }}" srcset="{{ up_bg | image_url: width: 600 }} 600w, {{ up_bg | image_url: width: 800 }} 800w, {{ up_bg | image_url: width: 1000 }} 1000w" sizes="(min-width: 750px) 370px, calc(100vw - 32px)" alt="" width="800" height="800" loading="lazy" style="object-position:50% {{ up_focus }}%">
          {%- endif -%}
          <div class="gfc-up__top">
            {%- if up_badge != blank -%}<span class="gfc-up__badge">{{ up_badge | escape }}</span>{%- endif -%}
            {%- if settings.gfc_up_timer and settings.gfc_up_timer_text != blank -%}
              <div class="gfc-up__tw" data-skip-subtree-update><p class="gfc-up__timer" data-gfc-timer data-min="{{ settings.gfc_up_timer_min | default: 10 }}" data-tpl="{{ settings.gfc_up_timer_text | escape }}" hidden></p></div>
            {%- endif -%}
          </div>
          <div class="gfc-up__main">
            {%- unless up_bg -%}{%- if up_img -%}<div class="gfc-up__img"><img src="{{ up_img | image_url: width: 160 }}" alt="" width="56" height="56" loading="lazy"></div>{%- endif -%}{%- endunless -%}
            <div class="gfc-up__txt">
              <p class="gfc-up__title">{% if up_head != blank %}{{ up_head }}{% else %}{{ up_name | escape }}{% endif %}</p>
              {%- if up_sub != blank -%}<p class="gfc-up__sub">{{ up_sub | escape }}</p>{%- endif -%}
              <p class="gfc-up__price"><b>{{ up_price_money }}</b>{% if up_was > up_unit %}<s>{{ up_was | money }}</s>{% endif %}</p>
            </div>
          </div>
          <div class="gfc-up__act">
            <div class="gfc-qty" role="group" aria-label="{{ 'accessibility.quantity' | t }} : {{ up_name | escape }}">
              <button type="button" data-gfc-pick="-1" aria-label="{{ 'accessibility.decrease_quantity' | t }}" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>
              </button>
              <span data-gfc-pick-n>1</span>
              <button type="button" data-gfc-pick="1" aria-label="{{ 'accessibility.increase_quantity' | t }}"{% if up_max <= 1 %} disabled{% endif %}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </button>
            </div>
            <button type="button" class="gfc-up__add" data-gfc-up-add><span data-gfc-up-label data-tpl="{{ up_add_tpl | escape }}">{{ up_add_tpl | escape | replace: '[prix]', up_price_money }}</span></button>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="gfc__foot" data-gfc-foot{% if cart.empty? %} hidden{% endif %}>
    <div class="gfc-sum">
      {%- if gfc_disc_lbl != blank -%}
        <p class="gfc-sum__row" data-gfc-save{% if gfc_save <= 0 %} hidden{% endif %}><span>{{ gfc_disc_lbl | escape }}</span><b data-gfc-save-v>-{{ gfc_save_money }}</b></p>
      {%- endif -%}
      {%- if gfc_ship_lbl != blank and gfc_ship_free != blank -%}
        <p class="gfc-sum__row" data-gfc-ship{% unless gfc_ship_ok %} hidden{% endunless %}><span>{{ gfc_ship_lbl | escape }}</span><b>{{ gfc_ship_free | escape }}</b></p>
      {%- endif -%}
      <p class="gfc-tot">
        <span class="gfc-tot__lbl">{{ gfc_total_lbl | escape }}</span>
        <span class="gfc-tot__amt" data-gfc-total>{% if gfc_cc %}{{ cart.total_price | money_with_currency }}{% else %}{{ cart.total_price | money }}{% endif %}</span>
      </p>
    </div>
    <form class="gfc-go-form" action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="gfc-go" data-gfc-go>
        <span class="gfc-go__main">{{ gfc_cta | escape }}<svg class="gfc-go__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </button>
    </form>
    {%- if settings.gfc_express and additional_checkout_buttons -%}
      <div class="gfc-express">{{ content_for_additional_checkout_buttons }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} Gabarit d'article pour l'ouverture instantanée (rendu optimiste) {%- endcomment -%}
  <template data-gfc-tpl>
    <li class="gfc-line is-one" data-gfc-line data-key="" data-vid="" data-qty="1" data-max="0">
      <span class="gfc-line__img"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" width="64" height="64"></span>
      <div class="gfc-line__main">
        <div class="gfc-line__top">
          <div class="gfc-line__txt"><p class="gfc-line__name"></p><p class="gfc-line__opt"></p></div>
          <p class="gfc-line__price"><b></b><s></s></p>
        </div>
        <div class="gfc-qty">
          <button type="button" data-gfc-dec aria-label="{{ 'accessibility.decrease_quantity' | t }}"><svg class="gfc-ic-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg><svg class="gfc-ic-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg></button>
          <span data-gfc-n>1</span>
          <button type="button" data-gfc-inc aria-label="{{ 'accessibility.increase_quantity' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
        </div>
      </div>
    </li>
  </template>

  {%- comment -%} Données des variantes de la page produit, pour dessiner l'article avant la réponse du serveur {%- endcomment -%}
  <script type="application/json" data-gfc-data>
    {
    {%- if product != blank -%}
      {%- assign d_name = product.title | split: ' - ' | first | strip -%}
      {%- for v in product.variants -%}
        {%- liquid
          assign d_img = v.image | default: product.featured_image
          assign d_opt = ''
          unless product.has_only_default_variant
            assign d_opt = v.options | join: ' · '
          endunless
          assign d_was = ''
          assign d_was_c = v.price
          if v.compare_at_price > v.price
            assign d_was = v.compare_at_price | money
            assign d_was_c = v.compare_at_price
          endif
        -%}
        "{{ v.id }}": { "name": {{ d_name | json }}, "opt": {{ d_opt | json }}, "img": {% if d_img %}{{ d_img | image_url: width: 160 | json }}{% else %}""{% endif %}, "price": {{ v.price | money | json }}, "was": {{ d_was | json }}, "cents": {{ v.price }}, "was_cents": {{ d_was_c }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
    }
  </script>
</div>

<script>
  (function () {
    if (window.gfCart) return;
    var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var chain = Promise.resolve();
    var pending = 0;   /* requêtes envoyées sans réponse */
    var waiting = {};  /* taps en attente d'envoi (anti-rebond), par contrôle */
    var opening = false; /* ouverture demandée par le bloc d'offre, pas encore effective */
    var DEBOUNCE = 250;

    function q(sel, el) { return (el || document).querySelector(sel); }
    function qa(sel, el) { return Array.prototype.slice.call((el || document).querySelectorAll(sel)); }
    function root() { return q('[data-gfc]'); }
    function drawer() { return q('cart-drawer-component'); }
    function sectionId() { var c = q('cart-items-component[data-drawer]'); return c ? c.getAttribute('data-section-id') : ''; }
    function idle() { return pending === 0 && Object.keys(waiting).length === 0; }
    function setBusy() { var r = root(); if (r) r.classList.toggle('is-busy', !idle()); }
    function defined(name, ms) {
      if (customElements.get(name)) return Promise.resolve(true);
      return Promise.race([
        customElements.whenDefined(name).then(function () { return true; }),
        new Promise(function (res) { setTimeout(function () { res(!!customElements.get(name)); }, ms); })
      ]);
    }

    function open() {
      var d = drawer();
      if (!d) return Promise.resolve(false);
      return defined('cart-drawer-component', 4000).then(function (ok) {
        if (ok && typeof d.open === 'function') d.open();
        return ok;
      });
    }

    /* ── Rendu serveur : même événement que les formulaires d'Horizon (cart:update
       + sections) → cart-items-component fait le morph, l'icône du header suit. ── */
    function render(cart) {
      var sid = sectionId();
      var html = cart && cart.sections && sid ? cart.sections[sid] : null;
      return defined('cart-items-component', 3000).then(function (ok) {
        if (ok) {
          /* panier fermé entre-temps (ou retour du checkout) : Horizon le
             rouvrirait (auto-open) à chaque cart:update → mise à jour silencieuse */
          var d = drawer(), dlg = d && q('dialog', d);
          var quiet = !!(d && dlg && !dlg.open && !opening && d.hasAttribute('auto-open'));
          var sections = cart.sections || {};
          if (quiet) {
            d.removeAttribute('auto-open');
            if (html) { sections = {}; sections[sid] = html.replace(/(<cart-drawer-component\b[^>]*?)\sauto-open\b/, '$1'); }
          }
          document.dispatchEvent(new CustomEvent('cart:update', {
            bubbles: true,
            detail: { resource: cart, sourceId: 'gf-cart', data: { source: 'gf-cart', itemCount: cart.item_count, sections: sections } }
          }));
          if (quiet) d.setAttribute('auto-open', '');
        } else if (html) {
          var fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-gfc]');
          var cur = root();
          if (fresh && cur) cur.replaceWith(fresh);
        }
        setBusy();
        tick();
        warm();
      });
    }

    function post(path, body) {
      var sid = sectionId();
      if (sid) { body.sections = sid; body.sections_url = window.location.pathname; }
      return fetch(ROOT + path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(body)
      }).then(function (res) {
        return res.json().then(function (data) {
          if (!res.ok) throw new Error(data.description || data.message || res.status);
          return data;
        });
      });
    }

    /* File unique : les requêtes partent l'une après l'autre ; seule la dernière
       réponse (plus rien en attente) redessine le panier. */
    function request(path, body) {
      pending++;
      setBusy();
      var p = chain.then(function () { return post(path, body); });
      chain = p.catch(function () {});
      return p.then(function (cart) {
        pending--;
        if (idle()) return render(cart).then(function () { return cart; });
        return cart;
      }, function (err) {
        pending--;
        if (idle()) refresh();
        throw err;
      });
    }
    function refresh() { return post('cart/update.js', { updates: {} }).then(render).catch(function () {}); }

    function schedule(key, fn) {
      if (waiting[key]) clearTimeout(waiting[key].t);
      waiting[key] = { fn: fn, t: setTimeout(function () { fire(key); }, DEBOUNCE) };
      setBusy();
    }
    function fire(key) {
      var w = waiting[key];
      if (!w) return;
      clearTimeout(w.t);
      delete waiting[key];
      w.fn().catch(function () {});
    }
    function flush() {
      Object.keys(waiting).forEach(fire);
      return chain;
    }

    /* Format d'argent de la boutique (« €{{amount_with_comma_separator}} ») pour
       afficher le total recalculé au tap, avant la réponse du serveur. */
    function fmt(c) {
      var r = root(), f = (r && r.getAttribute('data-fmt')) || '{{amount}}';
      var m = f.match(/\{\{\s*(\w+)\s*\}\}/), k = m ? m[1] : 'amount';
      var dec = k.indexOf('no_decimals') > -1 ? 0 : 2, th = ',', ds = '.';
      if (k.indexOf('comma_separator') > -1) { th = '.'; ds = ','; }
      if (k.indexOf('apostrophe') > -1) { th = "'"; ds = '.'; }
      if (k.indexOf('space_separator') > -1) { th = ' '; ds = ','; }
      var parts = (Math.abs(c) / 100).toFixed(dec).split('.');
      parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, th);
      return f.replace(/\{\{\s*\w+\s*\}\}/, (c < 0 ? '-' : '') + parts.join(ds));
    }
    function addMoney(dTotal, dSave) {
      var r = root(); if (!r || r.classList.contains('gfc--cc')) return;
      var t = (parseInt(r.getAttribute('data-total'), 10) || 0) + dTotal;
      var s = (parseInt(r.getAttribute('data-save'), 10) || 0) + dSave;
      r.setAttribute('data-total', t);
      r.setAttribute('data-save', s);
      var te = q('[data-gfc-total]', r); if (te) te.textContent = fmt(t);
      var se = q('[data-gfc-save]', r);
      if (se) { se.hidden = s <= 0; var sv = q('[data-gfc-save-v]', se); if (sv) sv.textContent = '-' + fmt(s); }
      ship();
    }
    /* « Livraison gratuite » : articles hors upsell (pastèque) ≥ seuil, comme Shopify */
    function ship() {
      var r = root(), row = r && q('[data-gfc-ship]', r);
      if (!row) return;
      var min = cents(r, 'data-ship-min');
      if (!min) { row.hidden = true; return; }
      var up = q('[data-gfc-up]', r), upv = up ? up.getAttribute('data-vid') : '', base = 0;
      qa('[data-gfc-line]', r).forEach(function (l) {
        if (l.classList.contains('is-gone') || l.getAttribute('data-vid') === upv) return;
        base += cents(l, 'data-qty') * cents(l, 'data-unit');
      });
      row.hidden = base < min;
    }
    function cents(el, attr) { return parseInt(el.getAttribute(attr), 10) || 0; }

    function updateCount() {
      var r = root(); if (!r) return;
      var n = 0;
      qa('[data-gfc-line]', r).forEach(function (l) { if (!l.classList.contains('is-gone')) n += parseInt(l.getAttribute('data-qty'), 10) || 0; });
      var c = q('[data-gfc-count]', r);
      if (c) { c.textContent = '(' + n + ')'; c.hidden = n === 0; }
    }

    function makeLine(vid, qty, d, max) {
      var r = root(), tpl = q('[data-gfc-tpl]', r);
      var li = tpl.content.firstElementChild.cloneNode(true);
      li.setAttribute('data-vid', vid);
      li.setAttribute('data-key', String(vid));
      li.setAttribute('data-qty', qty);
      li.setAttribute('data-max', max || 0);
      li.classList.toggle('is-one', qty === 1);
      q('[data-gfc-n]', li).textContent = qty;
      var inc = q('[data-gfc-inc]', li); if (inc && max && qty >= max) inc.disabled = true;
      if (!d) { li.classList.add('is-ghost'); r.classList.add('is-approx'); return li; }
      if (d.img) q('img', li).src = d.img;
      q('.gfc-line__name', li).textContent = d.name;
      var opt = q('.gfc-line__opt', li);
      if (d.opt) opt.textContent = d.opt; else opt.remove();
      li.setAttribute('data-unit', d.cents);
      li.setAttribute('data-unit-was', d.was_cents);
      var cc = r.classList.contains('gfc--cc');
      q('.gfc-line__price b', li).textContent = cc ? (qty === 1 ? d.price : '') : fmt(d.cents * qty);
      q('.gfc-line__price s', li).textContent = cc ? (qty === 1 ? d.was : '') : (d.was_cents > d.cents ? fmt(d.was_cents * qty) : '');
      return li;
    }

    /* ── Upsell : sélecteur − 1 + (local), puis « Ajouter » = ligne du panier ── */
    function upPick(card, n) {
      var max = cents(card, 'data-max') || 4;
      n = Math.max(1, Math.min(max, n));
      card.setAttribute('data-pick', n);
      var out = q('[data-gfc-pick-n]', card); if (out) out.textContent = n;
      var dec = q('[data-gfc-pick="-1"]', card); if (dec) dec.disabled = n <= 1;
      var inc = q('[data-gfc-pick="1"]', card); if (inc) inc.disabled = n >= max;
      var lab = q('[data-gfc-up-label]', card);
      if (lab && !root().classList.contains('gfc--cc')) lab.textContent = (lab.getAttribute('data-tpl') || '').replace('[prix]', fmt(cents(card, 'data-price') * n));
    }
    function upAdd(card) {
      var r = root(), list = q('[data-gfc-lines]', r);
      if (!list) return;
      var vid = card.getAttribute('data-vid'), n = cents(card, 'data-pick') || 1;
      var unit = cents(card, 'data-price'), was = cents(card, 'data-was') || unit;
      /* un changement de quantité de cette ligne encore en attente ne doit pas passer après l'ajout */
      qa('[data-gfc-line][data-vid="' + vid + '"]', list).forEach(function (l) {
        cancel('l:' + l.getAttribute('data-key'));
        l.remove();
      });
      var pb = q('.gfc-up__price b', card), ps = q('.gfc-up__price s', card);
      list.appendChild(makeLine(vid, n, {
        img: card.getAttribute('data-img'), name: card.getAttribute('data-name'), opt: '',
        cents: unit, was_cents: was, price: pb ? pb.textContent : '', was: ps ? ps.textContent : ''
      }, cents(card, 'data-max')));
      card.hidden = true;
      addMoney(n * unit, n * Math.max(0, was - unit));
      updateCount();
      var u = {}; u[vid] = n;
      request('cart/update.js', { updates: u }).catch(function () {});
    }

    /* ── Article : − n + (corbeille à 1) ── */
    function lineSet(line, n) {
      var max = parseInt(line.getAttribute('data-max'), 10) || 0;
      if (max && n > max) n = max;
      if (n < 0) n = 0;
      var prev = cents(line, 'data-qty'), unit = cents(line, 'data-unit'), was = cents(line, 'data-unit-was') || unit;
      addMoney((n - prev) * unit, (n - prev) * Math.max(0, was - unit));
      var pb = q('.gfc-line__price b', line), ps = q('.gfc-line__price s', line);
      if (pb && unit && !root().classList.contains('gfc--cc')) {
        pb.textContent = fmt(unit * n);
        if (ps) ps.textContent = was > unit ? fmt(was * n) : '';
      }
      line.setAttribute('data-qty', n);
      line.classList.toggle('is-one', n === 1);
      line.classList.toggle('is-gone', n === 0);
      var out = q('[data-gfc-n]', line); if (out) out.textContent = n;
      var inc = q('[data-gfc-inc]', line); if (inc) inc.disabled = !!max && n >= max;
      var key = line.getAttribute('data-key');
      if (n > 0) {
        schedule('l:' + key, function () { return request('cart/change.js', { id: key, quantity: n }); });
      } else {
        /* retrait : rien à regrouper, la requête part tout de suite ; si c'était la
           dernière offre, la pastèque part dans la même requête */
        cancel('l:' + key);
        var updates = {}; updates[key] = 0;
        afterRemove(line, updates);
        request('cart/update.js', { updates: updates }).catch(function () {});
      }
      updateCount();
    }
    function cancel(k) { if (waiting[k]) { clearTimeout(waiting[k].t); delete waiting[k]; setBusy(); } }

    /* Après un retrait : pastèque retirée → la carte revient (s'il reste une offre) ;
       plus aucune offre → la carte se cache et la pastèque part avec (upsell seulement) ;
       plus rien → panier vide tout de suite. */
    function mains(r, upv) {
      return qa('[data-gfc-line]', r).filter(function (l) { return !l.classList.contains('is-gone') && l.getAttribute('data-vid') !== upv; });
    }
    function afterRemove(line, updates) {
      var r = root(), card = q('[data-gfc-up]', r), upv = card ? card.getAttribute('data-vid') : '';
      if (card) {
        if (line.getAttribute('data-vid') === upv) {
          if (mains(r, upv).length) { upPick(card, 1); card.hidden = false; }
        } else if (!mains(r, upv).length) {
          card.hidden = true;
          var ups = qa('[data-gfc-line][data-vid="' + upv + '"]', r).filter(function (l) { return !l.classList.contains('is-gone'); });
          if (ups.length && r.getAttribute('data-up-only') === '1') {
            ups.forEach(function (l) {
              var k = l.getAttribute('data-key');
              cancel('l:' + k);
              updates[k || upv] = 0;
              var n0 = cents(l, 'data-qty'), u0 = cents(l, 'data-unit'), w0 = cents(l, 'data-unit-was') || u0;
              addMoney(-n0 * u0, -n0 * Math.max(0, w0 - u0));
              l.setAttribute('data-qty', 0);
              l.classList.add('is-gone');
            });
          }
        }
      }
      if (!qa('[data-gfc-line]', r).some(function (l) { return !l.classList.contains('is-gone'); })) {
        var empty = q('[data-gfc-empty]', r); if (empty) empty.hidden = false;
        var foot = q('[data-gfc-foot]', r); if (foot) foot.hidden = true;
        if (card) card.hidden = true;
      }
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      var r = root();
      var b = t.closest('[data-gfc-pick],[data-gfc-up-add],[data-gfc-inc],[data-gfc-dec],[data-gfc-go]');
      if (!b || !r || !r.contains(b) || b.disabled) return;
      if (b.hasAttribute('data-gfc-go')) {
        b.classList.add('is-loading');
        if (!idle()) { e.preventDefault(); flush().then(function () { window.location.href = ROOT + 'checkout'; }); }
        return;
      }
      e.preventDefault();
      var card = b.closest('[data-gfc-up]');
      if (card && b.hasAttribute('data-gfc-pick')) { upPick(card, cents(card, 'data-pick') + cents(b, 'data-gfc-pick')); return; }
      if (card && b.hasAttribute('data-gfc-up-add')) { upAdd(card); return; }
      var line = b.closest('[data-gfc-line]');
      if (!line || !line.getAttribute('data-key')) return;
      var n = parseInt(line.getAttribute('data-qty'), 10) || 0;
      lineSet(line, n + (b.hasAttribute('data-gfc-inc') ? 1 : -1));
    });
    /* retour depuis le checkout (bfcache) : bouton débloqué, panier relu */
    window.addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      qa('[data-gfc-go].is-loading').forEach(function (b) { b.classList.remove('is-loading'); });
      refresh();
    });

    /* ── Rendu optimiste de l'offre choisie : le panier s'ouvre tout de suite ── */
    function data() {
      try { return JSON.parse((q('[data-gfc-data]') || {}).textContent || '{}'); } catch (err) { return {}; }
    }
    function optimistic(vid, qty, family) {
      var r = root(); if (!r) return;
      var list = q('[data-gfc-lines]', r);
      if (!list || !q('[data-gfc-tpl]', r)) return;
      var dT = 0, dS = 0;
      qa('[data-gfc-line]', list).forEach(function (l) {
        var v = parseInt(l.getAttribute('data-vid'), 10);
        if (v === vid || family.indexOf(v) > -1) {
          var n = cents(l, 'data-qty'), u = cents(l, 'data-unit'), w = cents(l, 'data-unit-was') || u;
          dT -= n * u; dS -= n * Math.max(0, w - u);
          l.remove();
        }
      });
      var d = data()[vid];
      var li = makeLine(vid, qty, d, 0);
      if (d) { dT += d.cents * qty; dS += Math.max(0, d.was_cents - d.cents) * qty; addMoney(dT, dS); }
      list.insertBefore(li, list.firstChild);
      var empty = q('[data-gfc-empty]', r); if (empty) empty.hidden = true;
      var foot = q('[data-gfc-foot]', r); if (foot) foot.hidden = false;
      var up = q('[data-gfc-up]', r);
      if (up) up.hidden = !!q('[data-gfc-line][data-vid="' + up.getAttribute('data-vid') + '"]:not(.is-gone)', list);
      updateCount();
      tick();
    }

    /* API du bloc d'offre : remplace l'offre déjà au panier (variantes du même
       produit) par celle choisie, garde l'upsell, ouvre le panier aussitôt. */
    function setMain(o) {
      var vid = parseInt(o.vid, 10), qty = parseInt(o.qty, 10) || 1;
      var family = (o.variants || []).map(function (x) { return parseInt(x, 10); });
      var r = root();
      if (!r || !vid) return Promise.reject(new Error('gf-cart'));
      /* un geste encore en attente (quantité modifiée juste avant) part avant l'offre,
         sinon il passerait après et pourrait la défaire */
      flush();
      var updates = {};
      qa('[data-gfc-line]', r).forEach(function (l) {
        var v = parseInt(l.getAttribute('data-vid'), 10);
        if (v !== vid && family.indexOf(v) > -1) updates[v] = 0;
      });
      updates[vid] = qty;
      /* le header se ré-hydrate une fois au repos après le chargement (Horizon) :
         inutile maintenant, notre réponse apporte le panier à jour */
      var sec = r.closest('.shopify-section'); if (sec) sec.setAttribute('data-hydrated', 'true');
      optimistic(vid, qty, family);
      opening = true;
      /* le bouton réagit d'abord (image suivante), le tiroir s'ouvre juste après :
         l'ouverture d'Horizon (fenêtre modale sur une longue page) est lourde et ne
         doit pas retarder le premier retour visuel du tap */
      var opened = new Promise(function (res) {
        requestAnimationFrame(function () { setTimeout(function () { open().then(res); }, 0); });
      });
      opened.then(function () { requestAnimationFrame(function () { requestAnimationFrame(function () { opening = false; }); }); });
      return request('cart/update.js', { updates: updates }).then(function (cart) {
        return opened.then(function (ok) {
          /* panier pas encore prêt (réseau très lent) : on file au checkout, le panier est déjà à jour */
          if (!ok) window.location.href = ROOT + 'checkout';
          return cart;
        });
      }, function (err) {
        var d = drawer(); if (d && typeof d.close === 'function') d.close();
        throw err;
      });
    }

    /* ── Compte à rebours de l'upsell : démarre à la 1re vue de la carte, ne
       repart pas à zéro à chaque ouverture (onglet), disparaît à zéro. ── */
    var CLOCK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function tick() {
      var el = q('[data-gfc-timer]');
      var dlg = el && el.closest('dialog');
      if (!el || !dlg || !dlg.open) return;
      var card = el.closest('[data-gfc-up]');
      if (!card || card.hidden) return;
      var min = parseFloat(el.getAttribute('data-min')) || 10, t0 = 0;
      try { t0 = parseInt(sessionStorage.getItem('gfc_t0'), 10) || 0; } catch (err) {}
      if (!t0) { t0 = Date.now(); try { sessionStorage.setItem('gfc_t0', t0); } catch (err) {} }
      var left = Math.ceil((t0 + min * 60000 - Date.now()) / 1000);
      if (left <= 0) { el.hidden = true; return; }
      var m = Math.floor(left / 60), s = left % 60;
      var t = '<b>' + (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s + '</b>';
      el.innerHTML = CLOCK + '<span>' + esc(el.getAttribute('data-tpl') || '').replace('[temps]', t) + '</span>';
      el.hidden = false;
    }
    setInterval(tick, 1000);
    var dc = drawer();
    if (dc) dc.addEventListener('dialog:open', tick);

    /* Images du panier préchargées après le chargement de la page : à
       l'ouverture, tout est déjà en cache (une image lazy dans un dialog
       fermé ne se charge qu'à l'ouverture). */
    var warmed = false;
    function warm() {
      var r = root(); if (!r || !q('[id^="gfp-cta-"]')) return;
      qa('img[loading="lazy"]', r).forEach(function (img) { img.loading = 'eager'; });
      if (warmed) return;
      warmed = true;
      var d = data();
      Object.keys(d).forEach(function (k) { if (d[k].img) { var i = new Image(); i.src = d[k].img; } });
    }
    function later() { (window.requestIdleCallback || function (f) { setTimeout(f, 1); })(function () { setTimeout(warm, 1200); }); }
    if (document.readyState === 'complete') later(); else window.addEventListener('load', later);

    window.gfCart = { setMain: setMain, open: open, refresh: refresh };
  })();
</script>
