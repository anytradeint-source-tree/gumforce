{% comment %}
  ============================================================================
  GUMFORCE Blog — GRILLE D'ARTICLES
  ----------------------------------------------------------------------------
  Section pour le template « blog » (marche aussi ailleurs via le sélecteur
  de blog). 100% branchée sur les blogs natifs Shopify : articles, images,
  dates (localisées), tags, extraits, pagination. En-tête = recette GF
  (badge + titre clamp + sous-titre), anim d'entrée pilotée JS, hover réservé
  au vrai survol, content-visibility pour la perf. Aucun contenu en dur.
  ============================================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign b = s.blog
  if b == blank
    assign b = blog
  endif

  assign accent = s.accent_color | default: '#2AB5B4'
  assign ar = accent | color_extract: 'red'
  assign ag = accent | color_extract: 'green'
  assign ab = accent | color_extract: 'blue'

  assign txt_hd  = s.color_heading | default: '#0e0e0e'
  assign txt     = s.color_text    | default: '#0e0e0e'
  assign txt_mut = s.color_muted   | default: '#6b6b6b'
  assign card_bg = s.color_card    | default: '#ffffff'

  if s.transparent_bg == false
    assign root_bg = s.color_bg | default: '#ffffff'
  else
    assign root_bg = 'transparent'
  endif

  assign heading_size = s.heading_size | default: 32
  assign cols   = s.cols_desktop | default: 3
  assign cols_m = s.cols_mobile  | default: '1'
  assign gap    = s.grid_gap     | default: 16
  assign rad    = s.card_radius  | default: 16
  assign h_tag  = s.heading_tag  | default: 'h1'
  assign per    = s.per_page     | default: 9

  case s.img_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'wide'
      assign ratio = '16 / 9'
    when 'photo'
      assign ratio = '3 / 2'
    else
      assign ratio = '16 / 10'
  endcase

  assign show_excerpt  = s.show_excerpt  | default: true, allow_false: true
  assign show_date     = s.show_date     | default: true, allow_false: true
  assign show_readtime = s.show_readtime | default: true, allow_false: true
  assign show_tag      = s.show_tag      | default: true, allow_false: true
-%}

<style>
  #gfbg-{{ sid }},
  #gfbg-{{ sid }} *,
  #gfbg-{{ sid }} *::before,
  #gfbg-{{ sid }} *::after { margin:0; padding:0; box-sizing:border-box; }

  #gfbg-{{ sid }} {
    /* pas de content-visibility : mesuré sur WebKit, il retardait le chargement des images lazy jusqu'à l'écran */
    --gfbg-font:      var(--font-body--family, 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif);
    --gfbg-font-head: var(--font-heading--family, 'Oswald', sans-serif);
    --gfbg-accent:    {{ accent }};
    --gfbg-ar:        {{ ar }};
    --gfbg-ag:        {{ ag }};
    --gfbg-ab:        {{ ab }};
    --gfbg-text:      {{ txt }};
    --gfbg-hd:        {{ txt_hd }};
    --gfbg-mut:       {{ txt_mut }};
    --gfbg-card-bg:   {{ card_bg }};
    --gfbg-cols:      {{ cols }};
    --gfbg-cols-m:    {{ cols_m }};
    --gfbg-gap:       {{ gap }}px;
    --gfbg-rad:       {{ rad }}px;
    --gfbg-ratio:     {{ ratio }};
    --gfbg-heading:   {{ heading_size }}px;

    font-family: var(--gfbg-font);
    background: {{ root_bg }};
    color: var(--gfbg-text);
    padding: {{ s.padding_top | default: 48 }}px 16px {{ s.padding_bottom | default: 60 }}px;
  }

  /* ── Header (recette GF) ── */
  #gfbg-{{ sid }} .gfbg-hd { text-align:center; margin-bottom:30px; }
  #gfbg-{{ sid }} .gfbg-badge {
    display:inline-flex; align-items:center; gap:6px;
    background:rgba(var(--gfbg-ar),var(--gfbg-ag),var(--gfbg-ab),0.09);
    border:1px solid rgba(var(--gfbg-ar),var(--gfbg-ag),var(--gfbg-ab),0.22);
    color:var(--gfbg-accent);
    font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em;
    padding:6px 14px; border-radius:100px; margin-bottom:16px; line-height:1;
  }
  #gfbg-{{ sid }} .gfbg-title {
    font-family:var(--gfbg-font-head); color:var(--gfbg-hd);
    font-size:clamp(22px, calc(var(--gfbg-heading) * 0.78), var(--gfbg-heading));
    font-weight:700; line-height:1.15; letter-spacing:-0.02em;
    margin:0 auto 12px; max-width:620px; text-wrap:balance; text-decoration:none;
  }
  #gfbg-{{ sid }} .gfbg-hd p { font-size:14px; color:var(--gfbg-mut); line-height:1.5; max-width:480px; margin:0 auto; }

  /* ── Grille ── */
  #gfbg-{{ sid }} .gfbg-grid {
    display:grid;
    grid-template-columns:repeat(var(--gfbg-cols-m),1fr);
    gap:var(--gfbg-gap);
    max-width:1120px; margin:0 auto;
  }

  /* ── Carte article ── */
  #gfbg-{{ sid }} .gfbg-card {
    display:flex; flex-direction:column;
    background:var(--gfbg-card-bg);
    border-radius:var(--gfbg-rad); overflow:hidden;
    box-shadow:0 4px 14px rgba(0,0,0,0.07);
    text-decoration:none; color:inherit;
    transition:transform .35s cubic-bezier(.22,1,.36,1), box-shadow .35s cubic-bezier(.22,1,.36,1);
    -webkit-tap-highlight-color:transparent;
  }
  #gfbg-{{ sid }} .gfbg-media { position:relative; aspect-ratio:var(--gfbg-ratio); overflow:hidden; background:#eceef0; }
  #gfbg-{{ sid }} .gfbg-media img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .5s cubic-bezier(.22,1,.36,1); }
  #gfbg-{{ sid }} .gfbg-ph { width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:linear-gradient(150deg,#f1f1f4,#e4e4e9); color:#c2c2cc; }
  #gfbg-{{ sid }} .gfbg-ph svg { width:30px; height:30px; }

  #gfbg-{{ sid }} .gfbg-body { display:flex; flex-direction:column; gap:8px; padding:16px 16px 18px; flex:1; }
  #gfbg-{{ sid }} .gfbg-meta { display:flex; align-items:center; flex-wrap:wrap; gap:8px; font-size:11.5px; color:var(--gfbg-mut); font-weight:500; line-height:1.3; }
  #gfbg-{{ sid }} .gfbg-chip {
    display:inline-flex; align-items:center;
    background:rgba(var(--gfbg-ar),var(--gfbg-ag),var(--gfbg-ab),0.10);
    color:var(--gfbg-accent);
    font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.07em;
    padding:3px 9px; border-radius:100px; line-height:1.3;
  }
  #gfbg-{{ sid }} .gfbg-dotsep { width:3px; height:3px; border-radius:50%; background:var(--gfbg-mut); opacity:.55; flex-shrink:0; }
  #gfbg-{{ sid }} .gfbg-meta time { color:inherit; }
  #gfbg-{{ sid }} .gfbg-name {
    font-family:var(--gfbg-font-head);
    font-size:18px; font-weight:700; line-height:1.25; letter-spacing:-0.01em; color:var(--gfbg-hd);
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
  }
  #gfbg-{{ sid }} .gfbg-exc {
    font-size:13px; color:var(--gfbg-mut); line-height:1.55;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
  }
  #gfbg-{{ sid }} .gfbg-read {
    margin-top:auto; padding-top:6px;
    display:inline-flex; align-items:center; gap:5px;
    font-size:12.5px; font-weight:700; color:var(--gfbg-accent); letter-spacing:0.01em;
  }
  #gfbg-{{ sid }} .gfbg-read svg { width:14px; height:14px; flex-shrink:0; transition:transform .25s ease; }

  @media (hover:hover) and (pointer:fine) {
    #gfbg-{{ sid }} .gfbg-card:hover { transform:translateY(-3px); box-shadow:0 14px 32px rgba(0,0,0,0.13); }
    #gfbg-{{ sid }} .gfbg-card:hover .gfbg-media img { transform:scale(1.05); }
    #gfbg-{{ sid }} .gfbg-card:hover .gfbg-read svg { transform:translateX(3px); }
  }

  /* ── Pagination ── */
  #gfbg-{{ sid }} .gfbg-pag { display:flex; align-items:center; justify-content:center; gap:6px; margin-top:28px; flex-wrap:wrap; }
  #gfbg-{{ sid }} .gfbg-pg {
    min-width:36px; height:36px; padding:0 6px;
    display:inline-flex; align-items:center; justify-content:center;
    border-radius:100px; border:1.5px solid rgba(var(--gfbg-ar),var(--gfbg-ag),var(--gfbg-ab),0.35);
    color:var(--gfbg-accent); font-size:13px; font-weight:700; text-decoration:none; line-height:1;
    transition:background .2s ease, color .2s ease, border-color .2s ease;
    -webkit-tap-highlight-color:transparent;
  }
  #gfbg-{{ sid }} a.gfbg-pg:hover { background:var(--gfbg-accent); color:#fff; border-color:transparent; }
  #gfbg-{{ sid }} .gfbg-pg--cur { background:var(--gfbg-accent); color:#fff; border-color:transparent; }
  #gfbg-{{ sid }} .gfbg-pg--dots { border-color:transparent; color:var(--gfbg-mut); }

  /* ── Vide ── */
  #gfbg-{{ sid }} .gfbg-empty {
    max-width:460px; margin:0 auto; padding:32px 24px;
    border:2px dashed rgba(0,0,0,0.12); border-radius:14px; text-align:center;
    color:var(--gfbg-mut); font-size:14px; line-height:1.55;
  }

  /* ── Desktop ── */
  @media (min-width:750px) {
    #gfbg-{{ sid }} .gfbg-grid { grid-template-columns:repeat(var(--gfbg-cols),1fr); gap:calc(var(--gfbg-gap) + 4px); }
    #gfbg-{{ sid }} .gfbg-title { font-size:var(--gfbg-heading); }
    #gfbg-{{ sid }} .gfbg-hd { margin-bottom:40px; }
    #gfbg-{{ sid }} .gfbg-hd p { font-size:15px; }
    #gfbg-{{ sid }} .gfbg-name { font-size:19px; }
    #gfbg-{{ sid }} .gfbg-body { padding:18px 18px 20px; }
  }

  /* ── Anim d'entrée (activée par JS via .gfbg-anim, révélée par .gfbg-in) ── */
  #gfbg-{{ sid }}.gfbg-anim .gfbg-hd { opacity:0; transform:translateY(16px); transition:opacity .6s ease, transform .6s cubic-bezier(.22,1,.36,1); }
  #gfbg-{{ sid }}.gfbg-anim.gfbg-in .gfbg-hd { opacity:1; transform:none; }
  #gfbg-{{ sid }}.gfbg-anim .gfbg-card { opacity:0; transform:translateY(16px); transition:opacity .55s ease, transform .55s cubic-bezier(.22,1,.36,1); transition-delay:var(--gfbg-d,0ms); }
  #gfbg-{{ sid }}.gfbg-anim.gfbg-in .gfbg-card { opacity:1; transform:none; }
  @media (prefers-reduced-motion:reduce) {
    #gfbg-{{ sid }}.gfbg-anim .gfbg-hd,
    #gfbg-{{ sid }}.gfbg-anim .gfbg-card { opacity:1 !important; transform:none !important; transition:none !important; }
  }
</style>

<section id="gfbg-{{ sid }}">

  <div class="gfbg-hd">
    {%- if s.badge_text != blank -%}<span class="gfbg-badge">{{ s.badge_text }}</span>{%- endif -%}
    <{{ h_tag }} class="gfbg-title">{%- if s.heading != blank -%}{{ s.heading }}{%- else -%}{{ b.title | default: 'Le blog' }}{%- endif -%}</{{ h_tag }}>
    {%- if s.subheading != blank -%}<p>{{ s.subheading }}</p>{%- endif -%}
  </div>

  {%- if b != blank and b.articles_count > 0 -%}
    {%- paginate b.articles by per -%}
      <div class="gfbg-grid">
        {%- for article in b.articles -%}
          {%- assign d = forloop.index0 | times: 40 | plus: 60 | at_most: 420 -%}
          <a class="gfbg-card" href="{{ article.url }}" style="--gfbg-d:{{ d }}ms">
            <div class="gfbg-media">
              {%- if article.image != blank -%}
                <img src="{{ article.image | image_url: width: 640 }}"
                     srcset="{{ article.image | image_url: width: 400 }} 400w,
                            {{ article.image | image_url: width: 640 }} 640w,
                            {{ article.image | image_url: width: 900 }} 900w"
                     sizes="(max-width: 749px) 92vw, 380px"
                     alt="{{ article.image.alt | default: article.title | escape }}"
                     {% if forloop.index0 < 2 %}loading="eager"{% else %}loading="lazy" fetchpriority="low"{% endif %} decoding="async"
                     width="640" height="400">
              {%- else -%}
                <div class="gfbg-ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
              {%- endif -%}
            </div>
            <div class="gfbg-body">
              <div class="gfbg-meta">
                {%- if show_tag and article.tags.size > 0 -%}<span class="gfbg-chip">{{ article.tags.first }}</span>{%- endif -%}
                {%- if show_date -%}{{ article.published_at | time_tag: format: 'date' }}{%- endif -%}
                {%- if show_readtime -%}
                  {%- assign gf_words = article.content | strip_html | split: ' ' | size -%}
                  {%- assign gf_mins = gf_words | divided_by: 200 | at_least: 1 -%}
                  {%- if show_date -%}<span class="gfbg-dotsep" aria-hidden="true"></span>{%- endif -%}
                  <span>{{ gf_mins }} min de lecture</span>
                {%- endif -%}
              </div>
              <span class="gfbg-name">{{ article.title }}</span>
              {%- if show_excerpt -%}
                <span class="gfbg-exc">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</span>
              {%- endif -%}
              <span class="gfbg-read">{{ s.read_text | default: "Lire l'article" }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {%- assign cur = paginate.current_page | append: '' -%}
        <nav class="gfbg-pag" aria-label="Pagination du blog">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="gfbg-pg" aria-label="Page précédente">‹</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="gfbg-pg">{{ part.title }}</a>
            {%- elsif part.title == cur -%}
              <span class="gfbg-pg gfbg-pg--cur" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="gfbg-pg gfbg-pg--dots">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="gfbg-pg" aria-label="Page suivante">›</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <div class="gfbg-empty">
      <strong>GF Blog — configuration</strong><br>
      Choisis un blog dans les réglages de la section (ou place-la sur le template « blog »), puis publie tes premiers articles dans Boutique en ligne → Articles de blog.
    </div>
  {%- endif -%}

</section>

<script>
(function () {
  var root = document.getElementById('gfbg-{{ sid }}');
  if (!root) return;
  /* ── Images : chargement anticipé. Mesuré sur WebKit (Safari/iOS) : avec
     content-visibility le lazy natif ne demandait l'image qu'à ~15px de l'écran
     (placeholder noir visible), ~850px sans. Ici on observe la SECTION à 2000px
     et on passe ses images en eager → prêtes avant d'arriver dessus ; filet
     après le chargement de la page (réseau libre). Sans JS : lazy natif. ── */
  (function () {
    var imgs = root.querySelectorAll('img[loading="lazy"]');
    if (!imgs.length) return;
    function warm(im) {
      if (im.loading === 'lazy') im.loading = 'eager';
      if (im.decode) { try { im.decode().then(null, function () {}); } catch (e) {} }
    }
    function warmAll() { for (var i = 0; i < imgs.length && i < 12; i++) warm(imgs[i]); }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) {
        for (var i = 0; i < es.length; i++) { if (es[i].isIntersecting) { io.disconnect(); warmAll(); return; } }
      }, { rootMargin: '2000px 0px' });
      io.observe(root);
    } else { warmAll(); }
    function later() { if (window.requestIdleCallback) window.requestIdleCallback(warmAll, { timeout: 4000 }); else setTimeout(warmAll, 2500); }
    if (document.readyState === 'complete') later(); else window.addEventListener('load', later);
  })();
})();
</script>

<script>
(function(){
  var root = document.getElementById('gfbg-{{ sid }}');
  if (!root) return;
  {%- if s.enable_animation -%}
  if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
    root.classList.add('gfbg-anim');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){ if (e.isIntersecting){ root.classList.add('gfbg-in'); io.disconnect(); } });
      }, { threshold: 0.08 });
      io.observe(root);
    } else {
      root.classList.add('gfbg-in');
    }
  }
  {%- endif -%}
})();
</script>

{% schema %}
{
  "name": "GF Blog (grille)",
  "tag": "section",
  "class": "gf-blog-grid",
  "settings": [
    { "type": "paragraph", "content": "Grille d'articles branchée sur un blog Shopify. Placée sur le template « blog », elle utilise automatiquement le blog de la page." },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Vide = blog de la page (template blog)." },

    { "type": "header", "content": "── En-tête ──" },
    { "type": "text", "id": "badge_text", "label": "Badge (vide = masqué)", "default": "Conseils & science" },
    { "type": "text", "id": "heading", "label": "Titre", "info": "Vide = nom du blog Shopify." },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Mâchoire, créatine, entraînement : nos guides." },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille titre (px)",
      "min": 20,
      "max": 56,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Type de titre",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h1"
    },

    { "type": "header", "content": "── Grille ──" },
    { "type": "range", "id": "per_page", "label": "Articles par page", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "range", "id": "cols_desktop", "label": "Colonnes (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "cols_mobile", "label": "Colonnes (mobile)", "options": [{"value":"1","label":"1"},{"value":"2","label":"2"}], "default": "1" },
    { "type": "select", "id": "img_ratio", "label": "Format des images", "options": [{"value":"card","label":"Carte 16:10"},{"value":"wide","label":"Large 16:9"},{"value":"photo","label":"Photo 3:2"},{"value":"square","label":"Carré 1:1"}], "default": "card" },
    { "type": "range", "id": "grid_gap", "label": "Écart", "min": 8, "max": 32, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "card_radius", "label": "Arrondi", "min": 0, "max": 28, "step": 2, "default": 16, "unit": "px" },

    { "type": "header", "content": "── Contenu des cartes ──" },
    { "type": "checkbox", "id": "show_tag", "label": "Tag (premier tag de l'article)", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Date", "default": true },
    { "type": "checkbox", "id": "show_readtime", "label": "Temps de lecture", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Extrait", "default": true },
    { "type": "text", "id": "read_text", "label": "Texte du lien", "default": "Lire l'article" },

    { "type": "header", "content": "── Apparence ──" },
    { "type": "checkbox", "id": "transparent_bg", "label": "Fond transparent (laisse voir le dégradé)", "default": true },
    { "type": "color", "id": "color_bg", "label": "Couleur de fond (si non transparent)", "default": "#ffffff" },
    { "type": "color", "id": "color_heading", "label": "Couleur titre", "default": "#0e0e0e" },
    { "type": "color", "id": "color_text", "label": "Couleur texte", "default": "#0e0e0e" },
    { "type": "color", "id": "color_muted", "label": "Couleur texte secondaire", "default": "#6b6b6b" },
    { "type": "color", "id": "accent_color", "label": "Couleur accent", "default": "#2AB5B4" },
    { "type": "color", "id": "color_card", "label": "Fond des cartes", "default": "#ffffff" },

    { "type": "header", "content": "── Animation ──" },
    { "type": "checkbox", "id": "enable_animation", "label": "Animation d'entrée au scroll", "default": true },

    { "type": "header", "content": "── Mise en page ──" },
    { "type": "range", "id": "padding_top", "label": "Padding haut", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bas", "min": 0, "max": 120, "step": 4, "default": 60, "unit": "px" }
  ],
  "presets": [
    { "name": "GF Blog (grille)", "category": "Blog" }
  ]
}
{% endschema %}
