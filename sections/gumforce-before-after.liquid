{% comment %}
  ============================================================================
  GUMFORCE Before / After — Side by Side
  ----------------------------------------------------------------------------
  Mobile: stacked (header → images → info).
  Desktop: two-column like Image+Text (text left, images right).
  High-res retina images. Entrance animation.
  ============================================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  if s.use_theme_font
    assign gf_font = 'var(--font-body-family, var(--body-font-family, var(--font-stack-body, inherit)))'
  else
    assign gf_font = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  endif

  assign bg      = s.bg_color      | default: '#0a0a0a'
  assign txt     = s.text_color    | default: '#ffffff'
  assign txt_hd  = s.heading_color | default: '#ffffff'
  assign txt_mut = s.text_muted    | default: '#888888'
  assign accent  = s.accent_color  | default: '#2AB5B4'
  assign ar      = accent | color_extract: 'red'
  assign ag      = accent | color_extract: 'green'
  assign ab      = accent | color_extract: 'blue'

  assign card_rad = s.card_radius  | default: 16
  assign img_gap  = s.image_gap    | default: 12
  assign h_tag    = s.heading_tag  | default: 'h2'

  assign heading_size = s.heading_size | default: 32
  assign body_size    = s.body_size | default: 15
-%}

{%- unless s.use_theme_font -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
{%- endunless -%}

<style>
  /* ── Reset ── */
  #gfba-{{ sid }},
  #gfba-{{ sid }} *,
  #gfba-{{ sid }} *::before,
  #gfba-{{ sid }} *::after {
    margin: 0; padding: 0; box-sizing: border-box;
  }

  /* ── Root ── */
  #gfba-{{ sid }} {
    /* pas de content-visibility : mesuré sur WebKit, il retardait le chargement des images lazy jusqu'à l'écran */
    --gfba-font:    {{ gf_font }};
    --gfba-bg:      {{ bg }};
    --gfba-text:    {{ txt }};
    --gfba-text-hd: {{ txt_hd }};
    --gfba-text-mut:{{ txt_mut }};
    --gfba-accent:  {{ accent }};
    --gfba-ar:      {{ ar }};
    --gfba-ag:      {{ ag }};
    --gfba-ab:      {{ ab }};
    --gfba-rad:     {{ card_rad }}px;
    --gfba-gap:     {{ img_gap }}px;
    --gfba-heading: {{ heading_size }}px;
    --gfba-body:    {{ body_size }}px;

    font-family: var(--gfba-font);
    background: var(--gfba-bg);
    color: var(--gfba-text);
    position: relative;
    overflow: hidden;
  }

  /* ═══════════════════════════════════════════
     INNER — main grid container (like gfit-inner)
     ═══════════════════════════════════════════ */
  #gfba-{{ sid }} .gfba-inner {
    max-width: 1340px; padding-block: clamp(48px, 6vw, 88px);
    margin: 0 auto;
    padding: {{ s.padding_top_mobile | default: 40 }}px 20px {{ s.padding_bottom_mobile | default: 40 }}px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px; /* en-tête → média : recette GF (30 mobile / 44 desktop) */
    align-items: center;
  }

  /* ═══════════════════════════════════════════
     TEXT COLUMN — .gfba-hd
     ═══════════════════════════════════════════ */
  #gfba-{{ sid }} .gfba-hd {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  #gfba-{{ sid }} .gfba-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(var(--gfba-ar), var(--gfba-ag), var(--gfba-ab), 0.08);
    border: 1px solid rgba(var(--gfba-ar), var(--gfba-ag), var(--gfba-ab), 0.18);
    color: var(--gfba-accent);
    font-family: var(--gfba-font);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 16px;
    line-height: 1;
  }

  #gfba-{{ sid }} .gfba-title {
    color: var(--gfba-text-hd);
    font-size: clamp(22px, calc(var(--gfba-heading) * 0.78), var(--gfba-heading));
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
    text-decoration: none;
    text-wrap: balance;
  }

  {%- unless s.use_theme_font -%}
  #gfba-{{ sid }} .gfba-title {
    font-family: var(--gfba-font);
  }
  {%- endunless -%}

  #gfba-{{ sid }} .gfba-sub {
    font-family: var(--gfba-font);
    font-size: var(--gfba-body);
    color: var(--gfba-text-mut);
    line-height: 1.6;
    max-width: 480px;
  }

  /* ── Info bar ── */
  #gfba-{{ sid }} .gfba-info {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    text-align: center;
    flex-wrap: wrap;
  }

  #gfba-{{ sid }} .gfba-info-name {
    font-family: var(--gfba-font);
    font-size: 13px;
    font-weight: 700;
    color: var(--gfba-text);
    line-height: 1.3;
  }

  #gfba-{{ sid }} .gfba-info-dur {
    font-family: var(--gfba-font);
    font-size: 10px;
    font-weight: 600;
    color: var(--gfba-accent);
    background: rgba(var(--gfba-ar), var(--gfba-ag), var(--gfba-ab), 0.12);
    border: 1px solid rgba(var(--gfba-ar), var(--gfba-ag), var(--gfba-ab), 0.2);
    padding: 3px 10px;
    border-radius: 100px;
    line-height: 1;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ═══════════════════════════════════════════
     MEDIA COLUMN — .gfba-media
     ═══════════════════════════════════════════ */
  #gfba-{{ sid }} .gfba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gfba-gap);
  }

  /* ── Image card ── */
  #gfba-{{ sid }} .gfba-card {
    position: relative;
    border-radius: var(--gfba-rad);
    overflow: hidden;
    background: #1a1a1a;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  #gfba-{{ sid }} .gfba-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* ── Label pill ── */
  #gfba-{{ sid }} .gfba-label {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    font-family: var(--gfba-font);
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 9px;
    border-radius: 100px;
    pointer-events: none;
    line-height: 1;
  }

  /* ── Placeholder ── */
  #gfba-{{ sid }} .gfba-ph {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(145deg, #1a1a1a, #222);
    color: #555;
    font-family: var(--gfba-font);
    font-size: 11px;
    font-weight: 600;
  }
  #gfba-{{ sid }} .gfba-ph svg {
    width: 28px; height: 28px; color: #444; display: block;
  }

  /* ── Empty state ── */
  #gfba-{{ sid }} .gfba-empty {
    text-align: center;
    padding: 40px 24px;
    color: #555;
    font-family: var(--gfba-font);
    font-size: 14px;
    line-height: 1.5;
  }

  /* ── Curved Arrow ── */
  #gfba-{{ sid }} .gfba-arrow {
    display: block;
    margin: 10px auto 0;
  }

  #gfba-{{ sid }} .gfba-arrow-svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--gfba-accent);
    opacity: 0.45;
  }

  #gfba-{{ sid }} .gfba-arrow-curve {
    stroke-dasharray: var(--gfba-arrow-len, 200);
    stroke-dashoffset: var(--gfba-arrow-len, 200);
  }

  #gfba-{{ sid }} .gfba-arrow-tip {
    opacity: 0;
    transition: opacity 0.35s ease 0.9s;
  }

  #gfba-{{ sid }} .gfba-arrow--drawn .gfba-arrow-tip {
    opacity: 1;
  }

  /* ═══════════════════════════════════════════
     TABLET — ≥ 750 px
     ═══════════════════════════════════════════ */
  @media (min-width: 750px) {
    #gfba-{{ sid }} .gfba-inner {
      gap: 44px;
      padding: {{ s.padding_top | default: 40 }}px 20px {{ s.padding_bottom | default: 40 }}px;
    }

    #gfba-{{ sid }} .gfba-label {
      font-size: 10px;
      padding: 5px 11px;
      top: 12px;
      left: 12px;
    }

    #gfba-{{ sid }} .gfba-info-name { font-size: 14px; }
    #gfba-{{ sid }} .gfba-info-dur  { font-size: 11px; }
  }

  /* ═══════════════════════════════════════════
     DESKTOP — ≥ 1000 px  (two-column layout)
     ═══════════════════════════════════════════ */
  @media (min-width: 1000px) {
    #gfba-{{ sid }} .gfba-inner {
      grid-template-columns: 45fr 55fr;
      gap: 48px;
      padding: {{ s.padding_top | default: 40 }}px 48px {{ s.padding_bottom | default: 40 }}px;
    }

    /* Colonne texte — alignement au choix (réglage « Alignement du texte (desktop) ») */
    #gfba-{{ sid }} .gfba-hd {
      order: 1;
      {%- if s.text_align_desktop == 'center' %}
      text-align: center;
      align-items: center;
      {%- else %}
      text-align: left;
      align-items: flex-start;
      {%- endif %}
    }

    #gfba-{{ sid }} .gfba-title {
      font-size: var(--gfba-heading);
    }

    #gfba-{{ sid }} .gfba-sub {
      font-size: calc(var(--gfba-body) + 1px);
    }

    #gfba-{{ sid }} .gfba-info {
      justify-content: {% if s.text_align_desktop == 'center' %}center{% else %}flex-start{% endif %};
      margin-top: 28px;
      gap: 12px;
    }

    #gfba-{{ sid }} .gfba-info-name { font-size: 15px; }
    #gfba-{{ sid }} .gfba-info-dur  { font-size: 12px; padding: 4px 14px; }

    /* Media column — right */
    #gfba-{{ sid }} .gfba-media {
      order: 2;
    }

    #gfba-{{ sid }} .gfba-label {
      font-size: 11px;
      padding: 6px 14px;
      top: 14px;
      left: 14px;
    }
  }

  @media (min-width: 1200px) {
    #gfba-{{ sid }} .gfba-inner {
      gap: 64px;
      padding: {{ s.padding_top | default: 40 }}px 64px {{ s.padding_bottom | default: 40 }}px;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    #gfba-{{ sid }} .gfba-arrow-curve {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
    }
    #gfba-{{ sid }} .gfba-arrow-tip {
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>

<section id="gfba-{{ sid }}">
  <div class="gfba-inner">

    {%- comment -%} ── Text column ── {%- endcomment -%}
    <div class="gfba-hd{% if s.enable_animation %} gfba-anim{% endif %}">
      {%- if s.badge_text != blank -%}
        <span class="gfba-badge">{{ s.badge_text }}</span>
      {%- endif -%}
      <{{ h_tag }} class="gfba-title">{{ s.heading }}</{{ h_tag }}>
      {%- if s.subheading != blank -%}
        <p class="gfba-sub">{{ s.subheading }}</p>
      {%- endif -%}

      {%- if s.info_name != blank or s.info_duration != blank -%}
        <div class="gfba-info">
          {%- if s.info_name != blank -%}
            <span class="gfba-info-name">{{ s.info_name }}</span>
          {%- endif -%}
          {%- if s.info_duration != blank -%}
            <span class="gfba-info-dur">{{ s.info_duration }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Media column ── {%- endcomment -%}
    {%- if s.before_image != blank or s.after_image != blank -%}
      <div class="gfba-media{% if s.enable_animation %} gfba-anim gfba-anim-d{% endif %}">
        <div class="gfba-grid">

          {%- comment -%} Before {%- endcomment -%}
          <div class="gfba-card">
            {%- if s.before_image != blank -%}
              <img src="{{ s.before_image | image_url: width: 1000 }}"
                   srcset="{{ s.before_image | image_url: width: 400 }} 400w,
                          {{ s.before_image | image_url: width: 700 }} 700w,
                          {{ s.before_image | image_url: width: 1000 }} 1000w,
                          {{ s.before_image | image_url: width: 1400 }} 1400w"
                   sizes="(max-width: 749px) calc(50vw - {{ img_gap | divided_by: 2 }}px - 20px), (max-width: 999px) calc(50vw - {{ img_gap | divided_by: 2 }}px - 20px), calc(55vw * 0.5 - {{ img_gap | divided_by: 2 }}px)"
                   alt="{{ s.before_label | default: 'Avant' | escape }}"
                   loading="lazy"
                   width="{{ s.before_image.width }}"
                   height="{{ s.before_image.height }}"
                   draggable="false">
            {%- else -%}
              <div class="gfba-ph">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                Avant
              </div>
            {%- endif -%}
            <span class="gfba-label">{{ s.before_label | default: 'Avant' }}</span>
          </div>

          {%- comment -%} After {%- endcomment -%}
          <div class="gfba-card">
            {%- if s.after_image != blank -%}
              <img src="{{ s.after_image | image_url: width: 1000 }}"
                   srcset="{{ s.after_image | image_url: width: 400 }} 400w,
                          {{ s.after_image | image_url: width: 700 }} 700w,
                          {{ s.after_image | image_url: width: 1000 }} 1000w,
                          {{ s.after_image | image_url: width: 1400 }} 1400w"
                   sizes="(max-width: 749px) calc(50vw - {{ img_gap | divided_by: 2 }}px - 20px), (max-width: 999px) calc(50vw - {{ img_gap | divided_by: 2 }}px - 20px), calc(55vw * 0.5 - {{ img_gap | divided_by: 2 }}px)"
                   alt="{{ s.after_label | default: 'Après' | escape }}"
                   loading="lazy"
                   width="{{ s.after_image.width }}"
                   height="{{ s.after_image.height }}"
                   draggable="false">
            {%- else -%}
              <div class="gfba-ph">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                Après
              </div>
            {%- endif -%}
            <span class="gfba-label">{{ s.after_label | default: 'Après' }}</span>
          </div>

        </div>

        {%- if s.show_arrow -%}
          <div class="gfba-arrow" data-gfba-arrow="{{ sid }}">
            <svg class="gfba-arrow-svg" viewBox="0 6 200 30" fill="none">
              <path class="gfba-arrow-curve" d="M 40 8 C 70 42, 130 42, 160 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
              <path class="gfba-arrow-tip" d="M 157 18 L 160 8 L 151 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

    {%- else -%}
      <div class="gfba-empty">
        Ajoutez une image Avant et une image Après dans les réglages de cette section.
      </div>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var root = document.getElementById('gfba-' + {{ sid | json }});
  if (!root) return;
  /* ── Images : chargement anticipé. Mesuré sur WebKit (Safari/iOS) : avec
     content-visibility le lazy natif ne demandait l'image qu'à ~15px de l'écran
     (placeholder noir visible), ~850px sans. Ici on observe la SECTION à 2000px
     et on passe ses images en eager → prêtes avant d'arriver dessus ; filet
     après le chargement de la page (réseau libre). Sans JS : lazy natif. ── */
  (function () {
    var imgs = root.querySelectorAll('img[loading="lazy"]');
    if (!imgs.length) return;
    function warm(im) {
      if (im.loading === 'lazy') im.loading = 'eager';
      if (im.decode) { try { im.decode().then(null, function () {}); } catch (e) {} }
    }
    function warmAll() { for (var i = 0; i < imgs.length && i < 6; i++) warm(imgs[i]); }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) {
        for (var i = 0; i < es.length; i++) { if (es[i].isIntersecting) { io.disconnect(); warmAll(); return; } }
      }, { rootMargin: '2000px 0px' });
      io.observe(root);
    } else { warmAll(); }
    function later() { if (window.requestIdleCallback) window.requestIdleCallback(warmAll, { timeout: 4000 }); else setTimeout(warmAll, 2500); }
    if (document.readyState === 'complete') later(); else window.addEventListener('load', later);
  })();
})();
</script>

{%- if s.enable_animation -%}
<style>
  #gfba-{{ sid }} .gfba-anim {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #gfba-{{ sid }} .gfba-anim.gfba-in {
    opacity: 1;
    transform: translateY(0);
  }
  #gfba-{{ sid }} .gfba-anim-d {
    transition-delay: 0.15s;
  }
</style>
<script>
(function(){
  var root = document.getElementById('gfba-' + {{ sid | json }});
  if (!root) return;
  var els = root.querySelectorAll('.gfba-anim');
  if (!els.length) return;
  if (!('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('gfba-in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) { e.target.classList.add('gfba-in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.12 });
  els.forEach(function(e){ io.observe(e); });
})();
</script>
{%- endif -%}

{%- if s.show_arrow -%}
<script>
(function(){
  var root = document.getElementById('gfba-' + {{ sid | json }});
  if (!root) return;
  var aw = root.querySelector('[data-gfba-arrow]');
  if (!aw) return;
  var curve = aw.querySelector('.gfba-arrow-curve');
  if (curve) {
    var len = curve.getTotalLength();
    aw.style.setProperty('--gfba-arrow-len', len);
  }
  function animateDashOffset(curve, from, to, duration) {
    var start = null;
    function step(ts) {
      if (!start) start = ts;
      var t = Math.min((ts - start) / duration, 1);
      /* cubic-bezier(0.22, 1, 0.36, 1) approximation via easeOutQuart */
      var ease = 1 - Math.pow(1 - t, 4);
      curve.style.strokeDashoffset = from + (to - from) * ease;
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        if (curve) {
          var curOffset = parseFloat(getComputedStyle(curve).strokeDashoffset) || curve.getTotalLength();
          animateDashOffset(curve, curOffset, 0, 1100);
        }
        aw.classList.add('gfba-arrow--drawn');
        io.disconnect();
      }
    });
  }, { threshold: 0.3 });
  io.observe(aw);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "GF Avant / Après",
  "tag": "section",
  "class": "gf-before-after",
  "settings": [
    { "type": "header", "content": "── En-tête ──" },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge (eyebrow)",
      "default": "Résultats"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Des résultats visibles"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "<p>Découvre la transformation après 30 jours de mastication Gumforce.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Type de titre",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_align_desktop",
      "label": "Alignement du texte (desktop)",
      "info": "Sur mobile et tablette le texte est toujours centré au-dessus des images.",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "center", "label": "Centré" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille titre (px)",
      "min": 20,
      "max": 56,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Taille sous-titre (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15,
      "unit": "px"
    },

    { "type": "header", "content": "── Images ──" },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Photo Avant"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Photo Après"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Label avant",
