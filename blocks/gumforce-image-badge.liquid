{% comment %}
  ============================================================
  GF — BADGE IMAGE  (seal rond festonne, facon Lemme)
  ------------------------------------------------------------
  Forme = SVG (polygone festonne). Texte = HTML pur en overlay
  avec white-space:nowrap => ne se coupe JAMAIS (le texte SVG
  buguait sur iOS Safari). Texte auto-reduit s'il deborde.
  Overlay sur l'image, ne bloque pas le swipe, disparait quand
  on quitte l'image 1. S'ancre a la galerie en JS.
  A ajouter UNE fois sur la page produit.
  ============================================================
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign uid = block.id
  assign rot = s.rotation | default: -8
  assign ox = s.offset_x | default: 12
  assign oy = s.offset_y | default: 14
  assign pos = s.position | default: 'top-left'
  assign l1 = s.txt1
  assign l2 = s.txt2
  assign l3 = s.txt3
  assign bw = s.badge_w | default: 140
  assign bwm = s.badge_w_mobile | default: 108
  assign anim = s.anim | default: 'pulse'
  assign fsA = bw | times: 14 | divided_by: 100
  assign fsB = bw | times: 115 | divided_by: 1000
  assign fsAm = bwm | times: 14 | divided_by: 100
  assign fsBm = bwm | times: 115 | divided_by: 1000

  comment — mode Black Friday : badge noir et vert, ligne 3 du mode, bandeau Bali en bas de la première photo
  endcomment
  capture gf_bf_on
    render 'gf-bf-on'
  endcapture
  assign bf_l3 = ''
  if gf_bf_on == '1'
    assign bf_l3 = settings.gf_bf_badge_l3 | strip
  endif

  comment — bulle vidéo : rond en haut à droite de la première photo, vidéo en boucle, un clic l'agrandit.
    Affichée si la case est cochée, sinon gardée dans un <template> (rien n'est chargé) et montrée avec ?gf_rond=1.
    Vidéo : le lien des réglages, sinon la première vidéo du produit (480p dans le rond, 720p agrandie)
  endcomment
  assign vb_url = s.vb_video_url | strip
  assign vb_src = vb_url
  assign vb_src_hd = vb_url
  assign vb_poster = ''
  if vb_url == blank and product != blank
    assign vb_media = product.media | where: 'media_type', 'video' | first
    if vb_media != blank
      for vs in vb_media.sources
        if vs.format == 'mp4' and vs.height <= 720
          assign vb_src_hd = vs.url
          if vb_src == blank or vs.height <= 480
            assign vb_src = vs.url
          endif
        endif
      endfor
      assign vb_poster = vb_media.preview_image | image_url: width: 480
    endif
  endif
  assign vb_size = s.vb_size | default: 108
  assign vb_size_m = s.vb_size_mobile | default: 80
  assign vb_zoom = s.vb_zoom | default: 150 | divided_by: 100.0
  assign vb_focus = s.vb_focus | default: 30
  assign vb_accent = s.vb_accent | default: '#2AB5B4'
-%}
{%- if s.show_badge and l1 != blank -%}
{%- capture poscss -%}
{%- case pos -%}
{%- when 'top-left' -%}top:{{ oy }}px;left:{{ ox }}px;transform:rotate({{ rot }}deg);
{%- when 'top-center' -%}top:{{ oy }}px;left:50%;transform:translateX(calc(-50% + ({{ ox }}px))) rotate({{ rot }}deg);
{%- when 'top-right' -%}top:{{ oy }}px;right:{{ ox }}px;transform:rotate({{ rot }}deg);
{%- when 'middle-center' -%}top:50%;left:50%;transform:translate(calc(-50% + ({{ ox }}px)),-50%) rotate({{ rot }}deg);
{%- when 'bottom-left' -%}bottom:{{ oy }}px;left:{{ ox }}px;transform:rotate({{ rot }}deg);
{%- when 'bottom-center' -%}bottom:{{ oy }}px;left:50%;transform:translateX(calc(-50% + ({{ ox }}px))) rotate({{ rot }}deg);
{%- when 'bottom-right' -%}bottom:{{ oy }}px;right:{{ ox }}px;transform:rotate({{ rot }}deg);
{%- endcase -%}
{%- endcapture -%}
<style>
  #gfib-{{ uid }} {
    position: absolute;
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    {{ poscss }}
    width: {{ bw }}px;
    max-width: 48%;
    {% if s.shadow %}filter: drop-shadow(0 4px 9px rgba(0, 0, 0, 0.22));{% endif %}
    transition: opacity 0.2s ease;
  }
  #gfib-{{ uid }} .gfib-inner { position: relative; width: 100%; transform-origin: center;{% if anim != 'none' %} will-change: transform;{% endif %} }
  {%- if anim == 'pulse' -%}
  #gfib-{{ uid }} .gfib-inner { animation: gfibp-{{ uid }} 1.8s ease-in-out infinite; }
  @keyframes gfibp-{{ uid }} { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.07); } }
  {%- elsif anim == 'pop' -%}
  #gfib-{{ uid }} .gfib-inner { animation: gfibpop-{{ uid }} 0.55s cubic-bezier(0.2, 1.35, 0.4, 1) both; }
  @keyframes gfibpop-{{ uid }} { 0% { transform: scale(0.3); } 70% { transform: scale(1.12); } 100% { transform: scale(1); } }
  {%- endif -%}
  @media (prefers-reduced-motion: reduce) { #gfib-{{ uid }} .gfib-inner { animation: none !important; } }
  #gfib-{{ uid }} .gfib-shape { display: block; width: 100%; height: auto; }
  #gfib-{{ uid }} .gfib-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.04;
    font-family: var(--font-heading--family, 'Oswald', sans-serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: {{ s.text_color | default: '#0A0A0A' }};
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }
  #gfib-{{ uid }} .gfib-line { white-space: nowrap; display: block; transform-origin: center; }
  #gfib-{{ uid }} .gfib-l1, #gfib-{{ uid }} .gfib-l2 { font-size: {{ fsA }}px; }
  #gfib-{{ uid }} .gfib-l3 { font-size: {{ fsB }}px; }
  @media (max-width: 749px) {
    #gfib-{{ uid }} { width: {{ bwm }}px; }
    #gfib-{{ uid }} .gfib-l1, #gfib-{{ uid }} .gfib-l2 { font-size: {{ fsAm }}px; }
    #gfib-{{ uid }} .gfib-l3 { font-size: {{ fsBm }}px; }
  }
</style>
<div id="gfib-{{ uid }}" {{ block.shopify_attributes }} aria-hidden="true">
  <div class="gfib-inner">
  <svg class="gfib-shape" viewBox="0 0 200 200" aria-hidden="true"><polygon fill="{{ s.bg_color | default: '#C5FE89' }}" points="192.0,100.0 191.3,104.1 189.4,108.0 186.5,111.7 183.3,115.1 180.2,118.3 177.7,121.4 176.1,124.7 175.4,128.3 175.6,132.3 176.3,136.7 176.9,141.4 177.0,146.0 176.3,150.4 174.4,154.1 171.5,157.0 167.6,159.1 163.1,160.4 158.5,161.2 154.1,161.9 150.2,163.0 147.0,164.7 144.4,167.2 142.2,170.6 140.1,174.6 137.9,178.7 135.3,182.5 132.1,185.6 128.4,187.5 124.3,188.1 120.0,187.5 115.6,185.9 111.4,183.9 107.4,181.9 103.6,180.5 100.0,180.0 96.4,180.5 92.6,181.9 88.6,183.9 84.4,185.9 80.0,187.5 75.7,188.1 71.6,187.5 67.9,185.6 64.7,182.5 62.1,178.7 59.9,174.6 57.8,170.6 55.6,167.2 53.0,164.7 49.8,163.0 45.9,161.9 41.5,161.2 36.9,160.4 32.4,159.1 28.5,157.0 25.6,154.1 23.7,150.4 23.0,146.0 23.1,141.4 23.7,136.7 24.4,132.3 24.6,128.3 23.9,124.7 22.3,121.4 19.8,118.3 16.7,115.1 13.5,111.7 10.6,108.0 8.7,104.1 8.0,100.0 8.7,95.9 10.6,92.0 13.5,88.3 16.7,84.9 19.8,81.7 22.3,78.6 23.9,75.3 24.6,71.7 24.4,67.7 23.7,63.3 23.1,58.6 23.0,54.0 23.7,49.6 25.6,45.9 28.5,43.0 32.4,40.9 36.9,39.6 41.5,38.8 45.9,38.1 49.8,37.0 53.0,35.3 55.6,32.8 57.8,29.4 59.9,25.4 62.1,21.3 64.7,17.5 67.9,14.4 71.6,12.5 75.7,11.9 80.0,12.5 84.4,14.1 88.6,16.1 92.6,18.1 96.4,19.5 100.0,20.0 103.6,19.5 107.4,18.1 111.4,16.1 115.6,14.1 120.0,12.5 124.3,11.9 128.4,12.5 132.1,14.4 135.3,17.5 137.9,21.3 140.1,25.4 142.2,29.4 144.4,32.8 147.0,35.3 150.2,37.0 154.1,38.1 158.5,38.8 163.1,39.6 167.6,40.9 171.5,43.0 174.4,45.9 176.3,49.6 177.0,54.0 176.9,58.6 176.3,63.3 175.6,67.7 175.4,71.7 176.1,75.3 177.7,78.6 180.2,81.7 183.3,84.9 186.5,88.3 189.4,92.0 191.3,95.9"/></svg>
  <div class="gfib-text" translate="no">
    <span class="gfib-line gfib-l1">{{ l1 }}</span>
    {%- if l2 != blank -%}<span class="gfib-line gfib-l2">{{ l2 }}</span>{%- endif -%}
    {%- if bf_l3 != blank -%}
      {%- if l3 != blank -%}<span class="gfib-line gfib-l3 gf-nobf">{{ l3 }}</span>{%- endif -%}
      <span class="gfib-line gfib-l3 gf-bf-only">{{ bf_l3 }}</span>
    {%- elsif l3 != blank -%}<span class="gfib-line gfib-l3">{{ l3 }}</span>{%- endif -%}
  </div>
  </div>
</div>
{%- if settings.gf_hw_enabled and settings.gf_hw_spider -%}
  {%- comment -%} Mode Halloween : toile dans le coin et araignée au bout de son fil, sur la première photo seulement {%- endcomment -%}
  <div id="gfib-hw-{{ uid }}" class="gfib-hw" aria-hidden="true">
    <svg class="gfib-hw-web" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width=".7" stroke-linecap="round" aria-hidden="true"><path d="M100 0L-3.4 10.9M100 0L8.2 48.8M100 0L33.2 79.7M100 0L67.9 98.9M100 0L100.0 104.0M76.1 2.5Q80.6 5.9 78.8 11.3Q84.3 12.8 84.6 18.4Q90.2 17.7 92.6 22.8Q96.8 20.1 100.0 24.0M54.3 4.8Q62.9 11.4 59.4 21.6Q69.8 24.4 70.4 35.2Q81.2 34.0 85.8 43.7Q93.9 38.6 100.0 46.0M32.4 7.1Q45.1 16.8 40.0 31.9Q55.4 36.1 56.3 52.1Q72.2 50.2 79.0 64.7Q91.0 57.0 100.0 68.0M10.5 9.4Q27.3 22.2 20.5 42.3Q41.0 47.8 42.1 68.9Q63.2 66.5 72.2 85.6Q88.0 75.5 100.0 90.0"/></svg>
    <div class="gfib-hw-spider"><svg viewBox="0 0 40 40" aria-hidden="true"><g fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 20L9 15 5 18M15 23.5L7.5 22.5 3.5 26.5M15.5 27L9 30 6 35M17 29.5L12.5 34.5 11 39"/><path d="M24.5 20L31 15 35 18M25 23.5L32.5 22.5 36.5 26.5M24.5 27L31 30 34 35M23 29.5L27.5 34.5 29 39"/></g><ellipse cx="20" cy="25" rx="5.6" ry="6.6" fill="#111"/><circle cx="20" cy="16.5" r="3.8" fill="#111"/><circle cx="18.6" cy="16" r=".95" fill="var(--gf-hw, #FF7518)"/><circle cx="21.4" cy="16" r=".95" fill="var(--gf-hw, #FF7518)"/></svg></div>
  </div>
{%- endif -%}
{%- if gf_bf_on == '1' and settings.gf_bf_band_title != blank -%}
  {%- comment -%} Mode Black Friday : bandeau Bali en bas de la première photo (déplacé dans la galerie avec le badge) {%- endcomment -%}
  <div id="gfib-bf-{{ uid }}" class="gfib-bf gf-bf-only" aria-hidden="true">
    {%- if settings.gf_bf_photo != blank -%}
      <img class="gfib-bf-img" src="{{ settings.gf_bf_photo | image_url: width: 1200 }}" srcset="{{ settings.gf_bf_photo | image_url: width: 600 }} 600w, {{ settings.gf_bf_photo | image_url: width: 900 }} 900w, {{ settings.gf_bf_photo | image_url: width: 1200 }} 1200w" sizes="(max-width: 749px) 100vw, 640px" alt="" loading="lazy">
    {%- else -%}
      <img class="gfib-bf-img" src="{{ 'gf-bf-bali.jpg' | asset_img_url: '1200x' }}" srcset="{{ 'gf-bf-bali.jpg' | asset_img_url: '600x' }} 600w, {{ 'gf-bf-bali.jpg' | asset_img_url: '900x' }} 900w, {{ 'gf-bf-bali.jpg' | asset_img_url: '1200x' }} 1200w" sizes="(max-width: 749px) 100vw, 640px" alt="" loading="lazy">
    {%- endif -%}
    <div class="gfib-bf-txt">
      <p class="gfib-bf-t">{{ settings.gf_bf_band_title }}</p>
      {%- if settings.gf_bf_band_value != blank -%}<p class="gfib-bf-v">{{ settings.gf_bf_band_value }}</p>{%- endif -%}
      {%- if settings.gf_bf_band_note != blank -%}
        {%- liquid
          comment — [date] = date du jour en toutes lettres (« samedi 30 novembre », « dimanche 1er novembre ») ; le script la recalcule à l'heure de Paris pour les pages en cache
          endcomment
          assign gfd_days = 'dimanche,lundi,mardi,mercredi,jeudi,vendredi,samedi' | split: ','
          assign gfd_months = 'janvier,février,mars,avril,mai,juin,juillet,août,septembre,octobre,novembre,décembre' | split: ','
          assign gfd_w = 'now' | date: '%w' | plus: 0
          assign gfd_m = 'now' | date: '%m' | plus: 0 | minus: 1
          assign gfd_d = 'now' | date: '%d' | plus: 0
          assign gfd_day = gfd_d | append: ''
          if gfd_d == 1
            assign gfd_day = '1er'
          endif
          assign gfd_txt = gfd_days[gfd_w] | append: ' ' | append: gfd_day | append: ' ' | append: gfd_months[gfd_m]
          assign gfd_html = '<span class="gfib-bf-d" data-gf-bf-today>' | append: gfd_txt | append: '</span>'
          assign band_note = settings.gf_bf_band_note | replace: '[date]', gfd_html
        -%}
        <p class="gfib-bf-c">{{ band_note }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
{%- if vb_src != blank -%}
  {%- capture vb_html -%}
    <button type="button" class="gfvb" id="gfvb-{{ uid }}" aria-label="{{ s.vb_label | default: 'Voir la vidéo' | escape }}" data-hd="{{ vb_src_hd }}">
      <span class="gfvb-clip"><video class="gfvb-v" src="{{ vb_src }}"{% if vb_poster != blank %} poster="{{ vb_poster }}"{% endif %} muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1"></video></span>
      <svg class="gfvb-ring" viewBox="0 0 100 100" aria-hidden="true"><circle class="gfvb-track" cx="50" cy="50" r="48.5"/><circle class="gfvb-prog" cx="50" cy="50" r="48.5" pathLength="100"/></svg>
      <span class="gfvb-exp" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M10 20H4v-6"/><path d="M20 4l-6.5 6.5"/><path d="M4 20l6.5-6.5"/></svg></span>
    </button>
    <dialog class="gfvb-dlg" id="gfvb-dlg-{{ uid }}" aria-label="{{ s.vb_label | default: 'Vidéo' | escape }}">
      <video class="gfvb-dv"{% if vb_poster != blank %} poster="{{ vb_poster | replace: 'width=480', 'width=900' }}"{% endif %} muted loop playsinline preload="none"></video>
      {%- if s.vb_caption != blank -%}<p class="gfvb-cap">{{ s.vb_caption }}</p>{%- endif -%}
      <button type="button" class="gfvb-btn gfvb-x" data-gfvb-close aria-label="Fermer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      <button type="button" class="gfvb-btn gfvb-snd" data-gfvb-sound aria-label="Activer le son" aria-pressed="false">
        <svg class="gfvb-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M22 9l-6 6M16 9l6 6"/></svg>
        <svg class="gfvb-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M15.5 8.5a5 5 0 010 7"/><path d="M18.5 5.5a9 9 0 010 13"/></svg>
      </button>
    </dialog>
  {%- endcapture -%}
  {%- if s.vb_enabled -%}{{ vb_html }}{%- else -%}<template id="gfvb-tpl-{{ uid }}">{{ vb_html }}</template>{%- endif -%}
{%- endif -%}
<style>
  /* Wrapper hors du flux + badge invisible tant qu'il n'est pas posé sur la galerie (évite le saut de 22 px et le flash) */
  #shopify-block-{{ block.id }} { position:absolute !important; width:0 !important; height:0 !important; min-height:0 !important; margin:0 !important; padding:0 !important; border:0 !important; overflow:hidden !important; }
  #gfib-{{ uid }} { opacity:0; transition: opacity .25s ease; }
  {%- if settings.gf_hw_orange %}
  html.gf-hw #gfib-{{ uid }} .gfib-shape polygon { fill: var(--gf-hw); }
  {%- endif %}
  #gfib-hw-{{ uid }} { display:none; position:absolute; top:0; right:0; left:auto; bottom:auto; width:30%; height:170px; z-index:3; pointer-events:none; overflow:hidden; opacity:0; transition:opacity .25s ease; }
  html.gf-hw #gfib-hw-{{ uid }} { display:block; }
  {%- if gf_bf_on == '1' %}
  html:not(.gf-bf) #gfib-{{ uid }} .gf-bf-only, html:not(.gf-bf) #gfib-bf-{{ uid }}, html.gf-bf #gfib-{{ uid }} .gf-nobf { display:none !important; }
  {%- if settings.gf_bf_badge_dark %}
  html.gf-bf #gfib-{{ uid }} .gfib-shape polygon { fill: var(--gf-bf-dark); }
  html.gf-bf #gfib-{{ uid }} .gfib-text { color: var(--gf-bf-lime); }
  {%- endif %}
  #gfib-bf-{{ uid }} { position:absolute; left:0; right:0; bottom:0; z-index:3; pointer-events:none; overflow:hidden; opacity:0; transition:opacity .25s ease; border-radius:0 0 var(--media-radius, 0px) var(--media-radius, 0px); background:#18241a; }
  #gfib-bf-{{ uid }} .gfib-bf-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 60%; }
  #gfib-bf-{{ uid }}::after { content:''; position:absolute; inset:0; background:linear-gradient(90deg, rgba(8,12,9,.88) 0%, rgba(8,12,9,.72) 32%, rgba(8,12,9,.3) 58%, rgba(8,12,9,0) 78%); }
  #gfib-bf-{{ uid }} .gfib-bf-txt { position:relative; z-index:1; padding:22px 28px; color:#fff; text-shadow:0 1px 10px rgba(0,0,0,.35); }
  #gfib-bf-{{ uid }} p { margin:0; }
  #gfib-bf-{{ uid }} .gfib-bf-t { font-family:var(--font-heading--family, 'Oswald', sans-serif); font-weight:700; text-transform:uppercase; font-size:30px; line-height:1.08; letter-spacing:.01em; }
  #gfib-bf-{{ uid }} .gfib-bf-v { margin-top:4px; font-size:19px; font-weight:600; line-height:1.3; }
  #gfib-bf-{{ uid }} .gfib-bf-c { margin-top:10px; max-width:420px; font-size:13px; line-height:1.4; color:rgba(255,255,255,.86); }
  #gfib-bf-{{ uid }} b, #gfib-bf-{{ uid }} strong { color:var(--gf-bf-lime); font-weight:700; }
  #gfib-bf-{{ uid }} .gfib-bf-d { color:#fff; font-weight:700; }
  @media screen and (max-width: 749px) {
    #gfib-bf-{{ uid }} .gfib-bf-txt { padding:14px 16px; }
    #gfib-bf-{{ uid }} .gfib-bf-t { font-size:21px; }
    #gfib-bf-{{ uid }}::after { background:linear-gradient(90deg, rgba(8,12,9,.88) 0%, rgba(8,12,9,.7) 40%, rgba(8,12,9,.32) 68%, rgba(8,12,9,0) 92%); }
    #gfib-bf-{{ uid }} .gfib-bf-v { margin-top:2px; font-size:15.5px; }
    #gfib-bf-{{ uid }} .gfib-bf-c { margin-top:6px; font-size:11.5px; max-width:300px; }
  }
  {%- endif %}
  {%- if vb_src != blank %}
  /* bulle vidéo */
  #gfvb-{{ uid }} { --gfvb-accent:{{ vb_accent }}; position:absolute; top:14px; right:14px; z-index:4; width:{{ vb_size }}px; height:{{ vb_size }}px; margin:0; padding:0; border:0; border-radius:50%; background:none; cursor:pointer; opacity:0; transition:opacity .25s ease, transform .35s cubic-bezier(.2,.8,.2,1); filter:drop-shadow(0 10px 18px rgba(6,32,32,.28)); -webkit-tap-highlight-color:transparent; }
  @media (hover:hover) { #gfvb-{{ uid }}:hover { transform:scale(1.05); } }
  #gfvb-{{ uid }}:focus-visible { outline:2px solid var(--gfvb-accent); outline-offset:4px; }
  #gfvb-{{ uid }} .gfvb-clip { position:absolute; inset:5px; border-radius:50%; overflow:hidden; background:#0f1c1c; }
  #gfvb-{{ uid }} .gfvb-clip::after { content:''; position:absolute; inset:0; border-radius:50%; box-shadow:inset 0 0 0 2px rgba(255,255,255,.9); pointer-events:none; }
  #gfvb-{{ uid }} .gfvb-v { display:block; width:100%; height:100%; object-fit:cover; object-position:50% {{ vb_focus }}%; transform:scale({{ vb_zoom }}); transform-origin:50% {{ vb_focus }}%; }
  #gfvb-{{ uid }} .gfvb-ring { position:absolute; inset:0; width:100%; height:100%; transform:rotate(-90deg); overflow:visible; }
  #gfvb-{{ uid }} .gfvb-track { fill:none; stroke:#fff; stroke-width:3; }
  #gfvb-{{ uid }} .gfvb-prog { fill:none; stroke:var(--gfvb-accent); stroke-width:3; stroke-linecap:round; stroke-dasharray:100; stroke-dashoffset:100; }
  #gfvb-{{ uid }} .gfvb-exp { position:absolute; right:1px; bottom:3px; width:26px; height:26px; border-radius:50%; background:#fff; color:#111; display:grid; place-items:center; box-shadow:0 2px 8px rgba(0,0,0,.18); }
  #gfvb-{{ uid }} .gfvb-exp svg { width:12px; height:12px; }
  dialog#gfvb-dlg-{{ uid }} { --gfvb-accent:{{ vb_accent }}; width:min(440px, calc(100vw - 32px)); max-width:none; max-height:calc(100vh - 48px); margin:auto; padding:0; border:0; border-radius:28px; overflow:hidden; background:#0f1c1c; box-shadow:0 40px 100px rgba(0,0,0,.45); }
  dialog#gfvb-dlg-{{ uid }}::backdrop { background:rgba(8,16,16,.62); }
  dialog#gfvb-dlg-{{ uid }}[open]::backdrop { animation:gfvb-fade .3s ease; }
  @keyframes gfvb-fade { from { opacity:0; } to { opacity:1; } }
  dialog#gfvb-dlg-{{ uid }}::after { content:''; position:absolute; inset:auto 0 0; height:45%; background:linear-gradient(transparent, rgba(0,0,0,.55)); pointer-events:none; }
  #gfvb-dlg-{{ uid }} .gfvb-dv { display:block; width:100%; height:auto; max-height:calc(100vh - 48px); object-fit:cover; }
  #gfvb-dlg-{{ uid }} .gfvb-cap { position:absolute; left:22px; right:76px; bottom:20px; z-index:1; margin:0; color:#fff; font-family:var(--font-heading--family, 'Oswald', sans-serif); font-weight:700; text-transform:uppercase; font-size:24px; line-height:1.05; letter-spacing:.01em; }
  #gfvb-dlg-{{ uid }} .gfvb-btn { position:absolute; z-index:2; right:16px; width:40px; height:40px; padding:0; border:0; border-radius:50%; background:rgba(255,255,255,.94); color:#111; display:grid; place-items:center; cursor:pointer; }
  #gfvb-dlg-{{ uid }} .gfvb-btn svg { width:18px; height:18px; }
  #gfvb-dlg-{{ uid }} .gfvb-x { top:16px; }
  #gfvb-dlg-{{ uid }} .gfvb-snd { bottom:16px; }
  #gfvb-dlg-{{ uid }} .gfvb-on, #gfvb-dlg-{{ uid }} .gfvb-snd[aria-pressed="true"] .gfvb-off { display:none; }
  #gfvb-dlg-{{ uid }} .gfvb-snd[aria-pressed="true"] .gfvb-on { display:block; }
  html.gfvb-lock { overflow:hidden; }
  @media screen and (max-width: 749px) {
    #gfvb-{{ uid }} { top:10px; right:10px; width:{{ vb_size_m }}px; height:{{ vb_size_m }}px; }
    #gfvb-{{ uid }} .gfvb-clip { inset:4px; }
    #gfvb-{{ uid }} .gfvb-exp { width:22px; height:22px; right:0; bottom:1px; }
    #gfvb-{{ uid }} .gfvb-exp svg { width:11px; height:11px; }
    dialog#gfvb-dlg-{{ uid }} { width:calc(100vw - 24px); border-radius:24px; }
    #gfvb-dlg-{{ uid }} .gfvb-cap { font-size:21px; left:18px; bottom:18px; }
  }
  {%- endif %}
  #gfib-hw-{{ uid }} .gfib-hw-web { position:absolute; top:0; right:0; width:min(150px, 100%); height:auto; color:#0f1a1a; opacity:.38; }
  #gfib-hw-{{ uid }} .gfib-hw-spider { position:absolute; top:0; right:50%; display:flex; flex-direction:column; align-items:center; animation:gfib-hw-bob 3.2s ease-in-out infinite alternate; }
  #gfib-hw-{{ uid }} .gfib-hw-spider::before { content:''; display:block; width:1px; height:110px; background:rgba(15,26,26,.55); }
  #gfib-hw-{{ uid }} .gfib-hw-spider svg { width:30px; height:30px; margin-top:-3px; }
  @keyframes gfib-hw-bob { from { transform:translateY(-6px); } to { transform:translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { #gfib-hw-{{ uid }} .gfib-hw-spider { animation:none; } }
  @media screen and (max-width: 749px) {
    #gfib-hw-{{ uid }} { width:32%; height:110px; }
    #gfib-hw-{{ uid }} .gfib-hw-web { width:96px; }
    #gfib-hw-{{ uid }} .gfib-hw-spider { right:37.5%; }
    #gfib-hw-{{ uid }} .gfib-hw-spider::before { height:70px; }
    #gfib-hw-{{ uid }} .gfib-hw-spider svg { width:24px; height:24px; }
  }
</style>
<script>
  (function () {
    var badge = document.getElementById('gfib-{{ uid }}');
    if (!badge) return;
    var hw = document.getElementById('gfib-hw-{{ uid }}');
    var bf = document.getElementById('gfib-bf-{{ uid }}');
    /* bandeau Bali : date du jour à l'heure de Paris (la date rendue par le serveur peut venir du cache) */
    var today = bf && bf.querySelector('[data-gf-bf-today]');
    if (today) {
      try {
        var o = {};
        new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', weekday: 'long', day: 'numeric', month: 'long' })
          .formatToParts(new Date()).forEach(function (x) { o[x.type] = x.value; });
        today.textContent = o.weekday + ' ' + (o.day === '1' ? '1er' : o.day) + ' ' + o.month;
      } catch (e) {}
    }
    /* bulle vidéo : en aperçu (?gf_rond=1), le <template> est copié dans la page */
    var vbTpl = document.getElementById('gfvb-tpl-{{ uid }}');
    if (vbTpl && /[?&]gf_rond=1(&|$)/.test(location.search)) vbTpl.parentNode.insertBefore(vbTpl.content.cloneNode(true), vbTpl);
    var vb = document.getElementById('gfvb-{{ uid }}');
    var vbDlg = document.getElementById('gfvb-dlg-{{ uid }}');
    var vbOn = false;
    var placed = false;
    var myWrap = badge.closest('[id^="shopify-block-"]');
    function collapseWrap() {
      if (myWrap && !myWrap.contains(badge)) {
        /* position:absolute = hors du flux flex → ne génère plus de gap (le badge a déjà été déplacé dans la galerie) */
        myWrap.style.cssText += ';position:absolute!important;width:0!important;height:0!important;min-height:0!important;margin:0!important;padding:0!important;border:0!important;overflow:hidden!important;';
      }
    }
    function gallery() { return document.querySelector('media-gallery'); }
    function host() {
      var g = gallery();
      if (!g) return null;
      return g.querySelector('slideshow-container') || g.querySelector('.product-media-container') || g;
    }
    function onFirstSlide() {
      /* première slide VISIBLE (pas la première du DOM : elle peut être une
         image masquée #checkout dont l'aria-hidden ne passe jamais à false) */
      var g = gallery();
      if (!g) return true;
      var slides = g.querySelectorAll('slideshow-slide');
      for (var i = 0; i < slides.length; i++) {
        if (slides[i].offsetWidth > 0) return slides[i].getAttribute('aria-hidden') !== 'true';
      }
      return true;
    }
    function updateVis() {
      badge.style.opacity = (placed && onFirstSlide()) ? '1' : '0';
      if (hw) hw.style.opacity = badge.style.opacity;
      if (bf) bf.style.opacity = badge.style.opacity;
      if (vb) { vb.style.opacity = badge.style.opacity; vbPlay(badge.style.opacity === '1'); }
    }
    /* bulle vidéo : lecture seulement quand elle est visible, anneau = avancement de la boucle */
    var vbV = vb && vb.querySelector('.gfvb-v'), vbProg = vb && vb.querySelector('.gfvb-prog'), vbRaf = 0, vbSeen = true;
    var vbReduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    /* une vidéo copiée depuis un <template> ne prend pas l'attribut muted : sans ça, le navigateur bloque la lecture automatique */
    if (vbV) { vbV.muted = true; vbV.defaultMuted = true; }
    function vbTick() { if (vbV && vbV.duration) vbProg.style.strokeDashoffset = String(100 - vbV.currentTime / vbV.duration * 100); vbRaf = requestAnimationFrame(vbTick); }
    function vbPlay(want) {
      if (!vbV) return;
      want = want && vbSeen && !vbReduce && !(vbDlg && vbDlg.open);
      if (want === vbOn) return;
      vbOn = want;
      if (want) { var pr = vbV.play(); if (pr && pr.catch) pr.catch(function () {}); if (!vbRaf) vbTick(); }
      else { vbV.pause(); cancelAnimationFrame(vbRaf); vbRaf = 0; }
    }
    if (vb && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { vbSeen = es[0].isIntersecting; vbPlay(vb.style.opacity === '1'); }, { threshold: 0.2 }).observe(vb);
    }
    if (vb && vbDlg && typeof vbDlg.showModal === 'function') {
      document.body.appendChild(vbDlg);
      var vbDV = vbDlg.querySelector('.gfvb-dv'), vbSnd = vbDlg.querySelector('[data-gfvb-sound]');
      var vbEase = 'cubic-bezier(.2,.8,.2,1)';
      function vbMorph(reverse) {
        if (vbReduce || !vbDlg.animate) return null;
        var a = vb.getBoundingClientRect(), b = vbDlg.getBoundingClientRect();
        var from = { transform: 'translate(' + ((a.left + a.width / 2) - (b.left + b.width / 2)) + 'px,' + ((a.top + a.height / 2) - (b.top + b.height / 2)) + 'px) scale(' + (a.width / b.width) + ',' + (a.height / b.height) + ')', borderRadius: '50%' };
        var to = { transform: 'none', borderRadius: getComputedStyle(vbDlg).borderTopLeftRadius };
        return vbDlg.animate(reverse ? [to, from] : [from, to], { duration: reverse ? 300 : 440, easing: vbEase });
      }
      vb.addEventListener('click', function () {
        if (!vbDV.src) vbDV.src = vb.getAttribute('data-hd');
        vbDlg.showModal();
        document.documentElement.classList.add('gfvb-lock');
        vbPlay(false);
        var t0 = vbV.currentTime || 0;
        if (vbDV.readyState >= 1) { try { vbDV.currentTime = t0; } catch (e) {} }
        else vbDV.addEventListener('loadedmetadata', function () { try { vbDV.currentTime = t0; } catch (e) {} }, { once: true });
        var pr = vbDV.play(); if (pr && pr.catch) pr.catch(function () {});
        vbMorph(false);
      });
      function vbClose() {
        var an = vbMorph(true);
        var done = function () { vbDlg.close(); };
        if (an) an.onfinish = done; else done();
      }
      vbDlg.addEventListener('close', function () {
        vbDV.pause(); vbDV.muted = true; vbSnd.setAttribute('aria-pressed', 'false'); vbSnd.setAttribute('aria-label', 'Activer le son');
        document.documentElement.classList.remove('gfvb-lock');
        vbPlay(vb.style.opacity === '1');
      });
      vbDlg.addEventListener('cancel', function (e) { e.preventDefault(); vbClose(); });
      vbDlg.addEventListener('click', function (e) {
        if (e.target === vbDlg || e.target.closest('[data-gfvb-close]')) { vbClose(); return; }
        if (e.target.closest('[data-gfvb-sound]')) {
          vbDV.muted = !vbDV.muted;
          vbSnd.setAttribute('aria-pressed', String(!vbDV.muted));
          vbSnd.setAttribute('aria-label', vbDV.muted ? 'Activer le son' : 'Couper le son');
        }
      });
    }
    function fitText() {
      var lines = badge.querySelectorAll('.gfib-line');
      var box = badge.offsetWidth;
      if (!box) return;
      var maxW = box * 0.78, i, el, widths = [];
      for (i = 0; i < lines.length; i++) { lines[i].style.fontSize = ''; }
      for (i = 0; i < lines.length; i++) { widths[i] = lines[i].offsetWidth; }
      for (i = 0; i < lines.length; i++) {
        el = lines[i];
        if (widths[i] > maxW && widths[i] > 0) {
          var base = parseFloat(getComputedStyle(el).fontSize);
          el.style.fontSize = (base * maxW / widths[i]).toFixed(2) + 'px';
        }
      }
    }
    function place() {
      var h = host();
      if (!h) return;
      if (getComputedStyle(h).position === 'static') h.style.position = 'relative';
      if (badge.parentNode !== h) h.appendChild(badge);
      if (hw && hw.parentNode !== h) h.appendChild(hw);
      if (bf && bf.parentNode !== h) h.appendChild(bf);
      if (vb && vb.parentNode !== h) h.appendChild(vb);
      collapseWrap();
      placed = true;
      fitText();
      updateVis();
    }
    function init() {
      place();
      if (document.fonts && document.fonts.ready) { document.fonts.ready.then(fitText); }
      window.addEventListener('resize', fitText);
      var g = gallery();
      if (!g || !window.MutationObserver) return;
      var mo = new MutationObserver(function () {
        if (!document.contains(badge)) place();
        updateVis();
      });
      mo.observe(g, { subtree: true, attributes: true, attributeFilter: ['aria-hidden'] });
    }
    /* la galerie est déjà dans le HTML au-dessus : pose immédiate (attendre DOMContentLoaded
       = attendre tous les scripts du thème, jusqu'à 40 s sur réseau lent) */
    if (document.readyState !== 'loading' || gallery()) init(); else document.addEventListener('DOMContentLoaded', init);
    window.addEventListener('load', function () { place(); fitText(); });
  })();
</script>
{%- endif -%}
{% schema %}
{
  "name": "GF Badge image",
  "settings": [
    { "type": "paragraph", "content": "Seal rond festonne pose en overlay sur la photo produit. Disparait au swipe. Texte HTML (ne se coupe jamais). A ajouter une fois sur la page produit." },
    { "type": "checkbox", "id": "show_badge", "label": "Afficher le badge", "default": true },
    { "type": "header", "content": "Texte (3 lignes courtes)" },
    { "type": "text", "id": "txt1", "label": "Ligne 1", "default": "2 SACHETS" },
    { "type": "text", "id": "txt2", "label": "Ligne 2", "default": "OFFERTS" },
    { "type": "text", "id": "txt3", "label": "Ligne 3", "default": "AUJOURD'HUI" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "bg_color", "label": "Fond", "default": "#C5FE89" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#0A0A0A" },
    { "type": "header", "content": "Position & taille" },
    {
      "type": "select", "id": "position", "label": "Position", "default": "top-left",
      "options": [
        { "value": "top-left", "label": "Haut gauche" },
        { "value": "top-center", "label": "Haut centre" },
        { "value": "top-right", "label": "Haut droite" },
        { "value": "middle-center", "label": "Centre" },
        { "value": "bottom-left", "label": "Bas gauche" },
        { "value": "bottom-center", "label": "Bas centre" },
        { "value": "bottom-right", "label": "Bas droite" }
      ]
    },
    { "type": "range", "id": "badge_w", "label": "Largeur (ordinateur)", "min": 100, "max": 300, "step": 5, "default": 140, "unit": "px" },
    { "type": "range", "id": "badge_w_mobile", "label": "Largeur (mobile)", "min": 80, "max": 220, "step": 4, "default": 108, "unit": "px" },
    { "type": "range", "id": "rotation", "label": "Inclinaison", "min": -20, "max": 20, "step": 1, "default": -8, "unit": "deg" },
    { "type": "range", "id": "offset_x", "label": "Decalage horizontal", "min": -200, "max": 200, "step": 4, "default": 12, "unit": "px" },
    { "type": "range", "id": "offset_y", "label": "Decalage vertical (depuis le bord)", "min": 0, "max": 200, "step": 2, "default": 14, "unit": "px" },
    { "type": "checkbox", "id": "shadow", "label": "Ombre portee", "default": true },
    { "type": "header", "content": "Bulle vidéo (en haut à droite)" },
    { "type": "checkbox", "id": "vb_enabled", "label": "Afficher la bulle vidéo", "default": false, "info": "Aperçu sans l'afficher : ajoute ?gf_rond=1 à l'adresse de la page produit." },
    { "type": "text", "id": "vb_video_url", "label": "Lien de la vidéo (MP4)", "info": "Contenu › Fichiers › la vidéo › Copier le lien. Vide = la première vidéo du produit." },
    { "type": "range", "id": "vb_size", "label": "Taille (ordinateur)", "min": 72, "max": 160, "step": 4, "unit": "px", "default": 108 },
    { "type": "range", "id": "vb_size_mobile", "label": "Taille (mobile)", "min": 56, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "vb_zoom", "label": "Zoom dans la vidéo", "min": 100, "max": 250, "step": 10, "unit": "%", "default": 150 },
    { "type": "range", "id": "vb_focus", "label": "Cadrage vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30, "info": "0 = haut de la vidéo, 100 = bas." },
    { "type": "color", "id": "vb_accent", "label": "Couleur de l'anneau", "default": "#2AB5B4" },
    { "type": "text", "id": "vb_caption", "label": "Légende de la vidéo agrandie", "default": "Le masséter en action" },
    { "type": "text", "id": "vb_label", "label": "Description pour les lecteurs d'écran", "default": "Voir la vidéo : le masséter en action" },
    { "type": "header", "content": "Animation" },
    {
      "type": "select", "id": "anim", "label": "Animation au depart", "default": "pulse",
      "options": [
        { "value": "none", "label": "Aucune" },
        { "value": "pulse", "label": "Pulse (en continu)" },
        { "value": "pop", "label": "Pop (a l'apparition)" }
      ]
    }
  ],
  "presets": [{ "name": "GF Badge image" }]
}
{% endschema %}
