{% comment %}
  ============================================================================
  GUMFORCE Real Results — Premium Before / After Cards
  ============================================================================
  State-of-the-art transformation showcase. Three polished cards with:
    - Split before/after with frosted-glass labels + elegant divider
    - Gradient card backgrounds with depth shadows + hover lift
    - Client info hierarchy: name, badge, pill, meta, quote, stars
    - Micro-interactions: image zoom on hover, card lift, label reveal
    - Light-mode default. Fully theme-customizable.
  ============================================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s   = section.settings

  assign bg_color         = s.bg_color | default: '#F5F5F3'
  assign card_grad_start  = s.card_grad_start | default: '#FFFFFF'
  assign card_grad_end    = s.card_grad_end | default: '#F0EFED'
  assign card_radius      = s.card_radius | default: 16
  assign card_shadow_color = s.card_shadow_color | default: 'rgba(0,0,0,0.06)'

  assign heading        = s.heading
  assign heading_tag    = s.heading_tag | default: 'h2'
  assign heading_size   = s.heading_size | default: 38
  assign heading_color  = s.heading_color | default: '#111111'
  assign subheading     = s.subheading
  assign subheading_size = s.subheading_size | default: 16
  assign subheading_color = s.subheading_color | default: '#777777'

  assign accent_color     = s.accent_color | default: '#2AB5B4'
  assign pill_bg_color    = s.pill_bg_color | default: '#2AB5B4'
  assign name_color       = s.name_color | default: '#111111'
  assign meta_color       = s.meta_color | default: '#999999'
  assign quote_color      = s.quote_color | default: '#555555'
  assign star_color       = s.star_color | default: '#F5A623'
  assign divider_color    = s.divider_color | default: 'rgba(255,255,255,0.7)'
  assign pill_text_color  = s.pill_text_color | default: '#FFFFFF'
  assign verified_color   = s.verified_color | default: '#999999'

  assign verified_image     = s.verified_badge_image
  assign verified_image_url = s.verified_badge_url
  assign verified_badge_h   = s.verified_badge_height | default: 16

  assign image_ratio    = s.image_ratio | default: '4:5'
  assign cards_gap      = s.cards_gap | default: 28

  assign pad_top        = s.padding_top | default: 80
  assign pad_bottom     = s.padding_bottom | default: 80
  assign pad_top_mobile = s.padding_top_mobile | default: 48
  assign pad_bot_mobile = s.padding_bottom_mobile | default: 48

  assign enable_animations = s.enable_animations

  if request.locale.iso_code == 'fr'
    assign label_before     = 'Avant'
    assign label_after      = 'Après'
    assign verified_alt     = 'Vérifié'
    assign verified_purchase = 'Achat vérifié'
  else
    assign label_before     = 'Before'
    assign label_after      = 'After'
    assign verified_alt     = 'Verified'
    assign verified_purchase = 'Verified Purchase'
  endif

  assign pattern_image   = s.pattern_image
  assign pattern_url     = s.pattern_url
  assign pattern_size    = s.pattern_size | default: 80
  assign pattern_opacity = s.pattern_opacity | default: 5

  assign ratio_value = '125%'
  if image_ratio == '1:1'
    assign ratio_value = '100%'
  elsif image_ratio == '4:5'
    assign ratio_value = '125%'
  elsif image_ratio == '3:4'
    assign ratio_value = '133.33%'
  elsif image_ratio == '2:3'
    assign ratio_value = '150%'
  elsif image_ratio == '16:9'
    assign ratio_value = '56.25%'
  endif
-%}

<style>
  #gfr-{{ sid }} {
    --gfr-bg: {{ bg_color }};
    --gfr-card-grad-start: {{ card_grad_start }};
    --gfr-card-grad-end: {{ card_grad_end }};
    --gfr-card-radius: {{ card_radius }}px;
    --gfr-card-shadow: {{ card_shadow_color }};
    --gfr-heading-size: {{ heading_size }}px;
    --gfr-heading-color: {{ heading_color }};
    --gfr-subheading-size: {{ subheading_size }}px;
    --gfr-subheading-color: {{ subheading_color }};
    --gfr-accent: {{ accent_color }};
    --gfr-pill-bg: {{ pill_bg_color }};
    --gfr-name-color: {{ name_color }};
    --gfr-meta-color: {{ meta_color }};
    --gfr-quote-color: {{ quote_color }};
    --gfr-star-color: {{ star_color }};
    --gfr-divider-color: {{ divider_color }};
    --gfr-pill-text: {{ pill_text_color }};
    --gfr-verified-color: {{ verified_color }};
    --gfr-cards-gap: {{ cards_gap }}px;
    --gfr-ratio: {{ ratio_value }};
    --gfr-pad-top: {{ pad_top }}px;
    --gfr-pad-bot: {{ pad_bottom }}px;
    --gfr-pad-top-m: {{ pad_top_mobile }}px;
    --gfr-pad-bot-m: {{ pad_bot_mobile }}px;

    background-color: var(--gfr-bg);
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  /* ── Background pattern overlay ── */
  {%- liquid
    assign pat_src = ''
    if pattern_url != blank
      assign pat_src = pattern_url
    elsif pattern_image != blank
      assign pat_src = pattern_image | image_url: width: 400
    endif
  -%}
  {%- if pat_src != blank -%}
    #gfr-{{ sid }}::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url('{{ pat_src }}');
      background-repeat: repeat;
      background-size: {{ pattern_size }}px {{ pattern_size }}px;
      opacity: {{ pattern_opacity | times: 0.01 }};
      pointer-events: none;
      z-index: 0;
    }

    #gfr-{{ sid }} .gfr-inner {
      position: relative;
      z-index: 1;
    }
  {%- endif -%}

  #gfr-{{ sid }} *,
  #gfr-{{ sid }} *::before,
  #gfr-{{ sid }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ── Inner ── */
  #gfr-{{ sid }} .gfr-inner {
    max-width: 1340px; padding-block: clamp(48px, 6vw, 88px);
    margin: 0 auto;
    padding: var(--gfr-pad-top-m) 20px var(--gfr-pad-bot-m);
  }

  /* ── Section Header ── */
  #gfr-{{ sid }} .gfr-header {
    text-align: center;
    margin-bottom: 52px;
  }

  #gfr-{{ sid }} .gfr-heading {
    font-size: var(--gfr-heading-size);
    font-weight: 800;
    line-height: 1.12;
    color: var(--gfr-heading-color);
    letter-spacing: -0.015em;
  }

  #gfr-{{ sid }} .gfr-subheading {
    font-size: var(--gfr-subheading-size);
    line-height: 1.5;
    color: var(--gfr-subheading-color);
    margin-top: 10px;
    font-weight: 400;
  }

  /* ── Cards Grid ── */
  #gfr-{{ sid }} .gfr-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gfr-cards-gap);
  }

  /* ── Card ── */
  #gfr-{{ sid }} .gfr-card {
    background: var(--gfr-card-grad-end);
    border-radius: var(--gfr-card-radius);
    overflow: hidden;
    box-shadow:
      0 1px 2px var(--gfr-card-shadow),
      0 4px 16px var(--gfr-card-shadow),
      0 8px 32px var(--gfr-card-shadow);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  @media (hover: hover) {
    #gfr-{{ sid }} .gfr-card:hover {
      transform: translateY(-6px);
      box-shadow:
        0 2px 4px var(--gfr-card-shadow),
        0 8px 24px var(--gfr-card-shadow),
        0 16px 48px var(--gfr-card-shadow);
    }

    #gfr-{{ sid }} .gfr-card:hover .gfr-img-half img {
      transform: scale(1.04);
    }
  }

  /* ── Image Pair ── */
  #gfr-{{ sid }} .gfr-images {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
  }

  #gfr-{{ sid }} .gfr-img-half {
    position: relative;
    overflow: hidden;
    padding-top: var(--gfr-ratio);
  }

  #gfr-{{ sid }} .gfr-img-half img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Empty placeholder */
  #gfr-{{ sid }} .gfr-img-empty {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #e0e0e0 0%, #c8c8c8 100%);
  }

  /* ── Frosted glass labels ── */
  #gfr-{{ sid }} .gfr-label {
    position: absolute;
    bottom: 12px;
    padding: 5px 12px;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #FFFFFF;
    background: rgba(0, 0, 0, 0.35);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    backdrop-filter: blur(12px) saturate(180%);
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    pointer-events: none;
    z-index: 3;
  }

  #gfr-{{ sid }} .gfr-label--before { left: 12px; }
  #gfr-{{ sid }} .gfr-label--after  { right: 12px; }

  /* ── Elegant divider with center diamond ── */
  #gfr-{{ sid }} .gfr-divider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 0;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  #gfr-{{ sid }} .gfr-divider::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1.5px;
    height: 100%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--gfr-divider-color) 15%,
      var(--gfr-divider-color) 85%,
      transparent 100%
    );
  }

  #gfr-{{ sid }} .gfr-divider::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
    width: 8px;
    height: 8px;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 1.5px;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
  }

  /* ── Info Block ── */
  #gfr-{{ sid }} .gfr-info {
    padding: 22px 24px 26px;
    background: linear-gradient(180deg, var(--gfr-card-grad-end) 0%, var(--gfr-card-grad-start) 100%);
  }

  /* Row 1: Name + verified | pill */
  #gfr-{{ sid }} .gfr-info-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 2px;
  }

  #gfr-{{ sid }} .gfr-name-row {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }

  #gfr-{{ sid }} .gfr-name {
    font-size: 17px;
    font-weight: 700;
    color: var(--gfr-name-color);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  #gfr-{{ sid }} .gfr-verified-check {
    width: auto;
    height: 18px;
    flex-shrink: 0;
  }

  /* ── Duration Pill ── */
  #gfr-{{ sid }} .gfr-pill {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gfr-pill-text);
    background: var(--gfr-pill-bg);
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--gfr-pill-bg), transparent 75%);
  }

  /* ── Meta ── */
  #gfr-{{ sid }} .gfr-meta {
    font-size: 13px;
    color: var(--gfr-meta-color);
    line-height: 1.6;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }

  #gfr-{{ sid }} .gfr-meta span + span::before {
    content: " · ";
    margin: 0 2px;
  }

  /* ── Quote ── */
  #gfr-{{ sid }} .gfr-quote {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 14px;
    font-style: italic;
    line-height: 1.55;
    color: var(--gfr-quote-color);
    letter-spacing: 0.005em;
  }

  #gfr-{{ sid }} .gfr-quote::before { content: "\201C"; }
  #gfr-{{ sid }} .gfr-quote::after  { content: "\201D"; }

  /* ── Stars ── */
  #gfr-{{ sid }} .gfr-stars {
    display: flex;
    gap: 2px;
    margin-top: 14px;
  }

  #gfr-{{ sid }} .gfr-stars svg {
    width: 14px;
    height: 14px;
  }

  /* ── Verified Purchase Tag ── */
  #gfr-{{ sid }} .gfr-vp {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 14px;
    font-size: 11px;
    font-weight: 500;
    color: var(--gfr-verified-color);
    letter-spacing: 0.02em;
  }

  #gfr-{{ sid }} .gfr-vp svg,
  #gfr-{{ sid }} .gfr-vp-icon {
    width: auto;
    height: 13px;
    flex-shrink: 0;
  }

  /* ── Bottom row: stars left, verified right ── */
  #gfr-{{ sid }} .gfr-info-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ── Animations ── */
  {%- if enable_animations -%}
    #gfr-{{ sid }} .gfr-fade {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #gfr-{{ sid }} .gfr-fade.gfr-visible {
      opacity: 1;
      transform: translateY(0);
    }

    #gfr-{{ sid }} .gfr-fade-d1 { transition-delay: 0.05s; }
    #gfr-{{ sid }} .gfr-fade-d2 { transition-delay: 0.15s; }
    #gfr-{{ sid }} .gfr-fade-d3 { transition-delay: 0.25s; }
  {%- endif -%}

  /* ── Desktop (768px+) ── */
  @media (min-width: 768px) {
    #gfr-{{ sid }} .gfr-inner {
      padding: var(--gfr-pad-top) 48px var(--gfr-pad-bot);
    }

    #gfr-{{ sid }} .gfr-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1200px) {
    #gfr-{{ sid }} .gfr-inner {
      padding: var(--gfr-pad-top) 64px var(--gfr-pad-bot);
    }
  }

  /* ── Mobile: side-scroll option for 2+ cards ── */
  @media (max-width: 767px) {
    #gfr-{{ sid }} .gfr-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    #gfr-{{ sid }} .gfr-heading {
      font-size: calc(var(--gfr-heading-size) * 0.72);
    }

    #gfr-{{ sid }} .gfr-info {
      padding: 18px 20px 22px;
    }
  }
</style>

<!-- ====================================================================== -->
<!-- HTML                                                                    -->
<!-- ====================================================================== -->
<section
  id="gfr-{{ sid }}"
  class="gfr-section"
  aria-label="{{ heading | default: 'Real Results' | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="gfr-inner">

    {%- if heading != blank or subheading != blank -%}
      <div class="gfr-header {% if enable_animations %}gfr-fade{% endif %}">
        {%- if heading != blank -%}
          <{{ heading_tag }} class="gfr-heading">{{ heading }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="gfr-subheading">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="gfr-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'result_card' -%}
          {%- assign delay_class = '' -%}
          {%- if enable_animations -%}
            {%- case forloop.index -%}
              {%- when 1 -%}{%- assign delay_class = 'gfr-fade gfr-fade-d1' -%}
              {%- when 2 -%}{%- assign delay_class = 'gfr-fade gfr-fade-d2' -%}
              {%- when 3 -%}{%- assign delay_class = 'gfr-fade gfr-fade-d3' -%}
              {%- else -%}{%- assign delay_class = 'gfr-fade gfr-fade-d3' -%}
            {%- endcase -%}
          {%- endif -%}

          <article class="gfr-card {{ delay_class }}" {{ block.shopify_attributes }}>

            <!-- Before / After Images -->
            <div class="gfr-images">
              <div class="gfr-img-half">
                {%- if block.settings.image_before != blank -%}
                  <img
                    src="{{ block.settings.image_before | image_url: width: 600 }}"
                    srcset="{{ block.settings.image_before | image_url: width: 400 }} 400w, {{ block.settings.image_before | image_url: width: 600 }} 600w, {{ block.settings.image_before | image_url: width: 800 }} 800w"
                    sizes="(min-width: 768px) 22vw, 45vw"
                    alt="{{ label_before }} — {{ block.settings.client_name | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="gfr-img-empty"></div>
                {%- endif -%}
                <span class="gfr-label gfr-label--before">{{ label_before }}</span>
              </div>
              <div class="gfr-img-half">
                {%- if block.settings.image_after != blank -%}
                  <img
                    src="{{ block.settings.image_after | image_url: width: 600 }}"
                    srcset="{{ block.settings.image_after | image_url: width: 400 }} 400w, {{ block.settings.image_after | image_url: width: 600 }} 600w, {{ block.settings.image_after | image_url: width: 800 }} 800w"
                    sizes="(min-width: 768px) 22vw, 45vw"
                    alt="{{ label_after }} — {{ block.settings.client_name | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="gfr-img-empty"></div>
                {%- endif -%}
                <span class="gfr-label gfr-label--after">{{ label_after }}</span>
              </div>
              <div class="gfr-divider" aria-hidden="true"></div>
            </div>

            <!-- Info Block -->
            <div class="gfr-info">
              <div class="gfr-info-top">
                <div class="gfr-name-row">
                  <span class="gfr-name">{{ block.settings.client_name }}</span>
                  {%- if block.settings.show_verified_check -%}
                    {%- if verified_image != blank -%}
                      {%- assign vc_h = verified_badge_h | times: 3 -%}
                      {{ verified_image | image_url: height: vc_h | image_tag:
                          class: 'gfr-verified-check',
                          loading: 'lazy',
                          alt: verified_alt }}
                    {%- elsif verified_image_url != blank -%}
                      <img src="{{ verified_image_url }}" class="gfr-verified-check" alt="{{ verified_alt }}" loading="lazy">
                    {%- else -%}
                      <svg class="gfr-verified-check" viewBox="0 0 24 24" fill="none" aria-label="{{ verified_alt }}">
                        <circle cx="12" cy="12" r="11" fill="{{ accent_color }}"/>
                        <polyline points="7.5 12.5 10.5 15.5 16.5 9.5" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                      </svg>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {%- if block.settings.duration != blank -%}
                  <span class="gfr-pill">{{ block.settings.duration }}</span>
                {%- endif -%}
              </div>

              <div class="gfr-meta">
                {%- if block.settings.location != blank -%}
                  <span>{{ block.settings.location }}</span>
                {%- endif -%}
                {%- if block.settings.first_order != blank -%}
                  <span>{{ block.settings.first_order }}</span>
                {%- endif -%}
              </div>

              {%- if block.settings.quote != blank -%}
                <p class="gfr-quote">{{ block.settings.quote }}</p>
              {%- endif -%}

              {%- assign has_stars = block.settings.show_stars -%}
              {%- assign has_vp = block.settings.show_verified_tag -%}

              {%- if has_stars or has_vp -%}
                <div class="gfr-info-bottom">
                  {%- if has_stars -%}
                    <div class="gfr-stars" aria-label="{{ block.settings.star_count | default: 5 }} out of 5 stars">
                      {%- assign sc = block.settings.star_count | default: 5 -%}
                      {%- for i in (1..5) -%}
                        {%- if i <= sc -%}
                          <svg viewBox="0 0 20 20" fill="{{ star_color }}"><polygon points="10,1.5 12.6,7 18.5,7.6 14,11.5 15.3,17.5 10,14.5 4.7,17.5 6,11.5 1.5,7.6 7.4,7"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 20 20" fill="{{ meta_color }}" opacity="0.25"><polygon points="10,1.5 12.6,7 18.5,7.6 14,11.5 15.3,17.5 10,14.5 4.7,17.5 6,11.5 1.5,7.6 7.4,7"/></svg>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if has_vp -%}
                    <div class="gfr-vp">
                      {%- if verified_image != blank -%}
                        {%- assign vp_h = verified_badge_h | times: 3 -%}
                        {{ verified_image | image_url: height: vp_h | image_tag:
                            class: 'gfr-vp-icon',
                            loading: 'lazy',
                            alt: verified_purchase }}
                      {%- elsif verified_image_url != blank -%}
                        <img src="{{ verified_image_url }}" class="gfr-vp-icon" alt="{{ verified_purchase }}" loading="lazy">
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M9 12l2 2 4-4" stroke="{{ verified_color }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          <circle cx="12" cy="12" r="9" stroke="{{ verified_color }}" stroke-width="1.5" fill="none"/>
                        </svg>
                      {%- endif -%}
                      {{ verified_purchase }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<!-- ====================================================================== -->
<!-- JS                                                                      -->
<!-- ====================================================================== -->
<script>
(function () {
  var section = document.getElementById('gfr-{{ sid }}');
  if (!section) return;

  {%- if enable_animations -%}
  if (!('IntersectionObserver' in window)) {
    section.querySelectorAll('.gfr-fade').forEach(function (el) { el.classList.add('gfr-visible'); });
    return;
  }

  var observer = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('gfr-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08 }
  );
  section.querySelectorAll('.gfr-fade').forEach(function (el) { observer.observe(el); });
  {%- endif -%}
})();
</script>

{% schema %}
{
  "name": "GUMFORCE Real Results",
  "tag": "section",
  "class": "gfr-section-wrapper",
  "limit": 2,
  "settings": [
    {
      "type": "header",
      "content": "Section Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F5F3"
    },
    {
      "type": "image_picker",
      "id": "pattern_image",
      "label": "Background pattern (image)",
      "info": "Upload a PNG/SVG tile. It will repeat across the section."
    },
    {
      "type": "url",
      "id": "pattern_url",
      "label": "Background pattern (URL)",
      "info": "Paste an SVG URL from Settings → Files. Overrides image above."
    },
    {
      "type": "range",
      "id": "pattern_size",
      "label": "Pattern tile size",
      "min": 20,
      "max": 300,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "label": "Pattern opacity",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 5,
      "unit": "%"
    },

    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Guys. Real Results."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 38,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Verified customers. Verified transformations."
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#777777"
    },

    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_grad_start",
      "label": "Card gradient — bottom (info area)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_grad_end",
      "label": "Card gradient — top (behind image)",
      "default": "#F0EFED"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "card_shadow_color",
      "label": "Card shadow color",
      "default": "#00000010"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "16:9", "label": "16:9 — Landscape" },
        { "value": "1:1", "label": "1:1 — Square" },
        { "value": "4:5", "label": "4:5 — Portrait" },
        { "value": "3:4", "label": "3:4 — Tall portrait" },
        { "value": "2:3", "label": "2:3 — Tallest" }
      ],
      "default": "4:5"
    },
    {
      "type": "range",
      "id": "cards_gap",
      "label": "Gap between cards",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 28,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#FFFFFFB3"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Checkmark badge color",
      "default": "#2AB5B4"
    },
    {
      "type": "color",
      "id": "pill_bg_color",
      "label": "Duration pill color",
      "default": "#2AB5B4"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Client name color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta text color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star rating color",
      "default": "#F5A623"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Duration pill text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "verified_color",
      "label": "Verified purchase text/icon color",
      "default": "#999999"
    },
    {
      "type": "image_picker",
      "id": "verified_badge_image",
      "label": "Verified badge image"
    },
    {
      "type": "url",
      "id": "verified_badge_url",
      "label": "Verified badge image URL (fallback)"
    },
    {
      "type": "range",
      "id": "verified_badge_height",
      "label": "Verified badge height (px)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 16
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Enable scroll animations",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "result_card",
      "name": "Result Card",
      "settings": [
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "image_before",
          "label": "Before image"
        },
        {
          "type": "image_picker",
          "id": "image_after",
          "label": "After image"
        },

        {
          "type": "header",
          "content": "Client Info"
        },
        {
          "type": "text",
          "id": "client_name",
          "label": "Client name",
          "default": "Marcus T."
        },
        {
          "type": "checkbox",
          "id": "show_verified_check",
          "label": "Verified checkmark next to name",
          "default": true
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Austin, TX"
        },
        {
          "type": "text",
          "id": "first_order",
          "label": "First order date",
          "default": "First order: Jan 2026"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration pill text",
          "default": "60 DAYS"
        },

        {
          "type": "header",
          "content": "Optional Extras"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Customer quote (one line)"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Show star rating",
          "default": true
        },
        {
          "type": "range",
          "id": "star_count",
          "label": "Star count",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "show_verified_tag",
          "label": "Show Verified Purchase tag",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GUMFORCE Real Results",
      "blocks": [
        {
          "type": "result_card",
          "settings": {
            "client_name": "Marcus T.",
            "location": "Austin, TX",
            "first_order": "First order: Jan 2026",
            "duration": "60 DAYS",
            "quote": "My jawline is way more defined. People actually notice.",
            "show_stars": true,
            "show_verified_tag": true
          }
        },
        {
          "type": "result_card",
          "settings": {
            "client_name": "James R.",
            "location": "Miami, FL",
            "first_order": "First order: Nov 2025",
            "duration": "90 DAYS",
            "quote": "Honestly didn't expect this much change. Worth every pack.",
            "show_stars": true,
            "show_verified_tag": true
          }
        },
        {
          "type": "result_card",
          "settings": {
            "client_name": "Dylan K.",
            "location": "London, UK",
            "first_order": "First order: Dec 2025",
            "duration": "8 WEEKS",
            "quote": "Mates keep asking what I did. It's just the gum.",
            "show_stars": true,
            "show_verified_tag": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
