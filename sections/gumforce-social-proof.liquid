<!-- JS — Scroll-triggered fade-in (toggleable via setting)                 -->
<!-- ====================================================================== -->
<script>
(function () {
  var section = document.getElementById('gfsp-{{ sid }}');
  if (!section) return;

  if (!('IntersectionObserver' in window)) {
    section.querySelectorAll('.gfsp-fade').forEach(function (el) { el.classList.add('gfsp-visible'); });
    return;
  }

  {%- if enable_animations -%}
  /* ── Fade-in observer ── */
  var fadeObserver = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('gfsp-visible');
          fadeObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  section.querySelectorAll('.gfsp-fade').forEach(function (el) { fadeObserver.observe(el); });
  {%- endif -%}

  /* ── Count-up animation ── */
  var counter = section.querySelector('.gfsp-counter');
  if (!counter) return;

  var target = counter.getAttribute('data-target') || '';
  /* Extract numeric part, prefix (e.g. "$"), and suffix (e.g. "+", "K") */
  var match = target.match(/^([^0-9]*)([0-9][0-9,.]*)(.*)$/);
  if (!match) return;

  var prefix = match[1];
  var rawNum = match[2];
  var suffix = match[3];
  var hasCommas = rawNum.indexOf(',') > -1;
  var endValue = parseFloat(rawNum.replace(/,/g, ''));
  if (isNaN(endValue)) return;

  var duration = 2000;
  var started = false;

  function formatNumber(n) {
    var rounded = Math.floor(n);
    if (!hasCommas) return String(rounded);
    return rounded.toLocaleString('en-US');
  }

  function animateCount(timestamp, startTime) {
    var elapsed = timestamp - startTime;
    var progress = Math.min(elapsed / duration, 1);
    /* Ease-out cubic */
    var eased = 1 - Math.pow(1 - progress, 3);
    var current = eased * endValue;
    counter.textContent = prefix + formatNumber(current) + suffix;
    if (progress < 1) {
      requestAnimationFrame(function (ts) { animateCount(ts, startTime); });
    }
  }

  var countObserver = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && !started) {
          started = true;
          /* Lock width so badge icon doesn't shift */
          counter.style.minWidth = counter.offsetWidth + 'px';
          counter.style.display = 'inline-block';
          counter.textContent = prefix + '0' + suffix;
          requestAnimationFrame(function (ts) { animateCount(ts, ts); });
          countObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );
  countObserver.observe(counter);
})();
</script>

{%- if cta_scroll_bundle -%}
<script>
(function () {
  var btn = document.querySelector('[data-scroll-bundle="true"]');
  if (!btn) return;
  btn.addEventListener('click', function (e) {
    e.preventDefault();
    var target = document.querySelector('.gf-options');
    if (!target) {
      target = document.querySelector('[id^="gf-"] .gf-header');
    }
    if (!target) {
      target = document.querySelector('[id^="gf-"]');
    }
    if (target) {
      var offset = 20;
      var headerEl = document.querySelector('header, .header, .shopify-section-header');
      if (headerEl) offset = headerEl.offsetHeight + 10;
      var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
      window.scrollTo({ top: top, behavior: 'smooth' });
    }
  });
})();
</script>
{%- endif -%}

