<script>
  (function () {
    var row = document.getElementById('gfbadge-{{ gf_id }}');
    if (!row) return;
    var base = {{ s.font_size | default: 11 }};
    /* 1 ligne garantie : nowrap + on descend la police (min 7.5px) jusqu'à
       ce que la rangée ne déborde plus — padding/icônes en em suivent seuls */
    /* bord droit réel du contenu = la pill la plus à droite (vérité terrain,
       insensible aux wrappers fit-content du thème) */
    function contentRight() {
      var r = 0, k = row.children, i;
      for (i = 0; i < k.length; i++) r = Math.max(r, k[i].getBoundingClientRect().right);
      return r;
    }
    /* bord de contenu le plus serré parmi les ancêtres proches (carte,
       group-block…) : right - padding-right */
    function availRight() {
      var a = Infinity, el = row.parentElement, n = 0, cs, rc;
      while (el && n++ < 6 && el !== document.body) {
        rc = el.getBoundingClientRect();
        if (rc.width) {
          cs = getComputedStyle(el);
          a = Math.min(a, rc.right - (parseFloat(cs.paddingRight) || 0));
        }
        el = el.parentElement;
      }
      if (a === Infinity) a = document.documentElement.clientWidth || 0;
      return a;
    }
    function fit() {
      if (!row.getBoundingClientRect().width) return; /* pas layouté → resize/load réessaieront */
      row.classList.add('gfb-oneline');
      var fs = base, guard = 64, limit = availRight();
      row.style.setProperty('--gfb-fs', fs + 'px');
      while (contentRight() > limit + 1 && fs > 7.5 && guard--) {
        fs -= 0.25;
        row.style.setProperty('--gfb-fs', fs + 'px');
      }
      /* filet : si même à 7.5px ça ne tient pas, on repasse en 2 lignes lisibles
         plutôt que de couper le texte */
      if (contentRight() > limit + 1) {
        row.classList.remove('gfb-oneline');
        row.style.setProperty('--gfb-fs', base + 'px');
      }
    }
    var raf = 0;
    function sched() { if (raf) return; raf = requestAnimationFrame(function () { raf = 0; fit(); }); }
    fit();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(sched);
    window.addEventListener('resize', sched, { passive: true });
    window.addEventListener('load', sched);
  })();
</script>

{%- endif -%}

{% schema %}
{
  "name": "GF Product Badge",
  "settings": [
    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Best Seller"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none",   "label": "None" },
        { "value": "star",   "label": "⭐ Star" },
        { "value": "fire",   "label": "🔥 Fire" },
        { "value": "check",  "label": "✓ Checkmark" },
        { "value": "bolt",   "label": "⚡ Lightning" },
        { "value": "award",  "label": "🏆 Award" },
        { "value": "muscle", "label": "💪 Muscle" },
        { "value": "leaf",   "label": "🌿 Feuille (menthe)" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background color",
      "default": "#1a3a2a"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text & icon color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Badge 2 (optional)"
    },
    {
      "type": "text",
      "id": "badge_text_2",
      "label": "Badge text",
      "info": "Leave empty to show only 1 badge."
    },
    {
      "type": "select",
      "id": "icon_2",
      "label": "Icon",
      "options": [
        { "value": "none",   "label": "None" },
        { "value": "star",   "label": "⭐ Star" },
        { "value": "fire",   "label": "🔥 Fire" },
        { "value": "check",  "label": "✓ Checkmark" },
        { "value": "bolt",   "label": "⚡ Lightning" },
        { "value": "award",  "label": "🏆 Award" },
        { "value": "muscle", "label": "💪 Muscle" },
        { "value": "leaf",   "label": "🌿 Feuille (menthe)" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "color_bg_2",
      "label": "Background color",
      "default": "#2AB5B4"
    },
    {
      "type": "color",
      "id": "color_text_2",
      "label": "Text & icon color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Badge 3 (optional)"
    },
    {
      "type": "text",
      "id": "badge_text_3",
      "label": "Badge text",
      "info": "Leave empty to hide. Ex. : GOÛT MENTHE"
    },
    {
      "type": "select",
      "id": "icon_3",
      "label": "Icon",
      "options": [
        { "value": "none",   "label": "None" },
        { "value": "star",   "label": "⭐ Star" },
        { "value": "fire",   "label": "🔥 Fire" },
        { "value": "check",  "label": "✓ Checkmark" },
        { "value": "bolt",   "label": "⚡ Lightning" },
        { "value": "award",  "label": "🏆 Award" },
        { "value": "muscle", "label": "💪 Muscle" },
        { "value": "leaf",   "label": "🌿 Feuille (menthe)" }
      ],
      "default": "leaf"
    },
    {
      "type": "color",
      "id": "color_bg_3",
      "label": "Background color",
      "default": "#2AB5B4"
    },
    {
      "type": "color",
      "id": "color_text_3",
      "label": "Text & icon color",
      "default": "#ffffff"
